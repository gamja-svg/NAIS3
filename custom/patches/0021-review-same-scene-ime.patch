+      scene(13, 1, { name: '넷째', ...pic }),
+      scene(14, 1, { name: '다섯째', ...pic })
+    )
+    expect(await go(14)).toBe(23) // 더 짧은 프리셋이면 가장 가까운 그림
+    scenesOf[1][2] = scene(12, 1, { name: '셋째', ...pic })
+    expect(await go(12)).toBe(23) // 그 자리에 그림이 없으면 가까운 쪽 (뒤 먼저)
+  })
 })

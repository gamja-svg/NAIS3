diff --git a/src/renderer/src/lib/custom-censor.ts b/src/renderer/src/lib/custom-censor.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dea4cf2901e89d7bb3e04cf12cd942a6af6846f6
--- /dev/null
+++ b/src/renderer/src/lib/custom-censor.ts
@@ -0,0 +1,67 @@
+/**
+ * [custom] 검수 모드의 검열(흰칠) — 화면 계산 (확대·붓 크기·누른 도구).
+ * 그림 좌표 = 원본 픽셀. 화면 좌표 = 작업 칸의 왼쪽 위에서 잰 CSS 픽셀.
+ */
+
+export type CensorTool = 'paint' | 'erase' | 'pick' | 'pan'
+
+export interface CensorView {
+  /** 그림 1픽셀이 화면에서 차지하는 크기 */
+  scale: number
+  /** 그림 왼쪽 위가 놓이는 화면 자리 */
+  x: number
+  y: number
+}
+
+export const BRUSH_MIN = 2
+export const BRUSH_MAX = 400
+export const BRUSH_DEFAULT = 28
+const ZOOM_MAX = 16
+
+/** 칸 안에 그림 전체가 들어가게 (가운데) */
+export function fitView(boxW: number, boxH: number, imgW: number, imgH: number): CensorView {
+  if (!boxW || !boxH || !imgW || !imgH) return { scale: 1, x: 0, y: 0 }
+  const scale = Math.min(boxW / imgW, boxH / imgH)
+  return { scale, x: (boxW - imgW * scale) / 2, y: (boxH - imgH * scale) / 2 }
+}
+
+/**
+ * (px, py) 화면 자리를 붙잡은 채 factor배로 확대·축소한다 (휠은 커서 자리, 버튼은 가운데).
+ * 맞춤 크기의 절반보다 작게, 16배보다 크게는 가지 않는다.
+ */
+export function zoomAt(
+  view: CensorView,
+  factor: number,
+  px: number,
+  py: number,
+  fitScale: number
+): CensorView {
+  const scale = Math.min(ZOOM_MAX, Math.max(fitScale * 0.5, view.scale * factor))
+  const k = scale / view.scale
+  return { scale, x: px - (px - view.x) * k, y: py - (py - view.y) * k }
+}
+
+/** 화면 자리 → 그림 좌표 */
+export function toImage(view: CensorView, px: number, py: number): { x: number; y: number } {
+  return { x: (px - view.x) / view.scale, y: (py - view.y) / view.scale }
+}
+
+/** 휠 한 칸에 붓 크기를 12%씩 — 작을 때도 1픽셀은 바뀌게 */
+export function stepBrush(brush: number, up: boolean): number {
+  const next = up ? Math.max(brush + 1, brush * 1.12) : Math.min(brush - 1, brush / 1.12)
+  return Math.round(Math.min(BRUSH_MAX, Math.max(BRUSH_MIN, next)))
+}
+
+/**
+ * 누르는 순간 쓸 도구 — 키가 고른 도구보다 먼저다:
+ * Space·가운데 버튼 = 이동, Alt = 콕 찍기, Shift = 지우기, 아무 키도 없으면 고른 도구(기본 칠하기).
+ */
+export function toolFor(
+  selected: CensorTool,
+  keys: { alt: boolean; shift: boolean; space: boolean; button: number }
+): CensorTool {
+  if (keys.button === 1 || keys.space) return 'pan'
+  if (keys.alt) return 'pick'
+  if (keys.shift) return 'erase'
+  return selected
+}
diff --git a/src/renderer/src/stores/custom-censor-store.ts b/src/renderer/src/stores/custom-censor-store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ac917187bf9a6c91517c9e8f4067e4370089fc9d
--- /dev/null
+++ b/src/renderer/src/stores/custom-censor-store.ts
@@ -0,0 +1,33 @@
+import { create } from 'zustand'
+
+/**
+ * [custom] 검열(흰칠) 화면 상태.
+ * - revs: 칠한 그림은 같은 파일을 다시 쓰므로, 저장할 때마다 번호를 올려 화면이 새 그림을 다시 읽게 한다.
+ * - modelPercent: 콕 찍기 모델을 받는 정도 (null = 받는 중 아님)
+ */
+interface CensorState {
+  revs: Record<string, number>
+  modelPercent: number | null
+  bump: (filePath: string) => void
+  setModelPercent: (percent: number) => void
+}
+
+export const useCensorStore = create<CensorState>((set) => ({
+  revs: {},
+  modelPercent: null,
+  bump: (filePath) =>
+    set((s) => ({ revs: { ...s.revs, [filePath]: (s.revs[filePath] ?? 0) + 1 } })),
+  setModelPercent: (percent) => set({ modelPercent: percent >= 100 ? null : percent })
+}))
+
+/** 칠한 그림을 다시 읽게 주소 끝에 번호를 붙인다 (번호가 없으면 주소 그대로) */
+export function withCensorRev(url: string, rev: number | undefined): string {
+  return rev ? `${url}&v=${rev}` : url
+}
+
+/** 모델 받는 정도 알림을 받는다 */
+export function bindCensorEvents(): () => void {
+  return window.nais.on('custom:censorModel', ({ percent }) =>
+    useCensorStore.getState().setModelPercent(percent)
+  )
+}

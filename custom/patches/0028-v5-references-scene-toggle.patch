+  const aspect = Math.log(Math.max(width, 1) / Math.max(height, 1))
+  let best = REFERENCE_BUCKETS[0]
+  let bestGap = Infinity
+  for (const bucket of REFERENCE_BUCKETS) {
+    const gap = Math.abs(aspect - Math.log(bucket[0] / bucket[1]))
+    if (gap < bestGap) {
+      best = bucket
+      bestGap = gap
+    }
+  }
+  return best
+}

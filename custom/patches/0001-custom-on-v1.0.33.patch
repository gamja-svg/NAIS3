--- /dev/null
+++ b/src/renderer/src/stores/custom-censor-store.ts
@@ -0,0 +1,38 @@
+import { create } from 'zustand'
+
+/**
+ * [custom] 검열(흰칠) 화면 상태.
+ * - revs: 칠한 그림은 같은 파일을 다시 쓰므로, 저장할 때마다 번호를 올려 화면이 새 그림을 다시 읽게 한다.
+ * - modelPercent: 콕 찍기 모델을 받는 정도 (null = 받는 중 아님)
+ * - on: 검수 모드에서 검열을 켰는지 — 씬·프리셋을 넘겨도, 검수를 닫았다 열어도 유지된다 (앱을 끄면 꺼진다)
+ */
+interface CensorState {
+  on: boolean
+  toggle: () => void
+  revs: Record<string, number>
+  modelPercent: number | null
+  bump: (filePath: string) => void
+  setModelPercent: (percent: number) => void
+}
+
+export const useCensorStore = create<CensorState>((set) => ({
+  on: false,
+  toggle: () => set((s) => ({ on: !s.on })),
+  revs: {},
+  modelPercent: null,
+  bump: (filePath) =>
+    set((s) => ({ revs: { ...s.revs, [filePath]: (s.revs[filePath] ?? 0) + 1 } })),
+  setModelPercent: (percent) => set({ modelPercent: percent >= 100 ? null : percent })
+}))
+
+/** 칠한 그림을 다시 읽게 주소 끝에 번호를 붙인다 (번호가 없으면 주소 그대로) */
+export function withCensorRev(url: string, rev: number | undefined): string {
+  return rev ? `${url}&v=${rev}` : url
+}
+
+/** 모델 받는 정도 알림을 받는다 */
+export function bindCensorEvents(): () => void {
+  return window.nais.on('custom:censorModel', ({ percent }) =>
+    useCensorStore.getState().setModelPercent(percent)
+  )
+}
diff --git a/src/renderer/src/stores/custom-claude-panel-store.ts b/src/renderer/src/stores/custom-claude-panel-store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..917fc558063a29a0d24cbae98fbb1229451fb065
--- /dev/null
+++ b/src/renderer/src/stores/custom-claude-panel-store.ts
@@ -0,0 +1,100 @@
+import { create } from 'zustand'
+
+/** [custom] Claude 창 설정 — 열림·폭·지정한 방·배율 (settings에 저장) */
+
+export const CLAUDE_HOME = 'https://claude.ai/'
+export const CLAUDE_PANEL_DEFAULT_WIDTH = 400
+const MIN_WIDTH = 300
+const KEYS = {
+  open: 'custom_claude_open',
+  width: 'custom_claude_width',
+  url: 'custom_claude_url',
+  zoom: 'custom_claude_zoom'
+} as const
+
+export function isClaudeUrl(url: string): boolean {
+  try {
+    const u = new URL(url)
+    return (
+      u.protocol === 'https:' && (u.hostname === 'claude.ai' || u.hostname.endsWith('.claude.ai'))
+    )
+  } catch {
+    return false
+  }
+}
+
+/** 같은 방인지 — 끝의 `/`와 `?`·`#` 뒤는 보지 않는다 */
+export function sameRoom(a: string, b: string): boolean {
+  const key = (s: string): string => {
+    try {
+      const u = new URL(s)
+      return `${u.origin}${u.pathname.replace(/\/+$/, '')}`
+    } catch {
+      return s
+    }
+  }
+  return key(a) === key(b)
+}
+
+function clampWidth(width: number): number {
+  const max = Math.max(MIN_WIDTH, Math.round(window.innerWidth * 0.6))
+  return Math.round(Math.min(max, Math.max(MIN_WIDTH, width)))
+}
+
+interface ClaudePanelState {
+  open: boolean
+  width: number
+  /** 지정한 방 — 창을 새로 열 때·집 버튼으로 가는 곳 */
+  homeUrl: string
+  zoom: number
+  setOpen: (open: boolean) => void
+  toggle: () => void
+  /** save=true일 때만 저장 (끄는 동안에는 화면만 바꾼다) */
+  setWidth: (width: number, save?: boolean) => void
+  setHomeUrl: (url: string) => void
+  setZoom: (zoom: number) => void
+  hydrate: () => Promise<void>
+}
+
+const persist = (key: string, value: string): void => {
+  void window.nais.invoke('settings:set', { key, value })
+}
+
+export const useClaudePanelStore = create<ClaudePanelState>((set, get) => ({
+  open: false,
+  width: CLAUDE_PANEL_DEFAULT_WIDTH,
+  homeUrl: CLAUDE_HOME,
+  zoom: 1,
+  setOpen: (open) => {
+    set({ open })
+    persist(KEYS.open, open ? '1' : '0')
+  },
+  toggle: () => get().setOpen(!get().open),
+  setWidth: (width, save = false) => {
+    const next = clampWidth(width)
+    set({ width: next })
+    if (save) persist(KEYS.width, String(next))
+  },
+  setHomeUrl: (homeUrl) => {
+    set({ homeUrl })
+    persist(KEYS.url, homeUrl)
+  },
+  setZoom: (zoom) => {
+    const next = Math.min(2, Math.max(0.5, Math.round(zoom * 10) / 10))
+    set({ zoom: next })
+    persist(KEYS.zoom, String(next))
+  },
+  hydrate: async () => {
+    const [open, width, url, zoom] = await Promise.all(
+      [KEYS.open, KEYS.width, KEYS.url, KEYS.zoom].map((key) =>
+        window.nais.invoke('settings:get', { key })
+      )
+    )
+    set({
+      open: open.value === '1',
+      width: clampWidth(Number(width.value) || CLAUDE_PANEL_DEFAULT_WIDTH),
+      homeUrl: url.value && isClaudeUrl(url.value) ? url.value : CLAUDE_HOME,
+      zoom: Number(zoom.value) || 1
+    })
+  }
+}))
diff --git a/src/renderer/src/stores/custom-folder-groups-store.ts b/src/renderer/src/stores/custom-folder-groups-store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9f8a1cb6563c259e799442a1b2a8c0d3e1dea72a
--- /dev/null
+++ b/src/renderer/src/stores/custom-folder-groups-store.ts
@@ -0,0 +1,135 @@
+import { create } from 'zustand'
+import type { CharacterCard, FolderGroup, ListFolder } from '@shared/types'
+import {
+  linksFrom,
+  linksTo,
+  moveGroupedRow,
+  orderFoldersByGroup,
+  setFolderGroup,
+  type GroupedState,
+  type GroupLinks
+} from '../lib/custom-folder-groups'
+import { canonicalize, toOrderEntries } from '../lib/folder-list'
+import { t } from '../lib/i18n'
+import { useCharactersStore } from './characters-store'
+
+/**
+ * [custom] 캐릭터 프롬프트 상위 폴더 — 상위 폴더 목록과 폴더 소속을 들고 있고,
+ * 끌어 놓기를 상위 폴더까지 알고 처리한다. 폴더·카드 자체는 원본 캐릭터 스토어에 있다
+ * (여기서는 그 순서만 같이 바꿔 저장한다).
+ */
+interface FolderGroupsState {
+  groups: FolderGroup[]
+  links: GroupLinks
+  load: () => Promise<void>
+  /** 새 상위 폴더 — folderId를 주면 그 폴더를 바로 넣는다 */
+  createGroup: (folderId?: number) => Promise<void>
+  renameGroup: (id: number, name: string) => void
+  toggleGroup: (id: number) => void
+  setGroupColor: (id: number, color: string | null) => void
+  /** 상위 폴더만 지운다 — 안의 폴더는 상위 폴더 밖으로 나온다 */
+  removeGroup: (id: number) => void
+  setFolderGroup: (folderId: number, groupId: number | null) => void
+  /** 상위 폴더 안에 새 폴더 */
+  addFolderToGroup: (groupId: number) => Promise<void>
+  move: (activeKey: string, overKey: string) => void
+}
+
+function current(groups: FolderGroup[], links: GroupLinks): GroupedState<CharacterCard> {
+  const { folders, items } = useCharactersStore.getState()
+  return { groups, links, folders, items }
+}
+
+/** 바뀐 순서·소속을 두 스토어에 반영하고 저장한다 */
+function apply(
+  next: GroupedState<CharacterCard>,
+  set: (s: Partial<FolderGroupsState>) => void
+): void {
+  useCharactersStore.setState({ folders: next.folders, items: next.items })
+  set({ groups: next.groups, links: next.links })
+  void window.nais.invoke('chars:reorder', { order: toOrderEntries(next.folders, next.items) })
+  void window.nais.invoke('custom:folderGroups:arrange', {
+    kind: 'chars',
+    groupIds: next.groups.map((g) => g.id),
+    links: linksTo(next.links, next.folders)
+  })
+}
+
+export const useFolderGroupsStore = create<FolderGroupsState>((set, get) => ({
+  groups: [],
+  links: new Map(),
+
+  load: async () => {
+    const { groups, links } = await window.nais.invoke('custom:folderGroups:list', {
+      kind: 'chars'
+    })
+    set({ groups, links: linksFrom(links) })
+  },
+
+  createGroup: async (folderId) => {
+    const name = t('ui.customNewFolderGroup')
+    const { id } = await window.nais.invoke('custom:folderGroups:create', { kind: 'chars', name })
+    set({ groups: [...get().groups, { id, name, collapsed: false, color: null }] })
+    if (folderId != null) get().setFolderGroup(folderId, id)
+  },
+
+  renameGroup: (id, name) => {
+    set({ groups: get().groups.map((g) => (g.id === id ? { ...g, name } : g)) })
+    void window.nais.invoke('custom:folderGroups:update', { id, patch: { name } })
+  },
+
+  toggleGroup: (id) => {
+    const group = get().groups.find((g) => g.id === id)
+    if (!group) return
+    const collapsed = !group.collapsed
+    set({ groups: get().groups.map((g) => (g.id === id ? { ...g, collapsed } : g)) })
+    void window.nais.invoke('custom:folderGroups:update', { id, patch: { collapsed } })
+  },
+
+  setGroupColor: (id, color) => {
+    set({ groups: get().groups.map((g) => (g.id === id ? { ...g, color } : g)) })
+    void window.nais.invoke('custom:folderGroups:update', { id, patch: { color } })
+  },
+
+  removeGroup: (id) => {
+    const groups = get().groups.filter((g) => g.id !== id)
+    const links = new Map([...get().links].filter(([, groupId]) => groupId !== id))
+    const { folders, items } = useCharactersStore.getState()
+    // 안에 있던 폴더는 상위 폴더 밖 영역 끝으로 (화면 순서 = 저장 순서 유지)
+    const nextFolders = orderFoldersByGroup(
+      groups,
+      links,
+      orderFoldersByGroup(get().groups, get().links, folders)
+    )
+    useCharactersStore.setState({ folders: nextFolders, items: canonicalize(nextFolders, items) })
+    set({ groups, links })
+    void window.nais.invoke('custom:folderGroups:delete', { id })
+    void window.nais.invoke('chars:reorder', {
+      order: toOrderEntries(nextFolders, useCharactersStore.getState().items)
+    })
+  },
+
+  setFolderGroup: (folderId, groupId) => {
+    const { groups, links } = get()
+    const next = setFolderGroup(current(groups, links), folderId, groupId)
+    // 접힌 상위 폴더에 넣었으면 펼쳐서 어디로 갔는지 보이게
+    if (groupId != null && groups.find((g) => g.id === groupId)?.collapsed)
+      get().toggleGroup(groupId)
+    apply({ ...next, groups: get().groups }, set)
+  },
+
+  addFolderToGroup: async (groupId) => {
+    const name = t('ui.newFolder')
+    const { id } = await window.nais.invoke('chars:folderCreate', { name })
+    const folder: ListFolder = { id, name, collapsed: false, color: null }
+    useCharactersStore.setState({ folders: [...useCharactersStore.getState().folders, folder] })
+    get().setFolderGroup(id, groupId)
+  },
+
+  move: (activeKey, overKey) => {
+    const { groups, links } = get()
+    const state = current(groups, links)
+    const next = moveGroupedRow(state, activeKey, overKey)
+    if (next !== state) apply(next, set)
+  }
+}))
diff --git a/src/renderer/src/stores/custom-fragment-negative-store.ts b/src/renderer/src/stores/custom-fragment-negative-store.ts

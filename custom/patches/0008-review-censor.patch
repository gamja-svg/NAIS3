diff --git a/tests/custom-censor-sam.integration.ts b/tests/custom-censor-sam.integration.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d90b834c2a4df16e3c420b3dfc0a81e110a57548
--- /dev/null
+++ b/tests/custom-censor-sam.integration.ts
@@ -0,0 +1,70 @@
+import { existsSync, mkdtempSync, readdirSync, rmSync, writeFileSync } from 'fs'
+import { tmpdir } from 'os'
+import { join } from 'path'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { SAM_MODELS, ensureModels, pickShape } from '../src/main/custom/censor-sam'
+import sharp from '../src/main/sharp'
+
+// [custom] 콕 찍기 모델: 받기·확인, 그리고 (모델이 있을 때만) 실제로 모양 따기
+const environment = vi.hoisted(() => ({ directory: '' }))
+vi.mock('electron', () => ({
+  app: { getPath: () => environment.directory, getLocale: () => 'ko' },
+  BrowserWindow: { getFocusedWindow: () => null, getAllWindows: () => [] },
+  dialog: {}
+}))
+
+beforeEach(() => {
+  environment.directory = mkdtempSync(join(tmpdir(), 'nais3-custom-sam-'))
+})
+afterEach(() => rmSync(environment.directory, { recursive: true, force: true }))
+
+describe('custom: tap-to-shape model download', () => {
+  it('throws away a download that fails the checksum and leaves nothing behind', async () => {
+    const dir = join(environment.directory, 'models')
+    const progress: number[] = []
+    const fake = (async () =>
+      new Response(new Uint8Array(1000), { status: 200 })) as unknown as typeof fetch
+    await expect(
+      ensureModels({ dir, fetch: fake, progress: (p) => progress.push(p) })
+    ).rejects.toThrow()
+    expect(readdirSync(dir)).toEqual([]) // 반쯤 받은 파일도 남기지 않는다
+    expect(progress.every((p) => p < 100)).toBe(true)
+  })
+
+  it('reports a failed request and does not ask again for files that are already there', async () => {
+    const dir = join(environment.directory, 'models')
+    const down = (async () => new Response('', { status: 404 })) as unknown as typeof fetch
+    await expect(ensureModels({ dir, fetch: down })).rejects.toThrow(/404/)
+    // 크기가 맞는 파일이 있으면 받지 않는다 (내용 확인은 받을 때 한 번)
+    for (const model of Object.values(SAM_MODELS))
+      writeFileSync(join(dir, model.file), Buffer.alloc(model.size))
+    const never = vi.fn() as unknown as typeof fetch
+    await ensureModels({ dir, fetch: never })
+    expect(never).not.toHaveBeenCalled()
+  })
+})
+
+// 모델 폴더를 NAIS3_SAM_MODELS로 알려 주면 실제 모델로 돌려 본다 (평소 시험에서는 건너뛴다 — 45MB를 받지 않게)
+const models = process.env.NAIS3_SAM_MODELS
+describe.skipIf(!models || !existsSync(models))('custom: tap-to-shape on a real model', () => {
+  it('finds the shape under the point', async () => {
+    const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="832" height="1216">
+      <rect width="100%" height="100%" fill="#f1c9b0"/>
+      <ellipse cx="160" cy="300" rx="40" ry="25" fill="#7a3b3b"/></svg>`
+    const file = join(environment.directory, 'pic.png')
+    writeFileSync(file, await sharp(Buffer.from(svg)).png().toBuffer())
+    const result = await pickShape({ dir: models! }, file, 160, 300)
+    const shape = result.shapes[result.pick]
+    expect(Math.abs(shape.x - 120)).toBeLessThanOrEqual(4)
+    expect(Math.abs(shape.y - 275)).toBeLessThanOrEqual(4)
+    expect(Math.abs(shape.width - 80)).toBeLessThanOrEqual(6)
+    expect(Math.abs(shape.height - 50)).toBeLessThanOrEqual(6)
+    const { data, info } = await sharp(Buffer.from(shape.png, 'base64'))
+      .ensureAlpha()
+      .raw()
+      .toBuffer({ resolveWithObject: true })
+    const center = (Math.floor(info.height / 2) * info.width + Math.floor(info.width / 2)) * 4
+    expect([...data.subarray(center, center + 4)]).toEqual([255, 255, 255, 255])
+    expect(data[3]).toBe(0) // 네모의 모서리는 모양 밖
+  }, 120_000)
+})
diff --git a/tests/custom-censor-shape.test.ts b/tests/custom-censor-shape.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fa4d10136d26183a39f3028305c4c0191721be3e
--- /dev/null
+++ b/tests/custom-censor-shape.test.ts
@@ -0,0 +1,84 @@
+import { describe, expect, it } from 'vitest'
+import {
+  chooseCandidates,
+  fillHoles,
+  largestBlob,
+  maskArea,
+  maskBox,
+  pickWindow,
+  solidity,
+  tidy,
+  touchesBorder,
+  type Candidate,
+  type Mask
+} from '../src/main/custom/censor-shape'
+
+// [custom] 콕 찍기: 모양 후보 다듬기·고르기
+function mask(rows: string[]): Mask {
+  const width = rows[0].length
+  const data = new Uint8Array(width * rows.length)
+  rows.forEach((row, y) => [...row].forEach((ch, x) => (data[y * width + x] = ch === '#' ? 1 : 0)))
+  return { width, height: rows.length, data }
+}
+const text = (m: Mask): string[] =>
+  Array.from({ length: m.height }, (_, y) =>
+    Array.from({ length: m.width }, (_, x) => (m.data[y * m.width + x] ? '#' : '.')).join('')
+  )
+function disc(size: number, cx: number, cy: number, r: number): Mask {
+  const data = new Uint8Array(size * size)
+  for (let y = 0; y < size; y++)
+    for (let x = 0; x < size; x++) data[y * size + x] = Math.hypot(x - cx, y - cy) <= r ? 1 : 0
+  return { width: size, height: size, data }
+}
+const cand = (m: Mask, score: number): Candidate => ({
+  mask: m,
+  score,
+  solidity: solidity(m),
+  area: maskArea(m)
+})
+
+describe('custom: censor shape', () => {
+  it('keeps the largest blob and fills its holes', () => {
+    const m = mask(['#....###', '.....#.#', '.....###', '........'])
+    expect(text(largestBlob(m))).toEqual(['.....###', '.....#.#', '.....###', '........'])
+    expect(text(tidy(m))).toEqual(['.....###', '.....###', '.....###', '........'])
+    // 가장자리와 이어진 빈 곳은 구멍이 아니다
+    expect(text(fillHoles(mask(['###', '#..', '###'])))).toEqual(['###', '#..', '###'])
+    expect(maskArea(largestBlob(mask(['...', '...'])))).toBe(0)
+  })
+
+  it('scores a solid blob near 1 and a ring or line far lower', () => {
+    const full = disc(64, 32, 32, 20)
+    expect(solidity(full)).toBeGreaterThan(0.9)
+    const ring = disc(64, 32, 32, 20)
+    const hole = disc(64, 32, 32, 17)
+    for (let i = 0; i < ring.data.length; i++) ring.data[i] &= hole.data[i] ^ 1
+    expect(solidity(ring)).toBeLessThan(0.4)
+    expect(solidity(mask(['#..', '...']))).toBe(0) // 너무 작으면 0
+  })
+
+  it('lists candidates small to large without near-duplicates and picks the best solid one', () => {
+    const small = cand(disc(64, 32, 32, 6), 0.8)
+    const same = cand(disc(64, 32, 32, 6), 0.7)
+    const big = cand(disc(64, 32, 32, 20), 0.95)
+    const huge = cand(disc(64, 32, 32, 31), 0.99)
+    const { list, pick } = chooseCandidates([big, same, huge, small], 0.5 * 64 * 64)
+    expect(list.map((c) => c.area)).toEqual([small.area, big.area]) // 절반 넘는 것은 배경
+    expect(list[pick]).toBe(big)
+    expect(chooseCandidates([], 100)).toEqual({ list: [], pick: 0 })
+  })
+
+  it('crops a window around the point, clamped to the picture', () => {
+    expect(pickWindow(832, 1216, 400, 600, 384)).toEqual([208, 408, 592, 792])
+    expect(pickWindow(832, 1216, 10, 1210, 384)).toEqual([0, 832, 384, 1216])
+    expect(pickWindow(400, 300, 100, 100, 384)).toEqual([0, 0, 400, 300]) // 창이 그림만 하면 통째로
+  })
+
+  it('finds the box of a mask and whether it touches the border', () => {
+    const m = mask(['....', '.##.', '.#..', '....'])
+    expect(maskBox(m)).toEqual([1, 1, 3, 3])
+    expect(touchesBorder(m)).toBe(false)
+    expect(touchesBorder(mask(['....', '...#']))).toBe(true)
+    expect(maskBox(mask(['..']))).toBeNull()
+  })
+})
diff --git a/tests/custom-censor-view.test.ts b/tests/custom-censor-view.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..585ffa26beba4a1a9fe8632f3813e468acde0313
--- /dev/null
+++ b/tests/custom-censor-view.test.ts
@@ -0,0 +1,56 @@
+import { describe, expect, it } from 'vitest'
+import {
+  BRUSH_MAX,
+  BRUSH_MIN,
+  fitView,
+  stepBrush,
+  toImage,
+  toolFor,
+  zoomAt
+} from '../src/renderer/src/lib/custom-censor'
+import { withCensorRev } from '../src/renderer/src/stores/custom-censor-store'
+
+// [custom] 검열 화면 계산: 맞춤·확대·붓 크기·누른 도구
+describe('custom: censor view', () => {
+  it('fits the picture inside the box, centered', () => {
+    expect(fitView(1000, 500, 500, 500)).toEqual({ scale: 1, x: 250, y: 0 })
+    expect(fitView(400, 400, 800, 1600)).toEqual({ scale: 0.25, x: 100, y: 0 })
+    expect(fitView(0, 0, 800, 1600)).toEqual({ scale: 1, x: 0, y: 0 })
+  })
+
+  it('zooms around the pointer and stays within the limits', () => {
+    const fit = fitView(1000, 500, 500, 500)
+    const zoomed = zoomAt(fit, 2, 500, 250, fit.scale)
+    expect(zoomed.scale).toBe(2)
+    // 커서 아래의 그림 자리는 그대로다
+    expect(toImage(zoomed, 500, 250)).toEqual(toImage(fit, 500, 250))
+    expect(zoomAt(fit, 0.01, 0, 0, fit.scale).scale).toBe(0.5) // 맞춤의 절반까지만
+    expect(zoomAt(fit, 1000, 0, 0, fit.scale).scale).toBe(16)
+  })
+
+  it('steps the brush by about 12%, at least one pixel, within its range', () => {
+    expect(stepBrush(28, true)).toBe(31)
+    expect(stepBrush(31, false)).toBe(28)
+    expect(stepBrush(3, true)).toBe(4)
+    expect(stepBrush(BRUSH_MIN, false)).toBe(BRUSH_MIN)
+    expect(stepBrush(BRUSH_MAX, true)).toBe(BRUSH_MAX)
+  })
+
+  it('lets keys override the selected tool: Space/middle = move, Alt = tap shape, Shift = erase', () => {
+    const none = { alt: false, shift: false, space: false, button: 0 }
+    expect(toolFor('paint', none)).toBe('paint')
+    expect(toolFor('erase', none)).toBe('erase')
+    expect(toolFor('paint', { ...none, shift: true })).toBe('erase')
+    expect(toolFor('paint', { ...none, alt: true })).toBe('pick')
+    expect(toolFor('paint', { ...none, alt: true, shift: true })).toBe('pick')
+    expect(toolFor('pick', { ...none, space: true })).toBe('pan')
+    expect(toolFor('paint', { ...none, button: 1 })).toBe('pan')
+  })
+
+  it('adds a version to a repainted image address only after a save', () => {
+    expect(withCensorRev('nais-image://local/?path=a', undefined)).toBe(
+      'nais-image://local/?path=a'
+    )
+    expect(withCensorRev('nais-image://local/?path=a', 2)).toBe('nais-image://local/?path=a&v=2')
+  })
+})
diff --git a/tests/custom-censor.integration.ts b/tests/custom-censor.integration.ts
new file mode 100644
index 0000000000000000000000000000000000000000..aa2dbdc561a9169c23fed4b2f37498b9da6da299
--- /dev/null
+++ b/tests/custom-censor.integration.ts
@@ -0,0 +1,181 @@
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'fs'
+import { tmpdir } from 'os'
+import { join } from 'path'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { copyPngMeta, openCensor, paintWhite, saveCensor } from '../src/main/custom/censor'
+import { closeDb, getDb, initDb } from '../src/main/db'
+import { createPreset, createScene, listScenes, updateScene } from '../src/main/scenes/repo'
+import sharp from '../src/main/sharp'
+
+// [custom] 검수 모드의 검열(흰칠): 원본은 두고 칠한 그림을 같은 씬의 새 대표 이미지로 저장한다
+const environment = vi.hoisted(() => ({ directory: '' }))
+vi.mock('electron', () => ({
+  app: { getPath: () => environment.directory, getLocale: () => 'ko' },
+  BrowserWindow: { getFocusedWindow: () => null, getAllWindows: () => [] },
+  dialog: {}
+}))
+
+beforeEach(() => {
+  environment.directory = mkdtempSync(join(tmpdir(), 'nais3-custom-censor-'))
+  initDb()
+})
+afterEach(() => {
+  closeDb()
+  rmSync(environment.directory, { recursive: true, force: true })
+})
+
+const W = 8
+const H = 6
+/** 회색 그림 (알파는 줄마다 다르게 — NAI 숨김 메타데이터가 알파에 있다) + 프롬프트 글자 청크 */
+async function grayPng(): Promise<Buffer> {
+  const raw = Buffer.alloc(W * H * 4)
+  for (let p = 0; p < W * H; p++) raw.set([100, 110, 120, 254 + (p % 2)], p * 4)
+  const png = await sharp(raw, { raw: { width: W, height: H, channels: 4 } })
+    .png()
+    .toBuffer()
+  // IHDR 뒤에 tEXt 청크를 끼운다 (CRC는 읽는 쪽이 보지 않는다)
+  const text = Buffer.from('Comment\0{"prompt":"1girl, censored"}', 'latin1')
+  const chunk = Buffer.alloc(12 + text.length)
+  chunk.writeUInt32BE(text.length, 0)
+  chunk.write('tEXt', 4, 'latin1')
+  text.copy(chunk, 8)
+  return Buffer.concat([png.subarray(0, 33), chunk, png.subarray(33)])
+}
+/** 왼쪽 위 (x<3, y<2)만 칠한 마스크 — 화면이 보내는 꼴 (흰색 + 알파) */
+async function maskPng(columns = 3): Promise<string> {
+  const raw = Buffer.alloc(W * H * 4)
+  for (let y = 0; y < 2; y++)
+    for (let x = 0; x < columns; x++) raw.set([255, 255, 255, 255], (y * W + x) * 4)
+  const png = await sharp(raw, { raw: { width: W, height: H, channels: 4 } })
+    .png()
+    .toBuffer()
+  return png.toString('base64')
+}
+const pixels = async (file: string | Buffer): Promise<Buffer> =>
+  sharp(file).ensureAlpha().raw().toBuffer()
+const at = (data: Buffer, x: number, y: number): number[] => [
+  ...data.subarray((y * W + x) * 4, (y * W + x) * 4 + 4)
+]
+
+async function sceneWithImage(
+  favorite = false
+): Promise<{ preset: number; scene: number; file: string }> {
+  const preset = createPreset('p')
+  const scene = createScene(preset, '1')
+  const dir = join(environment.directory, 'images')
+  mkdirSync(dir, { recursive: true })
+  const file = join(dir, '1.png')
+  writeFileSync(file, await grayPng())
+  getDb()
+    .prepare(
+      `INSERT INTO images (file_path, payload_json, kind, seed, scene_id, favorite, created_at)
+       VALUES (?, '{"prompt":"x"}', 'scene', 7, ?, ?, '2026-01-02 03:04:05')`
+    )
+    .run(file, scene, favorite ? 1 : 0)
+  return { preset, scene, file }
+}
+
+describe('custom: censor paint', () => {
+  it('paints only the masked pixels white and keeps alpha and the prompt text chunk', async () => {
+    const base = await grayPng()
+    const result = await paintWhite(base, Buffer.from(await maskPng(), 'base64'), 'png')
+    expect(result.painted).toBe(true)
+    const data = await pixels(result.image)
+    expect(at(data, 0, 0)).toEqual([255, 255, 255, 254])
+    expect(at(data, 1, 1)).toEqual([255, 255, 255, 255])
+    expect(at(data, 3, 0)).toEqual([100, 110, 120, 255]) // 칠하지 않은 곳
+    expect(at(data, 0, 2)).toEqual([100, 110, 120, 254])
+    expect(result.image.includes(Buffer.from('1girl, censored', 'latin1'))).toBe(true)
+    expect(copyPngMeta(Buffer.from('not a png'), result.image)).toBe(result.image)
+  })
+
+  it('reports an empty mask as nothing painted', async () => {
+    const empty = await maskPng(0)
+    const result = await paintWhite(await grayPng(), Buffer.from(empty, 'base64'), 'png')
+    expect(result.painted).toBe(false)
+  })
+})
+
+describe('custom: censor save', () => {
+  it('saves a painted copy as the new cover, keeps the original, and leaves the pending mark alone', async () => {
+    const { preset: presetId, scene, file } = await sceneWithImage(true)
+    updateScene(scene, { prompt: 'changed' }) // 미생성 표시가 붙는다
+    expect(listScenes(presetId)[0]).toMatchObject({ pending: true, thumbnailPath: file })
+    const original = readFileSync(file)
+
+    expect(await openCensor(file)).toEqual({
+      basePath: file,
+      width: W,
+      height: H,
+      maskBase64: null
+    })
+    const saved = await saveCensor(file, await maskPng())
+    expect(saved).toMatchObject({ sceneId: scene, created: true })
+    expect(saved.filePath).not.toBe(file)
+    expect(readFileSync(file).equals(original)).toBe(true) // 원본은 그대로
+    expect(at(await pixels(saved.filePath), 0, 0)).toEqual([255, 255, 255, 254])
+
+    const listed = listScenes(presetId)[0]
+    expect(listed).toMatchObject({
+      thumbnailPath: saved.filePath, // 즐겨찾기를 물려받아 대표 이미지가 된다
+      hasFavorite: true,
+      imageCount: 2,
+      pending: true // 칠한 그림은 새로 뽑은 그림이 아니다
+    })
+    const copy = getDb()
+      .prepare('SELECT kind, seed, payload_json, created_at FROM images WHERE file_path = ?')
+      .get(saved.filePath)
+    expect(copy).toEqual({
+      kind: 'scene',
+      seed: 7,
+      payload_json: '{"prompt":"x"}',
+      created_at: '2026-01-02 03:04:05'
+    })
+  })
+
+  it('reopens a painted copy on its original and rewrites that copy instead of adding another', async () => {
+    const { scene, file } = await sceneWithImage()
+    const first = await saveCensor(file, await maskPng())
+    const opened = await openCensor(first.filePath)
+    expect(opened.basePath).toBe(file) // 지우개가 원본을 되살릴 수 있게
+    expect(opened.maskBase64).not.toBeNull()
+    const mask = await sharp(Buffer.from(opened.maskBase64!, 'base64'))
+      .raw()
+      .toBuffer({ resolveWithObject: true })
+    const n = mask.info.channels
+    expect([mask.data[0], mask.data[2 * n], mask.data[3 * n]]).toEqual([255, 255, 0])
+
+    // 한 칸만 남기고 지움 — 지운 자리는 원본으로 돌아온다
+    const again = await saveCensor(first.filePath, await maskPng(1))
+    expect(again).toEqual({ filePath: first.filePath, sceneId: scene, created: false })
+    const data = await pixels(first.filePath)
+    expect(at(data, 0, 0).slice(0, 3)).toEqual([255, 255, 255])
+    expect(at(data, 2, 0).slice(0, 3)).toEqual([100, 110, 120])
+    expect((getDb().prepare('SELECT COUNT(*) AS n FROM images').get() as { n: number }).n).toBe(2)
+  })
+
+  it('makes no copy when nothing was painted, and forgets a record whose image id was reused', async () => {
+    const { file } = await sceneWithImage()
+    expect(await saveCensor(file, await maskPng(0))).toMatchObject({
+      filePath: file,
+      created: false
+    })
+    const saved = await saveCensor(file, await maskPng())
+    // 칠한 그림을 지운 뒤 그 id를 다른 그림이 다시 쓴 경우
+    const db = getDb()
+    const id = (
+      db.prepare('SELECT id FROM images WHERE file_path = ?').get(saved.filePath) as { id: number }
+    ).id
+    const other = join(environment.directory, 'images', 'other.png')
+    writeFileSync(other, await grayPng())
+    db.prepare('UPDATE images SET file_path = ? WHERE id = ?').run(other, id)
+    expect(await openCensor(other)).toMatchObject({ basePath: other, maskBase64: null })
+    expect(existsSync(saved.filePath)).toBe(true)
+  })
+
+  it('rejects an image that has no record', async () => {
+    await expect(
+      saveCensor(join(environment.directory, 'nope.png'), await maskPng())
+    ).rejects.toThrow()
+  })
+})

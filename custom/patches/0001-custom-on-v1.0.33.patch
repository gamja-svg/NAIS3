index 0000000000000000000000000000000000000000..8119e6469d54cf05178024550b5b2fc8849b558d
--- /dev/null
+++ b/src/renderer/src/lib/custom-preset-folders.ts
@@ -0,0 +1,121 @@
+/**
+ * [custom] 씬 프리셋 폴더 — 목록에 보일 묶음과 순서 계산.
+ * 폴더는 프리셋에 붙은 이름표다. 묶음은 그 폴더의 첫 프리셋 자리에 놓이고, 묶음 안 순서는 프리셋 순서 그대로다.
+ */
+
+export interface PresetLike {
+  id: number
+  name: string
+}
+
+export interface PresetGroup<P extends PresetLike> {
+  /** null = 폴더에 들지 않은 프리셋 하나 */
+  folder: string | null
+  presets: P[]
+}
+
+export function groupPresets<P extends PresetLike>(
+  presets: P[],
+  folders: Record<number, string>
+): PresetGroup<P>[] {
+  const groups: PresetGroup<P>[] = []
+  const byFolder = new Map<string, PresetGroup<P>>()
+  for (const preset of presets) {
+    const folder = folders[preset.id]
+    if (!folder) {
+      groups.push({ folder: null, presets: [preset] })
+      continue
+    }
+    let group = byFolder.get(folder)
+    if (!group) {
+      group = { folder, presets: [] }
+      byFolder.set(folder, group)
+      groups.push(group)
+    }
+    group.presets.push(preset)
+  }
+  return groups
+}
+
+/** 목록에 보이는 순서대로의 프리셋 id — 프리셋 순서를 여기에 맞춰 두면 ↑/↓ 넘기기도 보이는 순서를 따른다 */
+export function folderOrder<P extends PresetLike>(
+  presets: P[],
+  folders: Record<number, string>
+): number[] {
+  return groupPresets(presets, folders).flatMap((g) => g.presets.map((p) => p.id))
+}
+
+/**
+ * 한 칸 옮기기 — 폴더 안의 프리셋은 그 폴더 안에서, 폴더 밖 프리셋과 폴더 묶음은 묶음 단위로 자리를 바꾼다.
+ * id = 프리셋 id, 또는 폴더 이름(묶음째 옮기기). 옮길 수 없으면 null.
+ */
+export function moveInFolders<P extends PresetLike>(
+  presets: P[],
+  folders: Record<number, string>,
+  target: number | string,
+  dir: -1 | 1
+): number[] | null {
+  const groups = groupPresets(presets, folders)
+  if (typeof target === 'number' && folders[target]) {
+    const group = groups.find((g) => g.folder === folders[target])
+    if (!group) return null
+    const from = group.presets.findIndex((p) => p.id === target)
+    const to = from + dir
+    if (from < 0 || to < 0 || to >= group.presets.length) return null
+    group.presets.splice(to, 0, ...group.presets.splice(from, 1))
+  } else {
+    const from = groups.findIndex((g) =>
+      typeof target === 'number'
+        ? g.folder === null && g.presets[0].id === target
+        : g.folder === target
+    )
+    const to = from + dir
+    if (from < 0 || to < 0 || to >= groups.length) return null
+    groups.splice(to, 0, ...groups.splice(from, 1))
+  }
+  return groups.flatMap((g) => g.presets.map((p) => p.id))
+}
+
+/**
+ * 폴더에 넣을 때의 순서 — 넣는 프리셋을 그 폴더의 마지막 프리셋 뒤로 보낸다
+ * (폴더가 프리셋 자리로 끌려오지 않고, 프리셋이 폴더로 간다). 새 폴더면 순서는 그대로.
+ */
+export function joinOrder<P extends PresetLike>(
+  presets: P[],
+  folders: Record<number, string>,
+  joining: number[],
+  folder: string
+): number[] {
+  const moving = new Set(joining)
+  const rest = presets.map((p) => p.id).filter((id) => !moving.has(id))
+  const last = rest.findLastIndex((id) => folders[id] === folder)
+  if (last < 0) return presets.map((p) => p.id)
+  const moved = presets.map((p) => p.id).filter((id) => moving.has(id))
+  return [...rest.slice(0, last + 1), ...moved, ...rest.slice(last + 1)]
+}
+
+/** 이름의 첫 낱말 (띄어쓰기·밑줄·붙임표 앞까지) — 자동 묶기의 폴더 이름 */
+export function namePrefix(name: string): string {
+  return name.trim().split(/[\s_-]+/)[0] ?? ''
+}
+
+/**
+ * 이름으로 자동 묶기 — 아직 폴더에 없는 프리셋 가운데 이름의 첫 낱말이 같은 것이 둘 이상이면 그 낱말의 폴더로.
+ * 이미 그 이름의 폴더가 있으면 하나뿐이어도 거기에 넣는다. 돌려주는 값: 폴더 이름 → 넣을 프리셋 id들
+ */
+export function autoFolders<P extends PresetLike>(
+  presets: P[],
+  folders: Record<number, string>
+): Record<string, number[]> {
+  const existing = new Set(Object.values(folders))
+  const found = new Map<string, number[]>()
+  for (const preset of presets) {
+    if (folders[preset.id]) continue
+    const prefix = namePrefix(preset.name)
+    if (!prefix || prefix === preset.name.trim()) continue // 한 낱말짜리 이름은 묶을 기준이 없다
+    found.set(prefix, [...(found.get(prefix) ?? []), preset.id])
+  }
+  return Object.fromEntries(
+    [...found].filter(([prefix, ids]) => ids.length >= 2 || existing.has(prefix))
+  )
+}
diff --git a/src/renderer/src/lib/custom-prompt-diff.ts b/src/renderer/src/lib/custom-prompt-diff.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5be558f31093c336c95fdd39e2ddcd0c9830f12e
--- /dev/null
+++ b/src/renderer/src/lib/custom-prompt-diff.ts
@@ -0,0 +1,87 @@
+/**
+ * [custom] 미생성 씬에서 바뀐 태그 찾기 — 쉼표·줄바꿈으로 나눈 조각 단위로 기준과 비교한다.
+ * 가중치 묶음(`1.2::a, b::`)·괄호 강조는 조각 글자 그대로 비교하므로 숫자·괄호만 바뀌어도 바뀐 조각이 된다.
+ * 앞뒤·사이 공백 차이는 같은 것으로 본다.
+ */
+
+/** 바뀐 태그 칠 — 반투명 노랑 + 밑줄 (가중치 배경 위에 겹쳐도 보이게) */
+export const CHANGED_TAG_STYLE: React.CSSProperties = {
+  background: 'rgb(234 179 8 / 0.3)',
+  boxShadow: 'inset 0 -2px 0 rgb(234 179 8)',
+  borderRadius: 3,
+  boxDecorationBreak: 'clone',
+  WebkitBoxDecorationBreak: 'clone'
+}
+
+export interface TextRange {
+  start: number
+  end: number
+}
+
+interface Piece extends TextRange {
+  text: string
+  key: string
+}
+
+/** 쉼표·줄바꿈으로 나눈 태그 조각 (앞뒤 공백을 뺀 위치) */
+export function tagPieces(text: string): Piece[] {
+  const pieces: Piece[] = []
+  for (const m of text.matchAll(/[^,\n]+/g)) {
+    const trimmed = m[0].trim()
+    if (!trimmed) continue
+    const start = m.index + (m[0].length - m[0].trimStart().length)
+    pieces.push({
+      start,
+      end: start + trimmed.length,
+      text: trimmed,
+      key: trimmed.replace(/\s+/g, ' ')
+    })
+  }
+  return pieces
+}
+
+function countKeys(pieces: Piece[]): Map<string, number> {
+  const counts = new Map<string, number>()
+  for (const p of pieces) counts.set(p.key, (counts.get(p.key) ?? 0) + 1)
+  return counts
+}
+
+/** 기준(base)에 없던 조각의 위치 — 같은 태그가 여러 번이면 기준에 있던 개수만큼은 그대로 본다 */
+export function changedTagRanges(current: string, base: string): TextRange[] {
+  const left = countKeys(tagPieces(base))
+  const ranges: TextRange[] = []
+  for (const p of tagPieces(current)) {
+    const n = left.get(p.key) ?? 0
+    if (n > 0) left.set(p.key, n - 1)
+    else ranges.push({ start: p.start, end: p.end })
+  }
+  return ranges
+}
+
+/** 기준에는 있었는데 지금은 없는 조각 (빠진 태그) */
+export function removedTags(current: string, base: string): string[] {
+  const left = countKeys(tagPieces(current))
+  const removed: string[] = []
+  for (const p of tagPieces(base)) {
+    const n = left.get(p.key) ?? 0
+    if (n > 0) left.set(p.key, n - 1)
+    else removed.push(p.text)
+  }
+  return removed
+}
+
+/** 글을 칠할 구간과 아닌 구간으로 나눈다 (구간은 순서대로이고 겹치지 않는다) */
+export function markedSegments(
+  text: string,
+  ranges: TextRange[]
+): (TextRange & { marked: boolean })[] {
+  const segments: (TextRange & { marked: boolean })[] = []
+  let at = 0
+  for (const r of ranges) {
+    if (r.start > at) segments.push({ start: at, end: r.start, marked: false })
+    segments.push({ start: r.start, end: r.end, marked: true })
+    at = r.end
+  }
+  if (at < text.length) segments.push({ start: at, end: text.length, marked: false })
+  return segments
+}
diff --git a/src/renderer/src/lib/custom-prompt-target.ts b/src/renderer/src/lib/custom-prompt-target.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a749ca26eda70fd68ef53baf85067f0dadf3366b
--- /dev/null
+++ b/src/renderer/src/lib/custom-prompt-target.ts
@@ -0,0 +1,48 @@
+/**
+ * [custom] 조각 창에서 누른 조각을 "마지막으로 커서를 둔 프롬프트 칸"에 넣는다.
+ * 프롬프트 칸(PromptEditor)이 포커스를 받을 때 자기를 등록하고, 조각 창이 여기로 넣어 달라고 한다.
+ */
+
+/** 커서 자리(start~end)에 넣은 글과 넣은 뒤의 커서 자리 — 앞뒤 쉼표는 필요할 때만 붙인다 */
+export function insertAtCaret(
+  value: string,
+  start: number,
+  end: number,
+  text: string
+): { next: string; caret: number } {
+  const before = value.slice(0, start)
+  const after = value.slice(end)
+  const head = before.trimEnd()
+  // 앞: 줄 처음·쉼표 뒤가 아니면 쉼표로 띄운다
+  let lead = ''
+  if (head !== '' && !head.endsWith(',') && !before.endsWith('\n')) lead = ', '
+  else if (before.endsWith(',')) lead = ' '
+  // 뒤: 바로 이어 쓸 수 있게 ", " (이미 쉼표가 오면 생략)
+  const tail = after.trimStart().startsWith(',') ? '' : ', '
+  const keep = lead === ', ' ? head : before
+  const inserted = keep + lead + text + tail
+  return { next: inserted + after, caret: inserted.length }
+}
+
+export interface PromptTarget {
+  /** 커서 자리에 넣는다 */
+  insert: (text: string) => void
+}
+
+let current: PromptTarget | null = null
+
+export function setPromptTarget(target: PromptTarget): void {
+  current = target
+}
+
+/** 그 칸이 사라질 때 — 지금 등록된 칸이 자기일 때만 비운다 */
+export function clearPromptTarget(target: PromptTarget): void {
+  if (current === target) current = null
+}
+
+/** 마지막으로 커서를 둔 프롬프트 칸에 넣는다. 그런 칸이 없으면 false */
+export function insertIntoPrompt(text: string): boolean {
+  if (!current) return false
+  current.insert(text)
+  return true
+}

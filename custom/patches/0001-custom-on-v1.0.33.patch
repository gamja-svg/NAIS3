@@ -0,0 +1,42 @@
+import { useMemo } from 'react'
+import { CHANGED_TAG_STYLE, changedTagRanges, removedTags } from '../lib/custom-prompt-diff'
+import { useT } from '../lib/i18n'
+
+/**
+ * [custom] 미생성 씬의 프롬프트 아래 한 줄 — 노란색이 무엇인지와, 마지막으로 뽑은 뒤 빠진 태그.
+ * 바뀐 것이 없으면 그리지 않는다.
+ */
+export function ChangedTagsNote({
+  current,
+  base
+}: {
+  current: string
+  base: string
+}): React.JSX.Element | null {
+  const t = useT()
+  const changed = useMemo(() => changedTagRanges(current, base).length, [current, base])
+  const removed = useMemo(() => removedTags(current, base), [current, base])
+  if (changed === 0 && removed.length === 0) return null
+  return (
+    <p className="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[11.5px] leading-snug text-muted">
+      {changed > 0 && (
+        <span>
+          <span className="px-0.5 text-ink" style={CHANGED_TAG_STYLE}>
+            {t('ui.customChangedTagsYellow')}
+          </span>{' '}
+          {t('ui.customChangedTagsLegend')}
+        </span>
+      )}
+      {removed.length > 0 && (
+        <>
+          <span className={changed > 0 ? 'ml-1' : undefined}>{t('ui.customRemovedTags')}</span>
+          {removed.map((tag, i) => (
+            <s key={i} className="rounded bg-surface-2 px-1 font-mono text-[11px] text-faint">
+              {tag}
+            </s>
+          ))}
+        </>
+      )}
+    </p>
+  )
+}
diff --git a/src/renderer/src/components/custom-claude-panel.tsx b/src/renderer/src/components/custom-claude-panel.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..279529c1fb5190d39f0d076a646f86f1cd9af948
--- /dev/null
+++ b/src/renderer/src/components/custom-claude-panel.tsx
@@ -0,0 +1,304 @@
+import { ArrowLeft, Home, Link2, Loader2, Minus, Pin, Plus, RotateCw, X } from 'lucide-react'
+import { useEffect, useRef, useState } from 'react'
+import { useT } from '../lib/i18n'
+import { cn } from '../lib/utils'
+import {
+  CLAUDE_PANEL_DEFAULT_WIDTH,
+  isClaudeUrl,
+  sameRoom,
+  useClaudePanelStore
+} from '../stores/custom-claude-panel-store'
+import { askText } from '../stores/dialog-store'
+import { toast } from '../stores/toast-store'
+
+/**
+ * [custom] Claude 창 — 화면 오른쪽에 여닫는 작은 claude.ai 창. 지정한 방이 열 때마다 뜨고,
+ * 로그인은 전용 파티션에 남는다(앱·웹 검색과 쿠키를 나누지 않음). 새 창 링크는 기본 브라우저로 간다
+ * (main/custom/claude-chat.ts). 닫아도 한동안은 쓰던 화면 그대로 숨겨 둔다.
+ */
+
+const PARTITION = 'persist:claude-chat'
+/** 닫은 뒤 이만큼 다시 열지 않으면 창을 내려 메모리를 돌려준다 */
+const KEEP_ALIVE_MS = 30 * 60_000
+
+// <webview> JSX 타입은 React에 내장 — 쓰는 메서드(Electron WebviewTag)만 선언
+interface WebviewElement extends HTMLElement {
+  loadURL(url: string): Promise<void>
+  goBack(): void
+  reload(): void
+  canGoBack(): boolean
+  getURL(): string
+  setZoomFactor(factor: number): void
+}
+
+/** 한 번 연 뒤로는 닫아도 잠시 남겨 둔다 — 다시 열 때 새로 불러오지 않게 */
+function useKeepAlive(open: boolean): boolean {
+  const [mounted, setMounted] = useState(open)
+  if (open && !mounted) setMounted(true)
+  useEffect(() => {
+    if (open || !mounted) return
+    const timer = window.setTimeout(() => setMounted(false), KEEP_ALIVE_MS)
+    return () => clearTimeout(timer)
+  }, [open, mounted])
+  return mounted
+}
+
+export function ClaudePanel(): React.JSX.Element | null {
+  const open = useClaudePanelStore((s) => s.open)
+  const mounted = useKeepAlive(open)
+  return mounted ? <ClaudePanelBody open={open} /> : null
+}
+
+function ClaudePanelBody({ open }: { open: boolean }): React.JSX.Element {
+  const t = useT()
+  const width = useClaudePanelStore((s) => s.width)
+  const homeUrl = useClaudePanelStore((s) => s.homeUrl)
+  const zoom = useClaudePanelStore((s) => s.zoom)
+  const setOpen = useClaudePanelStore((s) => s.setOpen)
+  const setHomeUrl = useClaudePanelStore((s) => s.setHomeUrl)
+  const setZoom = useClaudePanelStore((s) => s.setZoom)
+
+  const webviewRef = useRef<WebviewElement | null>(null)
+  const [initialSrc] = useState(() => useClaudePanelStore.getState().homeUrl)
+  // 창이 펼쳐진 뒤에 붙인다 — 게스트 프로세스 생성과 첫 로딩이 앱 화면을 버벅이게 하지 않게
+  const [attached, setAttached] = useState(false)
+  const [url, setUrl] = useState(initialSrc)
+  const [title, setTitle] = useState('')
+  const [canBack, setCanBack] = useState(false)
+  const [loading, setLoading] = useState(false)
+  const [resizing, setResizing] = useState(false)
+
+  useEffect(() => {
+    const timer = window.setTimeout(() => setAttached(true), 250)
+    return () => clearTimeout(timer)
+  }, [])
+
+  useEffect(() => {
+    const wv = webviewRef.current
+    if (!wv) return
+    const onNavigate = (): void => {
+      setUrl(wv.getURL())
+      setCanBack(wv.canGoBack())
+    }
+    const onTitle = (e: Event): void => setTitle((e as Event & { title?: string }).title ?? '')
+    const onStart = (): void => setLoading(true)
+    const onStop = (): void => setLoading(false)
+    const onDomReady = (): void => {
+      wv.setZoomFactor(useClaudePanelStore.getState().zoom)
+      onNavigate()
+    }
+    const events: [string, (e: Event) => void][] = [
+      ['did-navigate', onNavigate],
+      ['did-navigate-in-page', onNavigate],
+      ['page-title-updated', onTitle],
+      ['did-start-loading', onStart],
+      ['did-stop-loading', onStop],
+      ['dom-ready', onDomReady]
+    ]
+    for (const [name, fn] of events) wv.addEventListener(name, fn)
+    return () => {
+      for (const [name, fn] of events) wv.removeEventListener(name, fn)
+    }
+  }, [attached])
+
+  // 웹뷰가 포커스를 받으면 창 포커스를 한 번 다시 잡아 준다 — 클릭으로 들어온 웹뷰에는 Windows
+  // 입력기가 붙지 않아 한/영 키가 안 먹을 때가 있다. 다시 잡는 동안 포커스가 한 번 더 들어오므로
+  // 잠깐 동안은 되풀이하지 않는다
+  useEffect(() => {
+    const wv = webviewRef.current
+    if (!wv) return
+    let last = 0
+    const onFocus = (): void => {
+      const now = Date.now()
+      if (now - last < 1500) return
+      last = now
+      void window.nais
+        .invoke('custom:windowRefocus', undefined)
+        .then(() => {
+          last = Date.now()
+          wv.focus()
+        })
+        .catch(() => {})
+    }
+    wv.addEventListener('focus', onFocus)
+    return () => wv.removeEventListener('focus', onFocus)
+  }, [attached])
+
+  // 닫으면 키 입력이 숨은 창으로 가지 않게 포커스를 뺀다
+  useEffect(() => {
+    if (!open) webviewRef.current?.blur()
+  }, [open])
+
+  const pinned = sameRoom(url, homeUrl)
+  const goHome = (): void => {
+    void webviewRef.current?.loadURL(useClaudePanelStore.getState().homeUrl)
+  }
+  const pin = (): void => {
+    if (!isClaudeUrl(url)) {
+      toast(t('ui.customClaudePinOnlyClaude'), 'error')
+      return
+    }
+    setHomeUrl(url)
+    toast(t('ui.customClaudePinnedDone'), 'success')
+  }
+  const openUrl = async (): Promise<void> => {
+    const input = (await askText(t('ui.customClaudeOpenUrl'), '', 'https://claude.ai/…'))?.trim()
+    if (!input) return
+    if (!/^https:\/\//i.test(input)) {
+      toast(t('ui.customClaudeHttpsOnly'), 'error')
+      return
+    }
+    void webviewRef.current?.loadURL(input)
+  }
+  const changeZoom = (next: number): void => {
+    setZoom(next)
+    try {
+      webviewRef.current?.setZoomFactor(useClaudePanelStore.getState().zoom)
+    } catch {
+      // 아직 준비 전 — dom-ready에서 맞춘다
+    }
+  }
+  // 왼쪽 가장자리를 끌어 폭 조절, 두 번 누르면 기본 폭
+  const startResize = (e: React.PointerEvent): void => {
+    if (e.button !== 0) return
+    e.preventDefault()
+    const startX = e.clientX
+    const startWidth = useClaudePanelStore.getState().width
+    setResizing(true)
+    const onMove = (ev: PointerEvent): void =>
+      useClaudePanelStore.getState().setWidth(startWidth - (ev.clientX - startX))
+    const onUp = (): void => {
+      setResizing(false)
+      window.removeEventListener('pointermove', onMove)
+      window.removeEventListener('pointerup', onUp)
+      const store = useClaudePanelStore.getState()
+      store.setWidth(store.width, true)
+    }
+    window.addEventListener('pointermove', onMove)
+    window.addEventListener('pointerup', onUp)
+  }
+
+  return (
+    <aside
+      className={cn('relative flex shrink-0 flex-col pb-3 pr-3', !open && 'hidden')}
+      style={{ width, maxWidth: '60vw' }}
+      aria-label={t('ui.customClaudePanel')}
+    >
+      <div
+        role="separator"
+        aria-orientation="vertical"
+        title={t('ui.customClaudeResize')}
+        className="group absolute inset-y-0 -left-3 z-20 flex w-3 cursor-col-resize justify-center pb-3"
+        onPointerDown={startResize}
+        onDoubleClick={() =>
+          useClaudePanelStore.getState().setWidth(CLAUDE_PANEL_DEFAULT_WIDTH, true)
+        }
+      >
+        <span
+          className={cn(
+            'h-full w-0.5 rounded-full transition-colors group-hover:bg-accent/40',
+            resizing && 'bg-accent/60'
+          )}
+        />
+      </div>
+      <div className="flex min-h-0 flex-1 flex-col overflow-hidden rounded-xl border border-line bg-surface">
+        <div className="flex h-9 shrink-0 items-center gap-0.5 border-b border-line px-1.5">
+          <span
+            className="min-w-0 flex-1 truncate px-1.5 text-[12px] font-medium text-muted"
+            title={url}
+          >
+            {title || 'Claude'}
+          </span>
+          <PanelButton
+            tip={t('ui.back')}
+            disabled={!canBack}
+            onClick={() => webviewRef.current?.goBack()}
+          >
+            <ArrowLeft size={14} />
+          </PanelButton>
+          <PanelButton tip={t('ui.customClaudeHome')} onClick={goHome}>
+            <Home size={14} />
+          </PanelButton>
+          <PanelButton
+            tip={pinned ? t('ui.customClaudePinned') : t('ui.customClaudePin')}
+            active={pinned}
+            onClick={pin}
+          >
+            <Pin size={14} />
+          </PanelButton>
+          <PanelButton tip={t('ui.customClaudeOpenUrl')} onClick={() => void openUrl()}>
+            <Link2 size={14} />
+          </PanelButton>
+          <PanelButton tip={t('ui.reload')} onClick={() => webviewRef.current?.reload()}>
+            {loading ? <Loader2 size={14} className="animate-spin" /> : <RotateCw size={14} />}
+          </PanelButton>
+          <PanelButton
+            tip={t('ui.zoomOut')}
+            disabled={zoom <= 0.5}
+            onClick={() => changeZoom(zoom - 0.1)}
+          >
+            <Minus size={14} />
+          </PanelButton>
+          <PanelButton
+            tip={t('ui.zoomIn')}
+            disabled={zoom >= 2}
+            onClick={() => changeZoom(zoom + 0.1)}
+          >
+            <Plus size={14} />
+          </PanelButton>
+          <PanelButton tip={t('ui.close')} onClick={() => setOpen(false)}>
+            <X size={15} />
+          </PanelButton>
+        </div>
+        <div className="relative min-h-0 flex-1 bg-white">
+          {attached && (
+            <webview
+              ref={(el) => {
+                webviewRef.current = el as WebviewElement | null
+              }}
+              src={initialSrc}
+              // eslint-disable-next-line react/no-unknown-property -- Electron webview 전용 속성
+              partition={PARTITION}
+              // 새 창 링크를 받으려면 켜야 한다 — 실제로 창을 열지는 않고 기본 브라우저로 보낸다
+              // eslint-disable-next-line react/no-unknown-property -- Electron webview 전용 속성
+              allowpopups={'true' as unknown as boolean}
+              className="absolute inset-0 h-full w-full"
+            />
+          )}
+        </div>
+      </div>
+      {/* 끄는 동안 마우스가 웹 창으로 빨려 들어가지 않게 덮는다 */}
+      {resizing && <div className="fixed inset-0 z-[70] cursor-col-resize" />}
+    </aside>
+  )
+}
+
+function PanelButton({
+  tip,
+  active,
+  disabled,
+  onClick,
+  children
+}: {
+  tip: string
+  active?: boolean
+  disabled?: boolean
+  onClick: () => void
+  children: React.ReactNode
+}): React.JSX.Element {
+  return (
+    <button
+      title={tip}
+      aria-label={tip}
+      aria-pressed={active}
+      disabled={disabled}
+      onClick={onClick}
+      className={cn(
+        'grid size-7 shrink-0 place-items-center rounded-md transition-colors hover:bg-surface-2 hover:text-ink disabled:opacity-35',
+        active ? 'text-accent-ink' : 'text-muted'
+      )}
+    >
+      {children}
+    </button>
+  )
+}
diff --git a/src/renderer/src/components/custom-folder-group-row.tsx b/src/renderer/src/components/custom-folder-group-row.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c181e6f12c261cf58fa65a25ce1421fec4bd826d
--- /dev/null
+++ b/src/renderer/src/components/custom-folder-group-row.tsx
@@ -0,0 +1,252 @@
+import { useSortable } from '@dnd-kit/sortable'
+import {
+  Check,
+  ChevronDown,
+  ChevronRight,
+  FolderInput,
+  FolderOutput,
+  FolderPlus,
+  Folders,
+  Palette,
+  Pencil,
+  Trash2,
+  X
+} from 'lucide-react'
+import { memo, useState } from 'react'
+import { FOLDER_COLORS, type FolderGroup } from '@shared/types'
+import { useT } from '../lib/i18n'
+import { cn } from '../lib/utils'
+import type { GroupActions } from '../lib/custom-folder-groups'
+import { useFolderGroupsStore } from '../stores/custom-folder-groups-store'
+import { Button } from './ui/button'
+import {
+  ContextMenu,
+  ContextMenuContent,
+  ContextMenuItem,
+  ContextMenuSeparator,
+  ContextMenuSub,
+  ContextMenuSubContent,
+  ContextMenuSubTrigger,
+  ContextMenuTrigger
+} from './ui/context-menu'
+import { Input } from './ui/input'
+import { Popover, PopoverContent, PopoverTrigger } from './ui/popover'
+
+// dnd-kit은 useSortable 반환값으로 콜백 ref와 렌더 시점 상태를 함께 준다 (원본 폴더 행과 같은 사정)
+/* eslint-disable react-hooks/refs */
+/**
+ * [custom] 상위 폴더 행 — 폴더 행과 같은 동작(접기·이름·색·삭제, 통째로 끌기)에
+ * 폴더 행과 헷갈리지 않게 테두리와 묶음 아이콘을 둔다.
+ */
+export const FolderGroupRow = memo(
+  FolderGroupRowInner,
+  // actions는 부모가 매 렌더 새로 만들지만 동작만 담으므로 비교에서 제외 (원본 폴더 행과 같다)
+  (a, b) => a.group === b.group && a.folderCount === b.folderCount && a.searching === b.searching
+) as typeof FolderGroupRowInner
+
+function FolderGroupRowInner({
+  group,
+  folderCount,
+  actions,
+  searching
+}: {
+  group: FolderGroup
+  folderCount: number
+  actions: GroupActions
+  searching: boolean
+}): React.JSX.Element {
+  const t = useT()
+  const [editing, setEditing] = useState(false)
+  const sortable = useSortable({ id: `g-${group.id}`, disabled: searching || editing })
+  const move = sortable.transform
+  const style: React.CSSProperties = {
+    transform: move ? `translate3d(0, ${Math.round(move.y)}px, 0)` : undefined,
+    transition: sortable.transition,
+    ...(group.color
+      ? {
+          borderColor: group.color,
+          backgroundColor: `color-mix(in srgb, ${group.color} 16%, var(--surface))`
+        }
+      : {})
+  }
+
+  return (
+    <ContextMenu>
+      <ContextMenuTrigger asChild>
+        <div
+          ref={sortable.setNodeRef}
+          style={style}
+          className={cn(
+            'group flex h-10 items-center gap-1.5 rounded-lg border-2 border-line bg-surface px-1.5',
+            sortable.isDragging && 'relative z-20 opacity-75'
+          )}
+          {...(searching || editing ? {} : sortable.attributes)}
+          {...(searching || editing ? {} : sortable.listeners)}
+        >
+          <button className="text-muted" onClick={() => actions.toggleCollapse(group.id)}>
+            {group.collapsed ? <ChevronRight size={15} /> : <ChevronDown size={15} />}
+          </button>
+          <Folders
+            size={15}
+            className="shrink-0 text-muted"
+            style={group.color ? { color: group.color } : undefined}
+          />
+          {editing ? (
+            <Input
+              autoFocus
+              className="h-7 w-0 flex-1 text-[13px]"
+              defaultValue={group.name}
+              onPointerDown={(e) => e.stopPropagation()}
+              onBlur={(e) => {
+                if (e.target.value.trim()) actions.rename(group.id, e.target.value.trim())
+                setEditing(false)
+              }}
+              onKeyDown={(e) => {
+                if (e.key === 'Enter') e.currentTarget.blur()
+                if (e.key === 'Escape') setEditing(false)
+              }}
+            />
+          ) : (
+            // 이름 클릭 = 접기/펼치기 (이름 변경은 연필 버튼/우클릭으로만)
+            <button
+              className="min-w-0 flex-1 truncate text-left text-[13.5px] font-semibold text-ink"
+              onClick={() => actions.toggleCollapse(group.id)}
+            >
+              {group.name}
+              <span className="ml-1.5 font-mono text-[10.5px] font-normal text-faint">
+                {folderCount}
+              </span>
+            </button>
+          )}
+          {/* opacity로 숨김(display 아님) — 팝오버 앵커 유지 (원본 폴더 행과 같다) */}
+          <div className="flex items-center gap-0.5 opacity-0 transition-opacity focus-within:opacity-100 group-hover:opacity-100">
+            <Button
+              size="sm"
+              variant="ghost"
+              className="h-7 w-7 p-0"
+              title={t('ui.customAddFolderToGroup')}
+              onClick={() => actions.addFolder(group.id)}
+            >
+              <FolderPlus size={14} />
+            </Button>
+            <Popover>
+              <PopoverTrigger asChild>
+                <Button
+                  size="sm"
+                  variant="ghost"
+                  className="h-7 w-7 p-0"
+                  title={t('ui.folderColor')}
+                  onPointerDown={(e) => e.stopPropagation()}
+                >
+                  <Palette size={13} />
+                </Button>
+              </PopoverTrigger>
+              <PopoverContent className="w-auto p-1.5" onPointerDown={(e) => e.stopPropagation()}>
+                <div className="flex items-center gap-1">
+                  <button
+                    className="grid size-6 place-items-center rounded-md border border-line text-faint hover:text-ink"
+                    title={t('ui.noColor')}
+                    onClick={() => actions.setColor(group.id, null)}
+                  >
+                    <X size={13} />
+                  </button>
+                  {FOLDER_COLORS.map((c) => (
+                    <button
+                      key={c}
+                      className={cn(
+                        'size-6 rounded-md border transition-transform hover:scale-110',
+                        group.color === c ? 'border-ink' : 'border-transparent'
+                      )}
+                      style={{ backgroundColor: c }}
+                      onClick={() => actions.setColor(group.id, c)}
+                    />
+                  ))}
+                </div>
+              </PopoverContent>
+            </Popover>
+            <Button
+              size="sm"
+              variant="ghost"
+              className="h-7 w-7 p-0"
+              title={t('ui.rename.d3f4cb8')}
+              onClick={() => setEditing(true)}
+            >
+              <Pencil size={13} />
+            </Button>
+            <Button
+              size="sm"
+              variant="ghost"
+              className="h-7 w-7 p-0 hover:text-danger-ink"
+              title={t('ui.customDeleteFolderGroup')}
+              onClick={() => actions.remove(group.id)}
+            >
+              <Trash2 size={13} />
+            </Button>
+          </div>
+        </div>
+      </ContextMenuTrigger>
+      <ContextMenuContent>
+        <ContextMenuItem onSelect={() => actions.addFolder(group.id)}>
+          <FolderPlus size={13} /> {t('ui.customAddFolderToGroup')}
+        </ContextMenuItem>
+        <ContextMenuItem
+          onSelect={() => {
+            // 우클릭 메뉴가 닫힌 뒤 인라인 편집 시작
+            setTimeout(() => setEditing(true), 0)
+          }}
+        >
+          <Pencil size={13} /> {t('ui.rename')}
+        </ContextMenuItem>
+        <ContextMenuSeparator />
+        <ContextMenuItem danger onSelect={() => actions.remove(group.id)}>
+          <Trash2 size={13} /> {t('ui.customDeleteFolderGroup')}
+        </ContextMenuItem>
+      </ContextMenuContent>
+    </ContextMenu>
+  )
+}
+/* eslint-enable react-hooks/refs */
+
+/**
+ * [custom] 폴더 우클릭 메뉴의 '상위 폴더로 이동' — 메뉴를 열 때마다 최신 상위 폴더 목록을 읽는다
+ * (폴더 행은 memo라 다시 그려지지 않아도 이 부분은 스토어를 직접 구독한다)
+ */
+export function FolderGroupMenu({ folderId }: { folderId: number }): React.JSX.Element {
+  const t = useT()
+  const groups = useFolderGroupsStore((s) => s.groups)
+  const linked = useFolderGroupsStore((s) => s.links.get(folderId) ?? null)
+  const setFolderGroup = useFolderGroupsStore((s) => s.setFolderGroup)
+  const createGroup = useFolderGroupsStore((s) => s.createGroup)
+  const inGroup = groups.some((g) => g.id === linked) ? linked : null
+  return (
+    <>
+      <ContextMenuSub>
+        <ContextMenuSubTrigger>
+          <FolderInput size={13} /> {t('ui.customMoveToFolderGroup')}
+        </ContextMenuSubTrigger>
+        <ContextMenuSubContent>
+          {groups.map((g) => (
+            <ContextMenuItem
+              key={g.id}
+              disabled={g.id === inGroup}
+              onSelect={() => setFolderGroup(folderId, g.id)}
+            >
+              <Folders size={13} style={g.color ? { color: g.color } : undefined} />
+              <span className="min-w-0 flex-1 truncate">{g.name}</span>
+              {g.id === inGroup && <Check size={13} className="text-accent-ink" />}
+            </ContextMenuItem>
+          ))}
+          {groups.length > 0 && <ContextMenuSeparator />}
+          <ContextMenuItem onSelect={() => void createGroup(folderId)}>
+            <FolderPlus size={13} /> {t('ui.customNewFolderGroupWithFolder')}
+          </ContextMenuItem>
+        </ContextMenuSubContent>
+      </ContextMenuSub>
+      {inGroup != null && (
+        <ContextMenuItem onSelect={() => setFolderGroup(folderId, null)}>
+          <FolderOutput size={13} /> {t('ui.customRemoveFromFolderGroup')}
+        </ContextMenuItem>
+      )}
+    </>
+  )
+}
diff --git a/src/renderer/src/components/custom-fragment-negative.tsx b/src/renderer/src/components/custom-fragment-negative.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..342cd4c27920325bb7ff955662e33c77a189ff0d
--- /dev/null
+++ b/src/renderer/src/components/custom-fragment-negative.tsx
@@ -0,0 +1,168 @@
+import { Check, CircleMinus, Link2Off, Search } from 'lucide-react'
+import { useMemo, useState } from 'react'
+import type { Fragment, Scene } from '@shared/types'
+import { fragmentRef, pairedNegatives } from '@shared/custom-fragment-negatives'
+import { useT } from '../lib/i18n'
+import { cn } from '../lib/utils'
+import { useFragmentNegativeStore } from '../stores/custom-fragment-negative-store'
+import { useFragmentsStore } from '../stores/fragments-store'
+import { Input } from './ui/input'
+import { Popover, PopoverContent, PopoverTrigger } from './ui/popover'
+
+/**
+ * [custom] 조각 줄의 `네거 짝` — 짝이 있으면 이름표로 보이고, 누르면 짝을 고르거나 없앤다.
+ * 짝을 지어 두면 프롬프트에 이 조각이 있는 그림은 뽑을 때 네거 짝이 네거티브에 자동으로 붙는다.
+ */
+export function FragmentNegativePicker({ fragment }: { fragment: Fragment }): React.JSX.Element {
+  const t = useT()
+  const items = useFragmentsStore((s) => s.items)
+  const pairId = useFragmentNegativeStore((s) => s.pairs[fragment.id])
+  const setPair = useFragmentNegativeStore((s) => s.setPair)
+  const [open, setOpen] = useState(false)
+  const [search, setSearch] = useState('')
+  const pair = items.find((f) => f.id === pairId)
+  const q = search.trim().toLowerCase()
+  const choices = items.filter((f) => f.id !== fragment.id && f.name.toLowerCase().includes(q))
+  const item =
+    'flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left text-[13px] hover:bg-surface-2'
+  const choose = (id: number | null): void => {
+    setOpen(false)
+    void setPair(fragment.id, id)
+  }
+  return (
+    <Popover
+      open={open}
+      onOpenChange={(next) => {
+        setOpen(next)
+        if (next) setSearch('')
+      }}
+    >
+      <PopoverTrigger asChild>
+        <button
+          type="button"
+          className={cn(
+            'flex h-7 shrink-0 items-center gap-1 rounded-md px-1.5 text-[11.5px]',
+            pair
+              ? 'max-w-[45%] bg-danger/10 text-danger-ink hover:bg-danger/20'
+              : 'text-faint hover:text-ink'
+          )}
+          title={
+            pair
+              ? t('ui.customFragmentNegativeHintValue', pair.name)
+              : t('ui.customFragmentNegativeSet')
+          }
+          aria-label={t('ui.customFragmentNegativeSet')}
+          onPointerDown={(e) => e.stopPropagation()}
+        >
+          <CircleMinus size={13} className="shrink-0" />
+          {pair && <span className="truncate">{pair.name}</span>}
+        </button>
+      </PopoverTrigger>
+      <PopoverContent
+        align="end"
+        className="w-64 max-w-[80vw] p-1.5"
+        onPointerDown={(e) => e.stopPropagation()}
+      >
+        <p className="px-1 pb-1.5 text-[11.5px] leading-snug text-muted">
+          {t('ui.customFragmentNegativeAbout')}
+        </p>
+        <div className="relative mb-1">
+          <Search size={13} className="absolute left-2 top-1/2 -translate-y-1/2 text-faint" />
+          <Input
+            className="pl-7"
+            value={search}
+            placeholder={t('ui.search')}
+            onChange={(e) => setSearch(e.target.value)}
+          />
+        </div>
+        <div className="max-h-56 overflow-y-auto">
+          {choices.map((f) => (
+            <button key={f.id} type="button" className={item} onClick={() => choose(f.id)}>
+              <span className="min-w-0 flex-1 truncate" title={f.name}>
+                {f.name}
+              </span>
+              {f.id === pairId && <Check size={13} className="shrink-0 text-accent-ink" />}
+            </button>
+          ))}
+          {choices.length === 0 && (
+            <p className="px-2 py-3 text-center text-[12px] text-faint">
+              {t('ui.noSearchResults')}
+            </p>
+          )}
+        </div>
+        {pair && (
+          <>
+            <div className="my-1 h-px bg-line" />
+            <button type="button" className={cn(item, 'text-muted')} onClick={() => choose(null)}>
+              <Link2Off size={13} /> {t('ui.customFragmentNegativeClear')}
+            </button>
+          </>
+        )}
+      </PopoverContent>
+    </Popover>
+  )
+}
+
+/**
+ * [custom] 씬 편집의 네거티브 칸 아래 — 이 씬을 뽑을 때 자동으로 붙을 네거 짝과 `안 넣기` 버튼.
+ * 붙을 짝도 없고 꺼 둔 것도 아니면 아무것도 그리지 않는다.
+ */
+export function SceneNegativePairs({
+  scene,
+  prompts,
+  negative
+}: {
+  scene: Scene
+  /** 이 씬을 뽑을 때 쓰이는 프롬프트들 (기본 + 씬 + 캐릭터) */
+  prompts: string[]
+  /** 기본 + 씬 네거티브 */
+  negative: string
+}): React.JSX.Element | null {
+  const t = useT()
+  const items = useFragmentsStore((s) => s.items)
+  const folders = useFragmentsStore((s) => s.folders)
+  const pairs = useFragmentNegativeStore((s) => s.pairs)
+  const off = useFragmentNegativeStore((s) => s.offScenes.includes(scene.id))
+  const setSceneOff = useFragmentNegativeStore((s) => s.setSceneOff)
+  const paired = useMemo(
+    () => pairedNegatives(prompts, negative, items, folders, pairs),
+    [prompts, negative, items, folders, pairs]
+  )
+  if (paired.length === 0 && !off) return null
+  return (
+    <div className="flex items-center gap-2 rounded-md border border-danger/20 bg-danger/5 px-2 py-1.5 text-[12px]">
+      <CircleMinus size={13} className="shrink-0 text-danger-ink" />
+      <span className={cn('min-w-0 flex-1 leading-snug', off ? 'text-faint' : 'text-muted')}>
+        {off ? (
+          t('ui.customSceneNegativeOffNote')
+        ) : (
+          <>
+            {t('ui.customSceneNegativeAuto')}{' '}
+            <span className="font-mono text-danger-ink">
+              {paired.map((f) => fragmentRef(f, items, folders)).join(', ')}
+            </span>
+          </>
+        )}
+        {off && paired.length > 0 && (
+          <span className="ml-1 font-mono line-through">
+            {paired.map((f) => fragmentRef(f, items, folders)).join(', ')}
+          </span>
+        )}
+      </span>
+      <button
+        type="button"
+        className={cn(
+          'shrink-0 rounded-md px-2 py-1 text-[12px] font-medium',
+          off
+            ? 'bg-accent text-on-accent hover:opacity-90'
+            : 'border border-line bg-surface-2 text-ink hover:border-muted'
+        )}
+        title={t('ui.customSceneNegativeOffHint')}
+        aria-pressed={off}
+        onClick={() => void setSceneOff(scene.id, !off)}
+      >
+        {t(off ? 'ui.customSceneNegativeOn' : 'ui.customSceneNegativeOff')}
+      </button>
+    </div>
+  )
+}
diff --git a/src/renderer/src/components/custom-lane-tabs.tsx b/src/renderer/src/components/custom-lane-tabs.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f9c03239aa3b8b66688fd1511b9afc06832cf07c
--- /dev/null
+++ b/src/renderer/src/components/custom-lane-tabs.tsx
@@ -0,0 +1,104 @@
+import { displayOpusUsagePercent } from '@shared/anlas'
+import type { MessageId } from '@shared/i18n'
+import type { QueueLane } from '@shared/types'
+import { useT } from '../lib/i18n'
+import { cn } from '../lib/utils'
+import { useParallelStore, useQueueLanes, useViewedLane } from '../stores/custom-parallel-store'
+
+const PAUSE_LABEL: Record<NonNullable<QueueLane['pauseReason']>, MessageId> = {
+  exhausted: 'ui.customLanePausedExhausted',
+  noAnlas: 'ui.customLanePausedNoAnlas',
+  notOpus: 'ui.customLanePausedNotOpus',
+  unknown: 'ui.customLanePausedUnknown'
+}
+
+/**
+ * [custom] 동시 생성 중 미리보기 위 계정 탭 — 계정마다 상태·게이지·이번에 뽑은 수.
+ * 누르면 가운데 미리보기가 그 계정의 진행을 보여 준다.
+ */
+export function LaneTabs(): React.JSX.Element | null {
+  const t = useT()
+  const lanes = useQueueLanes()
+  const viewed = useViewedLane()
+  const accounts = useParallelStore((s) => s.accounts)
+  const balances = useParallelStore((s) => s.balances)
+  const setViewLane = useParallelStore((s) => s.setViewLane)
+  if (!lanes || lanes.length < 2) return null
+
+  return (
+    <div
+      role="tablist"
+      aria-label={t('ui.customLaneTabs')}
+      // 왼쪽 위 — 세로 그림은 보통 가운데에 놓이고 얼굴이 위쪽 가운데라 가리지 않게.
+      // 빈 자리는 클릭·창 끌기를 그대로 통과시키고 탭만 누를 수 있게 한다
+      className="pointer-events-none absolute left-2 right-2 top-2 z-30 flex flex-wrap gap-1.5"
+    >
+      {lanes.map((lane, index) => {
+        const label =
+          accounts.find((a) => a.id === lane.accountId)?.label ?? `#${String(index + 1)}`
+        const selected = viewed?.accountId === lane.accountId
+        const balance = balances[lane.accountId]
+        const gauge =
+          balance?.tier === 'opus' && balance.usage ? displayOpusUsagePercent(balance.usage) : null
+        const status = lane.generatingId
+          ? t('ui.customLaneGenerating')
+          : lane.pauseReason
+            ? t(PAUSE_LABEL[lane.pauseReason])
+            : t('ui.customLaneIdle')
+        const done = t('ui.customLaneDoneValue', lane.done)
+        const title = [
+          label,
+          status,
+          gauge != null ? t('ui.customLaneGaugeValue', gauge) : null,
+          balance?.anlas != null ? `Anlas ${balance.anlas}` : null,
+          done
+        ]
+          .filter(Boolean)
+          .join(' · ')
+        return (
+          <button
+            key={lane.accountId}
+            type="button"
+            role="tab"
+            aria-selected={selected}
+            title={title}
+            onClick={() => setViewLane(lane.accountId)}
+            className={cn(
+              'no-drag pointer-events-auto flex shrink-0 items-center gap-1.5 rounded-full border px-3 py-1 text-[12px] backdrop-blur transition-colors',
+              selected
+                ? 'border-accent bg-paper/95 text-ink'
+                : 'border-line bg-paper/75 text-muted hover:text-ink'
+            )}
+          >
+            <span
+              aria-hidden
+              className={cn(
+                'size-2 shrink-0 rounded-full',
+                lane.generatingId
+                  ? 'animate-pulse bg-success'
+                  : lane.pauseReason
+                    ? 'bg-warning'
+                    : 'bg-faint'
+              )}
+            />
+            <span className="max-w-[8rem] truncate font-medium">{label}</span>
+            <span className={cn(lane.pauseReason && !lane.generatingId && 'text-warning-ink')}>
+              {status}
+            </span>
+            {gauge != null && (
+              <span
+                className={cn(
+                  'font-mono text-[11px]',
+                  balance?.usage?.isNegative ? 'text-danger-ink' : 'text-faint'
+                )}
+              >
+                {gauge}%
+              </span>
+            )}
+            <span className="text-[11px] text-faint">{done}</span>
+          </button>
+        )
+      })}
+    </div>
+  )
+}

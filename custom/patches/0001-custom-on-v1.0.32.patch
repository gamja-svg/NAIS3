diff --git a/src/main/custom/folder-groups.ts b/src/main/custom/folder-groups.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9278b81aaebcfa577a6b52c06b457b0c1cca9605
--- /dev/null
+++ b/src/main/custom/folder-groups.ts
@@ -0,0 +1,140 @@
+import type {
+  FolderGroup,
+  FolderGroupKind,
+  FolderGroupLink,
+  FolderGroupPatch
+} from '../../shared/types'
+import { getDb } from '../db'
+
+/**
+ * [custom] 상위 폴더 — 폴더 여러 개를 묶는다 (지금은 캐릭터 프롬프트만).
+ * 원본 표는 건드리지 않고 전용 표 두 개에 둔다. 원본 마이그레이션 번호와 겹치지 않게 처음 쓸 때 만든다.
+ * - custom_folder_groups: 상위 폴더 (종류별 순서·접힘·색)
+ * - custom_folder_group_links: 폴더 → 상위 폴더 (행이 없으면 상위 폴더 밖)
+ * 폴더끼리의 순서는 원본 폴더 표의 순서를 그대로 쓴다.
+ */
+
+/** 종류별 원본 폴더 표 — SQL에 이름을 넣으므로 여기 있는 값만 받는다 */
+const FOLDER_TABLES: Record<FolderGroupKind, string> = { chars: 'character_folders' }
+
+function folderTable(kind: FolderGroupKind): string {
+  const table = FOLDER_TABLES[kind]
+  if (!table) throw new Error(`unknown folder group kind: ${String(kind)}`)
+  return table
+}
+
+const ready = new WeakSet<object>()
+function groupsDb(): ReturnType<typeof getDb> {
+  const db = getDb()
+  if (!ready.has(db)) {
+    db.exec(`
+      CREATE TABLE IF NOT EXISTS custom_folder_groups (
+        id INTEGER PRIMARY KEY,
+        kind TEXT NOT NULL,
+        name TEXT NOT NULL,
+        collapsed INTEGER NOT NULL DEFAULT 0,
+        color TEXT,
+        sort_order INTEGER NOT NULL DEFAULT 0
+      );
+      CREATE TABLE IF NOT EXISTS custom_folder_group_links (
+        kind TEXT NOT NULL,
+        folder_id INTEGER NOT NULL,
+        group_id INTEGER NOT NULL,
+        PRIMARY KEY (kind, folder_id)
+      );
+    `)
+    ready.add(db)
+  }
+  return db
+}
+
+export function listFolderGroups(kind: FolderGroupKind): {
+  groups: FolderGroup[]
+  links: FolderGroupLink[]
+} {
+  const table = folderTable(kind)
+  const db = groupsDb()
+  // 지워진 폴더나 상위 폴더를 가리키는 연결은 치운다
+  db.prepare(
+    `DELETE FROM custom_folder_group_links
+     WHERE kind = ?
+       AND (folder_id NOT IN (SELECT id FROM ${table})
+            OR group_id NOT IN (SELECT id FROM custom_folder_groups WHERE kind = ?))`
+  ).run(kind, kind)
+  const groups = (
+    db
+      .prepare(
+        `SELECT id, name, collapsed, color FROM custom_folder_groups
+         WHERE kind = ? ORDER BY sort_order, id`
+      )
+      .all(kind) as { id: number; name: string; collapsed: number; color: string | null }[]
+  ).map((r) => ({ id: r.id, name: r.name, collapsed: r.collapsed === 1, color: r.color ?? null }))
+  const links = db
+    .prepare(
+      `SELECT folder_id AS folderId, group_id AS groupId
+       FROM custom_folder_group_links WHERE kind = ?`
+    )
+    .all(kind) as FolderGroupLink[]
+  return { groups, links }
+}
+
+export function createFolderGroup(kind: FolderGroupKind, name: string): number {
+  folderTable(kind)
+  const db = groupsDb()
+  const { m } = db
+    .prepare('SELECT COALESCE(MAX(sort_order), -1) AS m FROM custom_folder_groups WHERE kind = ?')
+    .get(kind) as { m: number }
+  return Number(
+    db
+      .prepare('INSERT INTO custom_folder_groups (kind, name, sort_order) VALUES (?, ?, ?)')
+      .run(kind, name, m + 1).lastInsertRowid
+  )
+}
+
+export function updateFolderGroup(id: number, patch: FolderGroupPatch): void {
+  const db = groupsDb()
+  if (patch.name !== undefined)
+    db.prepare('UPDATE custom_folder_groups SET name = ? WHERE id = ?').run(patch.name, id)
+  if (patch.collapsed !== undefined)
+    db.prepare('UPDATE custom_folder_groups SET collapsed = ? WHERE id = ?').run(
+      patch.collapsed ? 1 : 0,
+      id
+    )
+  if (patch.color !== undefined)
+    db.prepare('UPDATE custom_folder_groups SET color = ? WHERE id = ?').run(patch.color, id)
+}
+
+/** 상위 폴더만 지운다 — 안의 폴더·카드는 그대로 남아 상위 폴더 밖으로 나온다 */
+export function deleteFolderGroup(id: number): void {
+  const db = groupsDb()
+  db.transaction(() => {
+    db.prepare('DELETE FROM custom_folder_group_links WHERE group_id = ?').run(id)
+    db.prepare('DELETE FROM custom_folder_groups WHERE id = ?').run(id)
+  })()
+}
+
+/** 상위 폴더 순서와 폴더 소속을 한 번에 저장 (끌어 놓기·메뉴로 옮긴 뒤) */
+export function arrangeFolderGroups(
+  kind: FolderGroupKind,
+  groupIds: number[],
+  links: FolderGroupLink[]
+): void {
+  const table = folderTable(kind)
+  const db = groupsDb()
+  const setOrder = db.prepare(
+    'UPDATE custom_folder_groups SET sort_order = ? WHERE id = ? AND kind = ?'
+  )
+  const insert = db.prepare(
+    `INSERT OR REPLACE INTO custom_folder_group_links (kind, folder_id, group_id)
+     SELECT ?, ?, ?
+     WHERE EXISTS (SELECT 1 FROM ${table} WHERE id = ?)
+       AND EXISTS (SELECT 1 FROM custom_folder_groups WHERE id = ? AND kind = ?)`
+  )
+  db.transaction(() => {
+    groupIds.forEach((id, i) => setOrder.run(i, id, kind))
+    db.prepare('DELETE FROM custom_folder_group_links WHERE kind = ?').run(kind)
+    for (const link of links) {
+      insert.run(kind, link.folderId, link.groupId, link.folderId, link.groupId, kind)
+    }
+  })()
+}
diff --git a/src/main/custom/parallel.ts b/src/main/custom/parallel.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6a280b84f789f9edcfc4b8954627a4bddd75d50c
--- /dev/null
+++ b/src/main/custom/parallel.ts
@@ -0,0 +1,111 @@
+import type { GenerationRequest, ParallelConfig } from '../../shared/types'
+import { getActiveNaiAccount, getNaiAccounts, getSetting, setSetting } from '../db/settings'
+import {
+  isOpusUsageExhausted,
+  requestUsesV5Usage,
+  type NaiAccountSelection
+} from '../nai/account-router'
+import { logBalance } from '../nai/anlas-log'
+import { fetchAnlasBalance } from '../nai/client'
+import { LanePauseError } from '../queue/generation-queue'
+import { broadcast } from '../ipc'
+
+/**
+ * [custom] 여러 계정으로 동시 생성 — 계정(레인)마다 한 장씩.
+ * 켜는 스위치와 '보낼 곳'은 설정에 두고, 큐는 여기 함수로 계정 목록과 보낼 곳을 읽는다.
+ * 원칙: 동시 생성은 Opus 계정만, 게이지가 바닥난 계정은 Anlas를 쓰지 않고 쉰다.
+ */
+const ENABLED_KEY = 'custom_parallel_accounts'
+const TARGET_KEY = 'custom_parallel_target'
+
+/** 쉬는 시간 — 게이지는 몇 분 안에 다시 차오르고, Opus 아닌 계정은 구독이 바뀔 때까지 */
+const PAUSE_MS = { exhausted: 60_000, notOpus: 5 * 60_000, unknown: 30_000 } as const
+
+export function getParallelConfig(): ParallelConfig {
+  return { enabled: getSetting(ENABLED_KEY) === '1', target: getSetting(TARGET_KEY) || null }
+}
+
+export function setParallelConfig(patch: Partial<ParallelConfig>): ParallelConfig {
+  if (patch.enabled !== undefined) setSetting(ENABLED_KEY, patch.enabled ? '1' : '0')
+  if (patch.target !== undefined) setSetting(TARGET_KEY, patch.target ?? '')
+  return getParallelConfig()
+}
+
+/** 큐가 쓸 계정 목록 — 꺼져 있으면 null (큐는 2개 미만이면 원래대로 한 장씩) */
+export function parallelLanes(): string[] | null {
+  if (getSetting(ENABLED_KEY) !== '1') return null
+  return getNaiAccounts().map((account) => account.id)
+}
+
+export function parallelTarget(): string | null {
+  return getSetting(TARGET_KEY) || null
+}
+
+type Balance = Awaited<ReturnType<typeof fetchAnlasBalance>>
+
+/** 계정별 잔액을 화면에 알린다. 활성 계정이면 상단 잔액 표시도 갱신 */
+function announce(accountId: string, balance: Balance): void {
+  broadcast('custom:laneBalance', {
+    accountId,
+    anlas: balance.anlas,
+    tier: balance.tier,
+    ...(balance.usage ? { usage: balance.usage } : {})
+  })
+  if (balance.anlas !== null && getActiveNaiAccount()?.id === accountId) {
+    broadcast('anlas:balance', {
+      anlas: balance.anlas,
+      tier: balance.tier,
+      ...(balance.usage ? { usage: balance.usage } : {})
+    })
+  }
+}
+
+/**
+ * 이 계정이 지금 이 요청을 뽑아도 되는지 확인하고 그 계정을 준다 (원본 계정 선택과 같은 모양).
+ * 안 되면 LanePauseError — 큐가 그 계정을 쉬게 하고 항목은 다른 계정에 넘긴다.
+ * 잔액은 장마다 새로 묻는다 (원본도 계정이 둘 이상이면 V5 생성 전마다 묻는다) — 묵은 값으로
+ * 게이지가 바닥난 줄 모르고 뽑아 Anlas가 나가는 일을 막는다.
+ */
+export async function laneSelection(
+  accountId: string,
+  request: GenerationRequest
+): Promise<NaiAccountSelection> {
+  const account = getNaiAccounts().find((a) => a.id === accountId)
+  if (!account) throw new LanePauseError('unknown', PAUSE_MS.unknown)
+  const balance = await fetchAnlasBalance(account.token)
+  // 조회 실패는 화면의 마지막 값을 지우지 않는다
+  if (balance.tier == null) throw new LanePauseError('unknown', PAUSE_MS.unknown)
+  announce(accountId, balance)
+  if (balance.tier !== 'opus') throw new LanePauseError('notOpus', PAUSE_MS.notOpus)
+  if (requestUsesV5Usage(request)) {
+    // 게이지를 모르면 뽑지 않는다 (원본 자동 전환도 게이지를 모르는 계정은 고르지 않는다)
+    if (!balance.usage) throw new LanePauseError('unknown', PAUSE_MS.unknown)
+    if (isOpusUsageExhausted(balance)) throw new LanePauseError('exhausted', PAUSE_MS.exhausted)
+  }
+  return { account, balance, rotated: false }
+}
+
+/** 계정별로 마지막에 기록한 잔액 — 그대로면 다시 기록하지 않는다 */
+const lastLogged = new Map<string, { anlas: number; day: string }>()
+
+/**
+ * 사용량 기록은 계정별로 남긴다 (원본 기록은 계정이 바뀐 행을 경계로 나눠 센다).
+ * 동시 생성은 계정이 번갈아 끝나서 매번 기록하면 경계가 계속 쌓이므로, 잔액이 그대로면 건너뛴다.
+ * 그날 첫 잔액은 오늘의 기준점이라 남긴다.
+ */
+function logLaneBalance(accountId: string, anlas: number): void {
+  const day = new Date().toDateString()
+  const previous = lastLogged.get(accountId)
+  if (previous && previous.anlas === anlas && previous.day === day) return
+  lastLogged.set(accountId, { anlas, day })
+  logBalance(anlas, accountId)
+}
+
+/** 생성이 끝난 뒤 잔액 갱신 (실패해도 생성 흐름엔 영향 없음) */
+export function refreshLaneBalance(accountId: string, token: string): void {
+  void fetchAnlasBalance(token).then((balance) => {
+    if (balance.tier == null) return
+    announce(accountId, balance)
+    if (balance.anlas !== null) logLaneBalance(accountId, balance.anlas)
+  })
+}
diff --git a/src/main/custom/watch-folder.ts b/src/main/custom/watch-folder.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ef3e564d7f9e3080c07180f2b826149530ae5933
--- /dev/null
+++ b/src/main/custom/watch-folder.ts
@@ -0,0 +1,269 @@
+import { readFileSync, readdirSync, statSync } from 'fs'
+import { basename, extname, join } from 'path'
+import type { WatchFolderConfig, WatchFolderEvent, WatchFolderFailure } from '../../shared/types'
+import { getSetting, setSetting } from '../db/settings'
+import { parseSceneImport } from '../scenes/import-formats'
+import { applyImportedScenes, createPreset, listPresets } from '../scenes/repo'
+
+/**
+ * [custom] 감시 폴더 — 지정한 폴더(하위 폴더 포함)에 씬 JSON이 새로 생기거나 바뀌면 자동으로 불러온다.
+ *
+ * - 보관 폴더를 그대로 감시한다: 파일을 옮기거나 지우거나 고치지 않는다.
+ * - 감시를 켠(또는 폴더를 고른) 시각 이후에 생기거나 수정된 파일만 불러온다. 원래 있던 파일(옛 버전
+ *   포함)은 건드리지 않는다. 처리한 파일은 크기·수정 시각을 기억해, 다시 바뀔 때까지 또 불러오지 않는다
+ *   (프로그램을 껐다 켜도 유지).
+ * - 불러오기는 파일 고르기와 같은 applyImportedScenes: 같은 이름 씬은 내용만 교체, 새 이름은 추가.
+ *   씬을 지우거나 이미지를 만들지는 않는다.
+ * - 프리셋 정하기: JSON 최상위 `preset` 이름(없으면 새로 만듦) → 없으면 파일 이름에 든 프리셋 이름.
+ *   파일 이름만으로는 프리셋을 새로 만들지 않는다.
+ * - fs.watch 대신 주기 확인: 동기화 폴더에서도 같게 동작하고, 쓰는 도중인 파일을 크기·수정 시각이
+ *   두 번 연속 같을 때까지 기다리기 쉽다.
+ */
+
+const ENABLED_KEY = 'custom_watch_enabled'
+const DIR_KEY = 'custom_watch_dir'
+const SINCE_KEY = 'custom_watch_since'
+const DONE_KEY = 'custom_watch_done'
+const POLL_MS = 3000
+const MAX_BYTES = 20 * 1024 * 1024
+const MAX_DEPTH = 6
+/** 한 번 훑을 때 보는 폴더 수 상한 — 실수로 드라이브 전체를 골라도 멈추지 않게 */
+const MAX_DIRS = 3000
+const SKIP_DIRS = new Set(['node_modules', '$recycle.bin', 'system volume information'])
+
+export function getWatchFolderConfig(): WatchFolderConfig {
+  return { enabled: getSetting(ENABLED_KEY) === '1', dir: getSetting(DIR_KEY) ?? '' }
+}
+
+/** 기준 시각을 지금으로 — 이 시각 이전부터 있던 파일은 불러오지 않는다 */
+function rebase(now: number): void {
+  setSetting(SINCE_KEY, String(now))
+  setSetting(DONE_KEY, '{}')
+  seen.clear()
+  done = null
+}
+
+export function setWatchFolderEnabled(enabled: boolean, now = Date.now()): WatchFolderConfig {
+  const was = getSetting(ENABLED_KEY) === '1'
+  setSetting(ENABLED_KEY, enabled ? '1' : '0')
+  if (enabled && !was) rebase(now)
+  return getWatchFolderConfig()
+}
+
+export function setWatchFolderDir(dir: string, now = Date.now()): WatchFolderConfig {
+  setSetting(DIR_KEY, dir)
+  rebase(now)
+  return getWatchFolderConfig()
+}
+
+const norm = (s: string): string => s.normalize('NFC').trim().toLowerCase()
+const isWordChar = (ch: string | undefined): boolean => !!ch && /[\p{L}\p{N}]/u.test(ch)
+
+/**
+ * 파일 이름에 든 프리셋 이름으로 프리셋을 고른다. 이름 앞뒤가 글자·숫자가 아니어야 맞는 것으로 친다
+ * (`D1`이 `D10`에 걸리지 않게). 여러 개가 맞으면 가장 긴 이름, 그것도 여럿이면 고르지 않는다.
+ */
+export function pickPresetByFileName(
+  fileName: string,
+  presets: readonly { id: number; name: string }[]
+): { id: number; name: string } | 'none' | 'ambiguous' {
+  const base = norm(basename(fileName, extname(fileName)))
+  let best: { id: number; name: string }[] = []
+  let bestLength = 0
+  for (const preset of presets) {
+    const name = norm(preset.name)
+    if (!name || name.length < bestLength) continue
+    let at = base.indexOf(name)
+    let hit = false
+    while (at >= 0 && !hit) {
+      hit = !isWordChar(base[at - 1]) && !isWordChar(base[at + name.length])
+      at = base.indexOf(name, at + 1)
+    }
+    if (!hit) continue
+    if (name.length > bestLength) {
+      best = [preset]
+      bestLength = name.length
+    } else best.push(preset)
+  }
+  if (best.length === 0) return 'none'
+  return best.length === 1 ? best[0] : 'ambiguous'
+}
+
+function declaredPreset(raw: string): string | null {
+  try {
+    const data = JSON.parse(raw.replace(/^\uFEFF/, '')) as unknown
+    if (typeof data === 'object' && data !== null && !Array.isArray(data)) {
+      const value = (data as Record<string, unknown>).preset
+      if (typeof value === 'string' && value.trim()) return value.trim()
+    }
+  } catch {
+    // 형식 오류는 parseSceneImport가 판정한다
+  }
+  return null
+}
+
+/** 감시 폴더의 파일 하나를 불러온다. file은 감시 폴더 기준 상대 경로(`/` 구분) */
+export function importWatchFile(dir: string, file: string): WatchFolderEvent {
+  const fail = (reason: WatchFolderFailure): WatchFolderEvent => ({ file, ok: false, reason })
+  let raw: string
+  try {
+    const path = join(dir, file)
+    if (statSync(path).size > MAX_BYTES) return fail('tooLarge')
+    raw = readFileSync(path, 'utf-8')
+  } catch {
+    return fail('readError')
+  }
+  const scenes = parseSceneImport(raw)
+  if (!scenes) return fail('unrecognized')
+  if (scenes.length === 0) return fail('empty')
+
+  const presets = listPresets()
+  const declared = declaredPreset(raw)
+  let preset: { id: number; name: string }
+  let created = false
+  if (declared) {
+    const found =
+      presets.find((p) => p.name.trim() === declared) ??
+      presets.find((p) => norm(p.name) === norm(declared))
+    if (found) preset = found
+    else {
+      preset = { id: createPreset(declared), name: declared }
+      created = true
+    }
+  } else {
+    const picked = pickPresetByFileName(file, presets)
+    if (picked === 'none') return fail('noPreset')
+    if (picked === 'ambiguous') return fail('ambiguousPreset')
+    preset = picked
+  }
+
+  const outcome = applyImportedScenes(preset.id, scenes)
+  return {
+    file,
+    ok: true,
+    presetId: preset.id,
+    presetName: preset.name,
+    presetCreated: created,
+    ...outcome
+  }
+}
+
+interface Found {
+  /** 감시 폴더 기준 상대 경로 (`/` 구분) */
+  file: string
+  signature: string
+  /** 수정 시각과 만든 시각 중 늦은 쪽 — 복사해 넣은 파일은 수정 시각이 옛날 그대로라 만든 시각도 본다 */
+  touched: number
+}
+
+function listJson(dir: string): Found[] {
+  const out: Found[] = []
+  let dirs = 0
+  const walk = (rel: string, depth: number): void => {
+    if (++dirs > MAX_DIRS) return
+    let entries
+    try {
+      entries = readdirSync(join(dir, rel), { withFileTypes: true })
+    } catch {
+      return
+    }
+    for (const entry of entries) {
+      const child = rel ? `${rel}/${entry.name}` : entry.name
+      if (entry.isDirectory()) {
+        if (depth >= MAX_DEPTH || entry.name.startsWith('.')) continue
+        if (SKIP_DIRS.has(entry.name.toLowerCase())) continue
+        walk(child, depth + 1)
+      } else if (entry.isFile() && extname(entry.name).toLowerCase() === '.json') {
+        try {
+          const st = statSync(join(dir, child))
+          out.push({
+            file: child,
+            signature: `${st.size}:${Math.round(st.mtimeMs)}`,
+            touched: Math.max(st.mtimeMs, st.birthtimeMs || 0)
+          })
+        } catch {
+          // 방금 지워진 파일
+        }
+      }
+    }
+  }
+  walk('', 0)
+  return out.sort((a, b) => a.file.localeCompare(b.file))
+}
+
+/** 파일별 직전 확인 값 — 크기·수정 시각이 두 번 연속 같아야(다 써진 뒤) 처리한다 */
+const seen = new Map<string, string>()
+/** 처리한 파일의 크기·수정 시각 (설정에 저장) */
+let done: Record<string, string> | null = null
+
+function loadDone(): Record<string, string> {
+  if (done) return done
+  try {
+    const parsed = JSON.parse(getSetting(DONE_KEY) ?? '{}') as unknown
+    done =
+      typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed)
+        ? (parsed as Record<string, string>)
+        : {}
+  } catch {
+    done = {}
+  }
+  return done
+}
+
+/** 폴더를 한 번 훑어, 켠 뒤에 새로 생기거나 바뀐 .json을 불러온다 */
+export function scanWatchFolder(): WatchFolderEvent[] {
+  const { enabled, dir } = getWatchFolderConfig()
+  if (!enabled || !dir) return []
+  try {
+    if (!statSync(dir).isDirectory()) return []
+  } catch {
+    return [] // 폴더가 잠깐 안 보일 때(외장·동기화) 기록을 지우지 않는다
+  }
+  const since = Number(getSetting(SINCE_KEY) ?? 0) || 0
+  const processed = loadDone()
+  const found = listJson(dir)
+  const present = new Set(found.map((f) => f.file))
+  for (const key of seen.keys()) if (!present.has(key)) seen.delete(key)
+  let dirty = false
+  for (const key of Object.keys(processed)) {
+    if (!present.has(key)) {
+      delete processed[key]
+      dirty = true
+    }
+  }
+  const events: WatchFolderEvent[] = []
+  for (const { file, signature, touched } of found) {
+    if (touched <= since || processed[file] === signature) continue
+    if (seen.get(file) !== signature) {
+      seen.set(file, signature)
+      continue
+    }
+    seen.delete(file)
+    events.push(importWatchFile(dir, file))
+    processed[file] = signature
+    dirty = true
+  }
+  if (dirty) setSetting(DONE_KEY, JSON.stringify(processed))
+  return events
+}
+
+let timer: ReturnType<typeof setInterval> | undefined
+
+export function startWatchFolder(notify: (event: WatchFolderEvent) => void): void {
+  stopWatchFolder()
+  timer = setInterval(() => {
+    try {
+      for (const event of scanWatchFolder()) notify(event)
+    } catch (e) {
+      console.error('[custom] watch folder scan failed', e)
+    }
+  }, POLL_MS)
+  timer.unref?.()
+}
+
+export function stopWatchFolder(): void {
+  if (timer) clearInterval(timer)
+  timer = undefined
+  seen.clear()
+  done = null
+}

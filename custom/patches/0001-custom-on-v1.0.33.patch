@@ -0,0 +1,248 @@
+import { existsSync, readFileSync, renameSync, writeFileSync } from 'fs'
+import { extname } from 'path'
+import type { CensorOpenResult, CensorSaveResult } from '../../shared/types'
+import { getDb } from '../db'
+import { t } from '../i18n'
+import { isUnderImagesRoot, saveGeneratedImage } from '../images/storage'
+import { getPresetName, getScene } from '../scenes/repo'
+import sharp from '../sharp'
+
+/**
+ * [custom] 검수 모드의 검열(흰칠) — 원본은 건드리지 않고, 칠한 그림을 같은 씬에 새 그림으로 저장한다.
+ *
+ * - 처음 칠하면 원본 옆에 새 파일(씬 이름_N)을 만들고 images 행을 하나 더 넣는다. 즐겨찾기·만든 시각은
+ *   원본 것을 물려받아, 원본이 대표 이미지였으면 새 그림이 대표가 되고 미생성 표시는 바뀌지 않는다.
+ * - 그 그림을 다시 고치면 새 파일을 또 만들지 않고 그 파일만 다시 쓴다. 지우개가 원본을 되살릴 수 있게
+ *   원본 경로와 칠한 자리(마스크)를 custom_censor에 남긴다.
+ * - 흰칠은 RGB만 바꾼다. 알파(NAI 숨김 메타데이터)와 PNG 글자 청크(프롬프트)는 그대로 옮긴다.
+ */
+
+function censorDb(): ReturnType<typeof getDb> {
+  const db = getDb()
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS custom_censor (
+      image_id INTEGER PRIMARY KEY,
+      file_path TEXT NOT NULL,
+      source_path TEXT NOT NULL,
+      mask BLOB NOT NULL
+    )
+  `)
+  return db
+}
+
+interface ImageRow {
+  id: number
+  file_path: string
+  kind: string
+  seed: number | null
+  payload_json: string
+  scene_id: number | null
+  favorite: number
+  created_at: string
+}
+
+interface CensorRow {
+  image_id: number
+  file_path: string
+  source_path: string
+  mask: Buffer
+}
+
+function imageByPath(filePath: string): ImageRow | undefined {
+  return censorDb()
+    .prepare(
+      `SELECT id, file_path, kind, seed, payload_json, scene_id, favorite, created_at
+       FROM images WHERE file_path = ? ORDER BY id DESC LIMIT 1`
+    )
+    .get(filePath) as ImageRow | undefined
+}
+
+/** 이 그림이 전에 칠해 둔 그림이면 그 기록. 그림 id는 지운 뒤 다시 쓰일 수 있어 파일 경로까지 맞춰 본다 */
+function censorOf(image: ImageRow): CensorRow | undefined {
+  const db = censorDb()
+  const saved = db.prepare('SELECT * FROM custom_censor WHERE image_id = ?').get(image.id) as
+    CensorRow | undefined
+  if (saved && saved.file_path !== image.file_path) {
+    db.prepare('DELETE FROM custom_censor WHERE image_id = ?').run(image.id)
+    return undefined
+  }
+  return saved
+}
+
+/** 고칠 그림을 연다 — 이미 칠한 그림이면 원본과 칠한 자리를 돌려준다 */
+export async function openCensor(filePath: string): Promise<CensorOpenResult> {
+  const row = imageByPath(filePath)
+  const saved = row ? censorOf(row) : undefined
+  // 원본이 옮겨졌거나 지워졌으면 칠한 그림을 바탕으로 쓴다 (그때는 지우개로 되살릴 수 없다)
+  const basePath = saved && existsSync(saved.source_path) ? saved.source_path : filePath
+  const meta = await sharp(basePath).metadata()
+  return {
+    basePath,
+    width: meta.width ?? 0,
+    height: meta.height ?? 0,
+    maskBase64: saved && basePath !== filePath ? saved.mask.toString('base64') : null
+  }
+}
+
+/** 바탕 그림을 data: 주소로 — 화면이 픽셀을 읽을 수 있게 (그림 폴더 안의 파일만) */
+export function readCensorBase(filePath: string): string {
+  if (!isUnderImagesRoot(filePath)) throw new Error(t('ui.customCensorNoImage'))
+  const mime = extname(filePath).toLowerCase() === '.webp' ? 'image/webp' : 'image/png'
+  return `data:${mime};base64,${readFileSync(filePath).toString('base64')}`
+}
+
+const PNG_SIG = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])
+/** 그림 내용이 아닌 청크 (프롬프트·색 정보) — 원본 것을 새 PNG로 옮긴다 */
+const KEEP_CHUNKS = new Set([
+  'tEXt',
+  'iTXt',
+  'zTXt',
+  'eXIf',
+  'iCCP',
+  'sRGB',
+  'gAMA',
+  'cHRM',
+  'pHYs'
+])
+
+function pngChunks(png: Buffer): { type: string; raw: Buffer }[] {
+  const out: { type: string; raw: Buffer }[] = []
+  if (png.length < 8 || !png.subarray(0, 8).equals(PNG_SIG)) return out
+  let at = 8
+  while (at + 12 <= png.length) {
+    const length = png.readUInt32BE(at)
+    const end = at + 12 + length
+    if (end > png.length) break
+    out.push({ type: png.toString('latin1', at + 4, at + 8), raw: png.subarray(at, end) })
+    at = end
+  }
+  return out
+}
+
+/** 새로 만든 PNG에 원본의 글자·색 청크를 옮겨 넣는다 (IHDR 바로 뒤) */
+export function copyPngMeta(source: Buffer, target: Buffer): Buffer {
+  const keep = pngChunks(source).filter((c) => KEEP_CHUNKS.has(c.type))
+  const chunks = pngChunks(target)
+  if (keep.length === 0 || chunks.length === 0 || chunks[0].type !== 'IHDR') return target
+  const rest = chunks.slice(1).filter((c) => !KEEP_CHUNKS.has(c.type))
+  return Buffer.concat([
+    PNG_SIG,
+    chunks[0].raw,
+    ...keep.map((c) => c.raw),
+    ...rest.map((c) => c.raw)
+  ])
+}
+
+/**
+ * 바탕 그림에 마스크만큼 흰칠을 해서 같은 형식으로 인코딩한다.
+ * maskPng: 칠한 자리가 알파로 담긴 PNG (그림과 같은 크기, 다르면 맞춘다)
+ */
+export async function paintWhite(
+  base: Buffer,
+  maskPng: Buffer,
+  format: 'png' | 'webp'
+): Promise<{ image: Buffer; mask: Buffer; painted: boolean }> {
+  const { data, info } = await sharp(base).raw().toBuffer({ resolveWithObject: true })
+  const { width, height, channels } = info
+  const alpha = await sharp(maskPng)
+    .ensureAlpha()
+    .extractChannel(3)
+    .resize(width, height, { fit: 'fill' })
+    .raw()
+    .toBuffer()
+  const color = Math.min(channels, 3)
+  let painted = false
+  for (let p = 0, i = 0; p < alpha.length; p++, i += channels) {
+    const a = alpha[p]
+    if (a === 0) continue
+    painted = true
+    for (let c = 0; c < color; c++)
+      data[i + c] = a === 255 ? 255 : Math.round(data[i + c] + ((255 - data[i + c]) * a) / 255)
+  }
+  const raw = sharp(data, { raw: { width, height, channels } })
+  const image =
+    format === 'webp'
+      ? await raw.webp({ lossless: true }).toBuffer()
+      : copyPngMeta(base, await raw.png().toBuffer())
+  // 다시 열 때 쓸 마스크 — 한 채널 PNG로 작게
+  const mask = await sharp(alpha, { raw: { width, height, channels: 1 } })
+    .png()
+    .toBuffer()
+  return { image, mask, painted }
+}
+
+async function thumbnailOf(image: Buffer): Promise<Buffer> {
+  return sharp(image).resize(640, 640, { fit: 'inside' }).webp({ quality: 90 }).toBuffer()
+}
+
+/** 다 쓴 뒤에 바꿔치기 — 쓰다가 끊겨도 반쯤 쓴 그림이 남지 않게 */
+function writeAtomic(filePath: string, data: Buffer): void {
+  const tmp = `${filePath}.tmp`
+  writeFileSync(tmp, data)
+  renameSync(tmp, filePath)
+}
+
+// 같은 그림을 겹쳐 저장하지 않게 차례로 처리한다 (자동 저장이 잇달아 올 수 있다)
+let chain: Promise<unknown> = Promise.resolve()
+
+/**
+ * 칠한 그림을 저장한다. filePath = 검열을 열 때의 대표 이미지(원본이거나, 전에 칠해 둔 그림).
+ * 돌려주는 filePath가 이제 씬의 대표 이미지다.
+ */
+export function saveCensor(filePath: string, maskBase64: string): Promise<CensorSaveResult> {
+  const run = chain.then(() => saveCensorNow(filePath, Buffer.from(maskBase64, 'base64')))
+  chain = run.catch(() => undefined)
+  return run
+}
+
+async function saveCensorNow(filePath: string, maskPng: Buffer): Promise<CensorSaveResult> {
+  const db = censorDb()
+  const row = imageByPath(filePath)
+  if (!row) throw new Error(t('ui.customCensorNoImage'))
+  const saved = censorOf(row)
+  const format = extname(row.file_path).toLowerCase() === '.webp' ? 'webp' : 'png'
+
+  if (saved) {
+    // 전에 칠해 둔 그림 — 원본에서 다시 칠해 그 파일만 다시 쓴다
+    const basePath = existsSync(saved.source_path) ? saved.source_path : row.file_path
+    const result = await paintWhite(readFileSync(basePath), maskPng, format)
+    writeAtomic(row.file_path, result.image)
+    db.prepare('UPDATE images SET thumbnail = ? WHERE id = ?').run(
+      await thumbnailOf(result.image),
+      row.id
+    )
+    db.prepare('UPDATE custom_censor SET mask = ? WHERE image_id = ?').run(result.mask, row.id)
+    return { filePath: row.file_path, sceneId: row.scene_id, created: false }
+  }
+
+  const result = await paintWhite(readFileSync(row.file_path), maskPng, format)
+  // 아무것도 칠하지 않았으면 새 그림을 만들지 않는다
+  if (!result.painted) return { filePath: row.file_path, sceneId: row.scene_id, created: false }
+  const scene = row.scene_id != null ? getScene(row.scene_id) : null
+  const copy = await saveGeneratedImage({
+    png: result.image,
+    sentPayload: row.payload_json,
+    seed: row.seed ?? 0,
+    kind: row.kind as Parameters<typeof saveGeneratedImage>[0]['kind'],
+    format,
+    ...(scene
+      ? {
+          sceneId: scene.id,
+          sceneName: scene.name,
+          scenePresetName: getPresetName(scene.presetId) ?? undefined
+        }
+      : {})
+  })
+  db.transaction(() => {
+    db.prepare('UPDATE images SET favorite = ?, created_at = ? WHERE id = ?').run(
+      row.favorite,
+      row.created_at,
+      copy.id
+    )
+    db.prepare(
+      `INSERT OR REPLACE INTO custom_censor (image_id, file_path, source_path, mask)
+       VALUES (?, ?, ?, ?)`
+    ).run(copy.id, copy.filePath, row.file_path, result.mask)
+  })()
+  return { filePath: copy.filePath, sceneId: copy.sceneId ?? null, created: true }
+}
diff --git a/src/main/custom/claude-chat.ts b/src/main/custom/claude-chat.ts
new file mode 100644
index 0000000000000000000000000000000000000000..07fadc2cc98fe3acf138dc062a4de2b92638f762
--- /dev/null
+++ b/src/main/custom/claude-chat.ts
@@ -0,0 +1,40 @@
+import { session, shell, type WebContents } from 'electron'
+
+/**
+ * [custom] Claude 창 — 화면 오른쪽의 작은 claude.ai 창(<webview>). 로그인이 남도록 전용 파티션을 쓰고,
+ * 앱·웹 검색과 쿠키를 나누지 않는다. preload·node 차단은 모든 webview 공통(will-attach-webview).
+ */
+export const CLAUDE_CHAT_PARTITION = 'persist:claude-chat'
+
+/** 로그인 창은 같은 창에서 연다 (바깥 브라우저로 보내면 그쪽에 로그인된다) */
+const SIGN_IN_HOSTS = new Set(['accounts.google.com', 'appleid.apple.com'])
+/** 대화 화면에 필요한 것만 — 마이크·카메라·위치·알림 등은 묻지 않고 막는다 */
+const ALLOWED_PERMISSIONS = new Set(['clipboard-read', 'clipboard-sanitized-write', 'fullscreen'])
+
+let prepared = false
+
+/** 이 webview가 Claude 창이면 링크·권한 규칙을 걸고 true */
+export function guardClaudeChatGuest(contents: WebContents): boolean {
+  const chat = session.fromPartition(CLAUDE_CHAT_PARTITION)
+  if (contents.session !== chat) return false
+  if (!prepared) {
+    prepared = true
+    chat.setPermissionRequestHandler((_contents, permission, callback) =>
+      callback(ALLOWED_PERMISSIONS.has(permission))
+    )
+  }
+  // 새 창으로 여는 링크(출처·첨부 등)는 기본 브라우저로 — 대화 화면이 바뀌지 않게
+  contents.setWindowOpenHandler(({ url }) => {
+    let parsed: URL
+    try {
+      parsed = new URL(url)
+    } catch {
+      return { action: 'deny' }
+    }
+    if (parsed.protocol !== 'https:' && parsed.protocol !== 'http:') return { action: 'deny' }
+    if (SIGN_IN_HOSTS.has(parsed.hostname)) void contents.loadURL(url)
+    else void shell.openExternal(url)
+    return { action: 'deny' }
+  })
+  return true
+}
diff --git a/src/main/custom/folder-groups.ts b/src/main/custom/folder-groups.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9278b81aaebcfa577a6b52c06b457b0c1cca9605
--- /dev/null
+++ b/src/main/custom/folder-groups.ts
@@ -0,0 +1,140 @@
+import type {
+  FolderGroup,
+  FolderGroupKind,
+  FolderGroupLink,
+  FolderGroupPatch
+} from '../../shared/types'
+import { getDb } from '../db'
+
+/**
+ * [custom] 상위 폴더 — 폴더 여러 개를 묶는다 (지금은 캐릭터 프롬프트만).
+ * 원본 표는 건드리지 않고 전용 표 두 개에 둔다. 원본 마이그레이션 번호와 겹치지 않게 처음 쓸 때 만든다.
+ * - custom_folder_groups: 상위 폴더 (종류별 순서·접힘·색)
+ * - custom_folder_group_links: 폴더 → 상위 폴더 (행이 없으면 상위 폴더 밖)
+ * 폴더끼리의 순서는 원본 폴더 표의 순서를 그대로 쓴다.
+ */
+
+/** 종류별 원본 폴더 표 — SQL에 이름을 넣으므로 여기 있는 값만 받는다 */
+const FOLDER_TABLES: Record<FolderGroupKind, string> = { chars: 'character_folders' }
+
+function folderTable(kind: FolderGroupKind): string {
+  const table = FOLDER_TABLES[kind]
+  if (!table) throw new Error(`unknown folder group kind: ${String(kind)}`)
+  return table
+}
+
+const ready = new WeakSet<object>()
+function groupsDb(): ReturnType<typeof getDb> {
+  const db = getDb()
+  if (!ready.has(db)) {
+    db.exec(`
+      CREATE TABLE IF NOT EXISTS custom_folder_groups (
+        id INTEGER PRIMARY KEY,
+        kind TEXT NOT NULL,
+        name TEXT NOT NULL,
+        collapsed INTEGER NOT NULL DEFAULT 0,
+        color TEXT,
+        sort_order INTEGER NOT NULL DEFAULT 0
+      );
+      CREATE TABLE IF NOT EXISTS custom_folder_group_links (
+        kind TEXT NOT NULL,
+        folder_id INTEGER NOT NULL,
+        group_id INTEGER NOT NULL,
+        PRIMARY KEY (kind, folder_id)
+      );
+    `)
+    ready.add(db)
+  }
+  return db
+}
+
+export function listFolderGroups(kind: FolderGroupKind): {
+  groups: FolderGroup[]
+  links: FolderGroupLink[]
+} {
+  const table = folderTable(kind)
+  const db = groupsDb()
+  // 지워진 폴더나 상위 폴더를 가리키는 연결은 치운다
+  db.prepare(
+    `DELETE FROM custom_folder_group_links
+     WHERE kind = ?
+       AND (folder_id NOT IN (SELECT id FROM ${table})
+            OR group_id NOT IN (SELECT id FROM custom_folder_groups WHERE kind = ?))`
+  ).run(kind, kind)
+  const groups = (
+    db
+      .prepare(
+        `SELECT id, name, collapsed, color FROM custom_folder_groups
+         WHERE kind = ? ORDER BY sort_order, id`
+      )
+      .all(kind) as { id: number; name: string; collapsed: number; color: string | null }[]
+  ).map((r) => ({ id: r.id, name: r.name, collapsed: r.collapsed === 1, color: r.color ?? null }))
+  const links = db
+    .prepare(
+      `SELECT folder_id AS folderId, group_id AS groupId
+       FROM custom_folder_group_links WHERE kind = ?`
+    )
+    .all(kind) as FolderGroupLink[]
+  return { groups, links }
+}
+
+export function createFolderGroup(kind: FolderGroupKind, name: string): number {
+  folderTable(kind)
+  const db = groupsDb()
+  const { m } = db
+    .prepare('SELECT COALESCE(MAX(sort_order), -1) AS m FROM custom_folder_groups WHERE kind = ?')
+    .get(kind) as { m: number }
+  return Number(
+    db
+      .prepare('INSERT INTO custom_folder_groups (kind, name, sort_order) VALUES (?, ?, ?)')
+      .run(kind, name, m + 1).lastInsertRowid
+  )
+}
+
+export function updateFolderGroup(id: number, patch: FolderGroupPatch): void {
+  const db = groupsDb()
+  if (patch.name !== undefined)
+    db.prepare('UPDATE custom_folder_groups SET name = ? WHERE id = ?').run(patch.name, id)
+  if (patch.collapsed !== undefined)
+    db.prepare('UPDATE custom_folder_groups SET collapsed = ? WHERE id = ?').run(
+      patch.collapsed ? 1 : 0,
+      id
+    )
+  if (patch.color !== undefined)
+    db.prepare('UPDATE custom_folder_groups SET color = ? WHERE id = ?').run(patch.color, id)
+}
+
+/** 상위 폴더만 지운다 — 안의 폴더·카드는 그대로 남아 상위 폴더 밖으로 나온다 */
+export function deleteFolderGroup(id: number): void {
+  const db = groupsDb()
+  db.transaction(() => {
+    db.prepare('DELETE FROM custom_folder_group_links WHERE group_id = ?').run(id)
+    db.prepare('DELETE FROM custom_folder_groups WHERE id = ?').run(id)
+  })()
+}
+
+/** 상위 폴더 순서와 폴더 소속을 한 번에 저장 (끌어 놓기·메뉴로 옮긴 뒤) */
+export function arrangeFolderGroups(
+  kind: FolderGroupKind,
+  groupIds: number[],
+  links: FolderGroupLink[]
+): void {
+  const table = folderTable(kind)
+  const db = groupsDb()
+  const setOrder = db.prepare(
+    'UPDATE custom_folder_groups SET sort_order = ? WHERE id = ? AND kind = ?'
+  )
+  const insert = db.prepare(
+    `INSERT OR REPLACE INTO custom_folder_group_links (kind, folder_id, group_id)
+     SELECT ?, ?, ?
+     WHERE EXISTS (SELECT 1 FROM ${table} WHERE id = ?)
+       AND EXISTS (SELECT 1 FROM custom_folder_groups WHERE id = ? AND kind = ?)`
+  )
+  db.transaction(() => {
+    groupIds.forEach((id, i) => setOrder.run(i, id, kind))
+    db.prepare('DELETE FROM custom_folder_group_links WHERE kind = ?').run(kind)
+    for (const link of links) {
+      insert.run(kind, link.folderId, link.groupId, link.folderId, link.groupId, kind)
+    }
+  })()
+}
diff --git a/src/main/custom/fragment-negatives.ts b/src/main/custom/fragment-negatives.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0d8608fb93dfd4c1b0320622d9a92d6ba94bc490
--- /dev/null
+++ b/src/main/custom/fragment-negatives.ts
@@ -0,0 +1,104 @@
+import { pairedNegatives, withPairedNegatives } from '../../shared/custom-fragment-negatives'
+import type { GenerationRequest } from '../../shared/types'
+import { getDb } from '../db'
+import { listFragments } from '../fragments/repo'
+
+/**
+ * [custom] 조각의 네거 짝 — 조각마다 "같이 붙을 네거 조각" 하나.
+ * 뽑을 때 프롬프트에 그 조각이 있으면 네거 짝이 네거티브에 자동으로 붙는다.
+ * 씬마다 끌 수 있다 (custom_scene_negative_off).
+ */
+let ready: object | null = null
+function db(): ReturnType<typeof getDb> {
+  const database = getDb()
+  if (ready !== database) {
+    database.exec(
+      'CREATE TABLE IF NOT EXISTS custom_fragment_negatives (fragment_id INTEGER PRIMARY KEY, negative_id INTEGER NOT NULL)'
+    )
+    database.exec(
+      'CREATE TABLE IF NOT EXISTS custom_scene_negative_off (scene_id INTEGER PRIMARY KEY)'
+    )
+    ready = database
+  }
+  return database
+}
+
+/** 조각 id → 네거 짝 조각 id. 사라진 조각의 줄은 치운다 */
+export function getFragmentNegatives(): Record<number, number> {
+  const database = db()
+  database
+    .prepare(
+      `DELETE FROM custom_fragment_negatives
+       WHERE fragment_id NOT IN (SELECT id FROM fragments)
+          OR negative_id NOT IN (SELECT id FROM fragments)`
+    )
+    .run()
+  const rows = database
+    .prepare('SELECT fragment_id AS f, negative_id AS n FROM custom_fragment_negatives')
+    .all() as { f: number; n: number }[]
+  return Object.fromEntries(rows.map((r) => [r.f, r.n]))
+}
+
+/** 네거 짝 지정 (null = 없애기). 자기 자신은 짝이 될 수 없다 */
+export function setFragmentNegative(fragmentId: number, negativeId: number | null): void {
+  const database = db()
+  if (negativeId == null || negativeId === fragmentId)
+    database.prepare('DELETE FROM custom_fragment_negatives WHERE fragment_id = ?').run(fragmentId)
+  else
+    database
+      .prepare(
+        `INSERT INTO custom_fragment_negatives (fragment_id, negative_id) VALUES (?, ?)
+         ON CONFLICT(fragment_id) DO UPDATE SET negative_id = excluded.negative_id`
+      )
+      .run(fragmentId, negativeId)
+}
+
+/** 이 씬은 네거 짝을 자동으로 붙이지 않는다 */
+export function isSceneNegativeOff(sceneId: number): boolean {
+  return (
+    db().prepare('SELECT 1 FROM custom_scene_negative_off WHERE scene_id = ?').get(sceneId) !==
+    undefined
+  )
+}
+
+/** 값이 실제로 바뀌었으면 true */
+export function setSceneNegativeOff(sceneId: number, off: boolean): boolean {
+  if (isSceneNegativeOff(sceneId) === off) return false
+  if (off)
+    db()
+      .prepare('INSERT OR IGNORE INTO custom_scene_negative_off (scene_id) VALUES (?)')
+      .run(sceneId)
+  else db().prepare('DELETE FROM custom_scene_negative_off WHERE scene_id = ?').run(sceneId)
+  return true
+}
+
+export function listSceneNegativeOff(): number[] {
+  db()
+    .prepare(
+      'DELETE FROM custom_scene_negative_off WHERE scene_id NOT IN (SELECT id FROM gen_scenes)'
+    )
+    .run()
+  return (
+    db().prepare('SELECT scene_id AS id FROM custom_scene_negative_off').all() as { id: number }[]
+  ).map((r) => r.id)
+}
+
+/** 뽑기 직전 — 프롬프트에 쓰인 조각의 네거 짝을 네거티브에 붙인 요청 (조각 치환 전에 부른다) */
+export function withFragmentNegatives(request: GenerationRequest): GenerationRequest {
+  if (request.sceneId !== undefined && isSceneNegativeOff(request.sceneId)) return request
+  const pairs = getFragmentNegatives()
+  if (Object.keys(pairs).length === 0) return request
+  const { folders, items } = listFragments()
+  const prompts = [
+    ...(request.promptParts
+      ? [request.promptParts.base, request.promptParts.additional, request.promptParts.detail]
+      : [request.prompt]),
+    ...request.characterPrompts.map((c) => c.prompt)
+  ]
+  const paired = pairedNegatives(prompts, request.negativePrompt, items, folders, pairs)
+  if (paired.length === 0) return request
+  return {
+    ...request,
+    negativePrompt: withPairedNegatives(request.negativePrompt, paired, items, folders)
+  }
+}
diff --git a/src/main/custom/fragment-request.ts b/src/main/custom/fragment-request.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4893cf1d4f6346ee57b33ab986dd5493bc0e9927
--- /dev/null
+++ b/src/main/custom/fragment-request.ts
@@ -0,0 +1,134 @@
+import { normalizeFragmentPath } from '../../shared/fragment-path'
+import type { FragmentRequestItem, FragmentRequestOutcome } from '../../shared/types'
+import {
+  createFragment,
+  createFragmentFolder,
+  listFragments,
+  updateFragment
+} from '../fragments/repo'
+import { t } from '../i18n'
+import { getFragmentNegatives, setFragmentNegative } from './fragment-negatives'
+
+/**
+ * [custom] 감시 폴더의 `조각 고치기` 요청 — Claude가 조각(프롬프트의 `<이름>`)을 읽고 고친다.
+ *
+ * ```json
+ * { "action": "fragments",
+ *   "set": [{ "name": "초아 얼굴", "content": "blue eyes, ...", "folder": "윤초아" }],
+ *   "read": true }
+ * ```
+ * - set: 같은 이름(대소문자 무시)의 조각이 있으면 내용을 바꾸고, 없으면 새로 만든다.
+ *   content는 글자 또는 줄 배열. folder는 새로 만들 때 넣을 폴더 이름(없으면 만든다) — 있는 조각의
+ *   폴더는 옮기지 않는다. 조각을 지우거나 이름을 바꾸지는 않는다.
+ *   negative: 네거 짝으로 삼을 조각 이름 (null이면 짝을 없앤다, 칸이 없으면 그대로) — 프롬프트에
+ *   이 조각이 있으면 뽑을 때 네거 짝이 네거티브에 자동으로 붙는다.
+ * - read: true = 조각 전부, ["이름", ...] = 그 조각만, 없으면 set에 적은 조각만 — 결과 파일의
+ *   `fragmentItems`에 지금 내용이 담긴다 (고친 뒤의 내용).
+ */
+export interface FragmentRequest {
+  /** negative: undefined = 그대로, null = 짝 없애기, 이름 = 그 조각을 네거 짝으로 */
+  set: { name: string; content: string; folder: string | null; negative?: string | null }[]
+  read: true | string[] | null
+}
+
+/** 이 요청이 아니면 null, 잘못 적혔으면 알림 문구 */
+export function parseFragmentRequest(
+  body: Record<string, unknown>
+): FragmentRequest | string | null {
+  if (body.action !== 'fragments') return null
+  const set: FragmentRequest['set'] = []
+  if (body.set !== undefined) {
+    if (!Array.isArray(body.set)) return t('ui.customRequestFragmentsBadSet')
+    for (const raw of body.set as unknown[]) {
+      const item = raw as Record<string, unknown> | null
+      const name = typeof item?.name === 'string' ? item.name.trim() : ''
+      const content = Array.isArray(item?.content)
+        ? item.content.filter((l): l is string => typeof l === 'string').join('\n')
+        : item?.content
+      if (!name || typeof content !== 'string') return t('ui.customRequestFragmentsBadSet')
+      set.push({
+        name,
+        content,
+        folder: typeof item?.folder === 'string' && item.folder.trim() ? item.folder.trim() : null,
+        ...(item?.negative === null
+          ? { negative: null }
+          : typeof item?.negative === 'string' && item.negative.trim()
+            ? { negative: item.negative.trim() }
+            : {})
+      })
+    }
+  }
+  const read =
+    body.read === true
+      ? true
+      : Array.isArray(body.read)
+        ? body.read.filter((n): n is string => typeof n === 'string' && n.trim() !== '')
+        : null
+  if (set.length === 0 && read === null) return t('ui.customRequestFragmentsEmpty')
+  return { set, read }
+}
+
+/** 요청대로 조각을 고치고, 읽어 달라는 조각의 지금 내용을 돌려준다 */
+export function runFragmentRequest(request: FragmentRequest): {
+  outcome: FragmentRequestOutcome
+  items: FragmentRequestItem[]
+} {
+  const outcome: FragmentRequestOutcome = { created: 0, updated: 0, unchanged: 0, missing: [] }
+  const key = normalizeFragmentPath
+  const before = listFragments()
+  const byName = new Map(before.items.map((f) => [key(f.name), f]))
+  const folderIds = new Map(before.folders.map((f) => [key(f.name), f.id]))
+  for (const item of request.set) {
+    const existing = byName.get(key(item.name))
+    if (existing) {
+      if (existing.content === item.content) outcome.unchanged++
+      else {
+        updateFragment(existing.id, { content: item.content })
+        existing.content = item.content
+        outcome.updated++
+      }
+      continue
+    }
+    let folderId: number | null = null
+    if (item.folder) {
+      folderId = folderIds.get(key(item.folder)) ?? createFragmentFolder(item.folder)
+      folderIds.set(key(item.folder), folderId)
+    }
+    const id = createFragment(item.name, folderId, item.content)
+    byName.set(key(item.name), { id, name: item.name, content: item.content, folderId })
+    outcome.created++
+  }
+
+  // 네거 짝 — 조각을 다 만든 뒤에 맞춘다 (같은 요청에서 만든 네거 조각을 짝으로 삼을 수 있게)
+  for (const item of request.set) {
+    if (item.negative === undefined) continue
+    const self = byName.get(key(item.name))
+    const pair = item.negative === null ? null : byName.get(key(item.negative))
+    if (!self) continue
+    if (item.negative !== null && !pair) outcome.missing.push(item.negative)
+    else setFragmentNegative(self.id, pair?.id ?? null)
+  }
+
+  const after = listFragments()
+  const pairs = getFragmentNegatives()
+  const nameById = new Map(after.items.map((f) => [f.id, f.name]))
+  const folderName = new Map(after.folders.map((f) => [f.id, f.name]))
+  const all = new Map(after.items.map((f) => [key(f.name), f]))
+  const wanted =
+    request.read === true
+      ? after.items
+      : (request.read ?? request.set.map((s) => s.name)).flatMap((name) => {
+          const found = all.get(key(name))
+          if (!found) outcome.missing.push(name)
+          return found ? [found] : []
+        })
+  const items = [...new Set(wanted)].map((f) => ({
+    name: f.name,
+    content: f.content,
+    ...(f.folderId != null && folderName.has(f.folderId)
+      ? { folder: folderName.get(f.folderId) as string }
+      : {}),
+    ...(nameById.has(pairs[f.id]) ? { negative: nameById.get(pairs[f.id]) as string } : {})
+  }))
+  return { outcome, items }
+}
diff --git a/src/main/custom/parallel.ts b/src/main/custom/parallel.ts
new file mode 100644
index 0000000000000000000000000000000000000000..de1e23d4305cebb7cccc75c48135bf8ca658afbb
--- /dev/null
+++ b/src/main/custom/parallel.ts
@@ -0,0 +1,132 @@
+import type { GenerationRequest, ParallelConfig } from '../../shared/types'
+import { getActiveNaiAccount, getNaiAccounts, getSetting, setSetting } from '../db/settings'
+import {
+  isOpusUsageExhausted,
+  requestUsesV5Usage,
+  type NaiAccountSelection
+} from '../nai/account-router'
+import { requestCharge } from '../nai/anlas-guard'
+import { logBalance } from '../nai/anlas-log'
+import { fetchAnlasBalance } from '../nai/client'
+import { LanePauseError } from '../queue/generation-queue'
+import { broadcast } from '../ipc'
+
+/**
+ * [custom] 여러 계정으로 동시 생성 — 계정(레인)마다 한 장씩.
+ * 켜는 스위치와 '보낼 곳'은 설정에 두고, 큐는 여기 함수로 계정 목록과 보낼 곳을 읽는다.
+ * 원칙: 동시 생성은 Opus 계정만, 게이지가 바닥난 계정은 Anlas를 쓰지 않고 쉰다.
+ * 'Anlas로 계속'을 켜면 게이지가 바닥난 계정도 그 계정의 Anlas로 이어서 뽑는다 (모자라면 쉰다).
+ */
+const ENABLED_KEY = 'custom_parallel_accounts'
+const TARGET_KEY = 'custom_parallel_target'
+const ANLAS_FALLBACK_KEY = 'custom_parallel_anlas_fallback'
+
+/** 쉬는 시간 — 게이지는 몇 분 안에 다시 차오르고, Opus 아닌 계정은 구독이 바뀔 때까지 */
+const PAUSE_MS = {
+  exhausted: 60_000,
+  noAnlas: 60_000,
+  notOpus: 5 * 60_000,
+  unknown: 30_000
+} as const
+
+export function getParallelConfig(): ParallelConfig {
+  return {
+    enabled: getSetting(ENABLED_KEY) === '1',
+    target: getSetting(TARGET_KEY) || null,
+    anlasFallback: getSetting(ANLAS_FALLBACK_KEY) === '1'
+  }
+}
+
+export function setParallelConfig(patch: Partial<ParallelConfig>): ParallelConfig {
+  if (patch.enabled !== undefined) setSetting(ENABLED_KEY, patch.enabled ? '1' : '0')
+  if (patch.target !== undefined) setSetting(TARGET_KEY, patch.target ?? '')
+  if (patch.anlasFallback !== undefined)
+    setSetting(ANLAS_FALLBACK_KEY, patch.anlasFallback ? '1' : '0')
+  return getParallelConfig()
+}
+
+/** 큐가 쓸 계정 목록 — 꺼져 있으면 null (큐는 2개 미만이면 원래대로 한 장씩) */
+export function parallelLanes(): string[] | null {
+  if (getSetting(ENABLED_KEY) !== '1') return null
+  return getNaiAccounts().map((account) => account.id)
+}
+
+export function parallelTarget(): string | null {
+  return getSetting(TARGET_KEY) || null
+}
+
+type Balance = Awaited<ReturnType<typeof fetchAnlasBalance>>
+
+/** 계정별 잔액을 화면에 알린다. 활성 계정이면 상단 잔액 표시도 갱신 */
+function announce(accountId: string, balance: Balance): void {
+  broadcast('custom:laneBalance', {
+    accountId,
+    anlas: balance.anlas,
+    tier: balance.tier,
+    ...(balance.usage ? { usage: balance.usage } : {})
+  })
+  if (balance.anlas !== null && getActiveNaiAccount()?.id === accountId) {
+    broadcast('anlas:balance', {
+      anlas: balance.anlas,
+      tier: balance.tier,
+      ...(balance.usage ? { usage: balance.usage } : {})
+    })
+  }
+}
+
+/**
+ * 이 계정이 지금 이 요청을 뽑아도 되는지 확인하고 그 계정을 준다 (원본 계정 선택과 같은 모양).
+ * 안 되면 LanePauseError — 큐가 그 계정을 쉬게 하고 항목은 다른 계정에 넘긴다.
+ * 잔액은 장마다 새로 묻는다 (원본도 계정이 둘 이상이면 V5 생성 전마다 묻는다) — 묵은 값으로
+ * 게이지가 바닥난 줄 모르고 뽑아 Anlas가 나가는 일을 막는다.
+ */
+export async function laneSelection(
+  accountId: string,
+  request: GenerationRequest
+): Promise<NaiAccountSelection> {
+  const account = getNaiAccounts().find((a) => a.id === accountId)
+  if (!account) throw new LanePauseError('unknown', PAUSE_MS.unknown)
+  const balance = await fetchAnlasBalance(account.token)
+  // 조회 실패는 화면의 마지막 값을 지우지 않는다
+  if (balance.tier == null) throw new LanePauseError('unknown', PAUSE_MS.unknown)
+  announce(accountId, balance)
+  if (balance.tier !== 'opus') throw new LanePauseError('notOpus', PAUSE_MS.notOpus)
+  if (requestUsesV5Usage(request)) {
+    // 게이지를 모르면 뽑지 않는다 (원본 자동 전환도 게이지를 모르는 계정은 고르지 않는다)
+    if (!balance.usage) throw new LanePauseError('unknown', PAUSE_MS.unknown)
+    if (isOpusUsageExhausted(balance)) {
+      if (getSetting(ANLAS_FALLBACK_KEY) !== '1')
+        throw new LanePauseError('exhausted', PAUSE_MS.exhausted)
+      // Anlas로 계속: 이 장 값이 남아 있을 때만 (모자라면 게이지가 찰 때까지 쉰다)
+      const { cost } = requestCharge(request, balance)
+      if (balance.anlas == null || balance.anlas < cost)
+        throw new LanePauseError('noAnlas', PAUSE_MS.noAnlas)
+    }
+  }
+  return { account, balance, rotated: false }
+}
+
+/** 계정별로 마지막에 기록한 잔액 — 그대로면 다시 기록하지 않는다 */
+const lastLogged = new Map<string, { anlas: number; day: string }>()
+
+/**
+ * 사용량 기록은 계정별로 남긴다 (원본 기록은 계정이 바뀐 행을 경계로 나눠 센다).
+ * 동시 생성은 계정이 번갈아 끝나서 매번 기록하면 경계가 계속 쌓이므로, 잔액이 그대로면 건너뛴다.
+ * 그날 첫 잔액은 오늘의 기준점이라 남긴다.
+ */
+function logLaneBalance(accountId: string, anlas: number): void {
+  const day = new Date().toDateString()
+  const previous = lastLogged.get(accountId)
+  if (previous && previous.anlas === anlas && previous.day === day) return
+  lastLogged.set(accountId, { anlas, day })
+  logBalance(anlas, accountId)
+}
+
+/** 생성이 끝난 뒤 잔액 갱신 (실패해도 생성 흐름엔 영향 없음) */
+export function refreshLaneBalance(accountId: string, token: string): void {
+  void fetchAnlasBalance(token).then((balance) => {
+    if (balance.tier == null) return
+    announce(accountId, balance)
+    if (balance.anlas !== null) logLaneBalance(accountId, balance.anlas)
+  })
+}
diff --git a/src/main/custom/preset-folders.ts b/src/main/custom/preset-folders.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ffb7d9c7be3d44c6eb41a2f1f04f68d307bb7cd7
--- /dev/null
+++ b/src/main/custom/preset-folders.ts
@@ -0,0 +1,58 @@
+import { getDb } from '../db'
+
+/**
+ * [custom] 씬 프리셋 폴더 — 프리셋 목록이 길어질 때 묶어 보는 용도.
+ * 폴더는 프리셋에 붙는 이름표일 뿐이다 (같은 이름표끼리 목록에서 한 묶음으로 보인다).
+ * 순서는 프리셋 순서를 그대로 쓴다. 지워진 프리셋의 이름표는 읽을 때 걸러 내고 치운다.
+ */
+function foldersDb(): ReturnType<typeof getDb> {
+  const db = getDb()
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS custom_preset_folders (
+      preset_id INTEGER PRIMARY KEY,
+      folder TEXT NOT NULL
+    )
+  `)
+  return db
+}
+
+const FOLDER_MAX = 60
+export const cleanFolderName = (name: string): string =>
+  name.replace(/\s+/g, ' ').trim().slice(0, FOLDER_MAX)
+
+/** 프리셋 id → 폴더 이름 */
+export function getPresetFolders(): Record<number, string> {
+  const db = foldersDb()
+  db.exec('DELETE FROM custom_preset_folders WHERE preset_id NOT IN (SELECT id FROM scene_presets)')
+  const rows = db.prepare('SELECT preset_id, folder FROM custom_preset_folders').all() as {
+    preset_id: number
+    folder: string
+  }[]
+  return Object.fromEntries(rows.map((r) => [r.preset_id, r.folder]))
+}
+
+/** 프리셋들을 폴더에 넣는다. folder가 비었으면 폴더에서 뺀다 */
+export function setPresetFolder(presetIds: number[], folder: string | null): void {
+  const db = foldersDb()
+  const name = folder ? cleanFolderName(folder) : ''
+  const remove = db.prepare('DELETE FROM custom_preset_folders WHERE preset_id = ?')
+  const put = db.prepare(
+    `INSERT INTO custom_preset_folders (preset_id, folder) VALUES (?, ?)
+     ON CONFLICT(preset_id) DO UPDATE SET folder = excluded.folder`
+  )
+  db.transaction(() => {
+    for (const id of presetIds) {
+      if (name) put.run(id, name)
+      else remove.run(id)
+    }
+  })()
+}
+
+/** 폴더 이름 바꾸기 (이미 있는 이름이면 그 폴더와 합쳐진다) */
+export function renamePresetFolder(from: string, to: string): void {
+  const name = cleanFolderName(to)
+  if (!name) return
+  foldersDb()
+    .prepare('UPDATE custom_preset_folders SET folder = ? WHERE folder = ?')
+    .run(name, from)
+}
diff --git a/src/main/custom/top-set.ts b/src/main/custom/top-set.ts
new file mode 100644
index 0000000000000000000000000000000000000000..24c95625f75c8a73caab59128c580cd6bb7c49e2
--- /dev/null
+++ b/src/main/custom/top-set.ts
@@ -0,0 +1,413 @@
+import { copyFileSync, mkdirSync, readFileSync, statSync, writeFileSync } from 'fs'
+import { dirname, extname, isAbsolute, join, resolve } from 'path'
+import { WATCH_AUTOGEN_KEY } from '../../shared/custom-watch'
+import type { FragmentRequestItem, TopSetResult, WatchRequestEvent } from '../../shared/types'
+import { getSetting, setSetting } from '../db/settings'
+import { t } from '../i18n'
+import { getMemoryImage, isMemoryPath } from '../images/storage'
+import { getPresetName, listPresets, listScenes, sortPresetScenesByNumber } from '../scenes/repo'
+import { parseFragmentRequest, runFragmentRequest } from './fragment-request'
+import sharp from '../sharp'
+
+/**
+ * [custom] 대표 세트 받기 — 프리셋의 씬마다 카드에 보이는 대표 이미지(최신 즐겨찾기, 없으면 최신)를
+ * 한 장씩 폴더에 복사한다. 파일 이름은 씬 이름.
+ *
+ * - 똑같은 그림이 이미 있으면 건너뛴다.
+ * - 같은 이름의 다른 그림이 있으면 그 파일을 휴지통으로 보내고 새 그림을 넣는다 (되살릴 수 있게).
+ * - 폴더에 있던 다른 파일은 건드리지 않는다.
+ *
+ * 받는 형식을 `webp`(줄여서 받기)로 두면 PNG 그림을 WebP로 바꿔 받는다 (용량이 훨씬 작다. 원본 파일은 그대로).
+ * 그때 폴더에 같은 이름의 `.png`가 남아 있으면 휴지통으로 보낸다 (두 벌이 남지 않게).
+ *
+ * 한 번 누르기: 기본 폴더 안의 `<프리셋 이름>` 폴더로 받는다. 감시 폴더에 요청 파일
+ * (`*.request.json`)을 넣어도 받을 수 있다 — Claude가 원하는 폴더로 받아 줄 때 쓴다.
+ */
+
+const DIR_KEY = 'custom_topset_dir'
+const FORMAT_KEY = 'custom_topset_format'
+const MAX_NAME = 120
+/** 줄여서 받기의 WebP 품질 — 원래 크기로 보면 구분하기 어려운 선에서 용량을 1/5 안팎으로 */
+const WEBP_QUALITY = 85
+
+/** 받는 형식 — original = 원본 그대로, webp = 줄여서 */
+export type TopSetFormat = 'original' | 'webp'
+
+export function getTopSetFormat(): TopSetFormat {
+  return getSetting(FORMAT_KEY) === 'webp' ? 'webp' : 'original'
+}
+
+export function setTopSetFormat(format: TopSetFormat): void {
+  setSetting(FORMAT_KEY, format === 'webp' ? 'webp' : 'original')
+}
+
+export function getTopSetDir(): string {
+  return getSetting(DIR_KEY) ?? ''
+}
+
+export function setTopSetDir(dir: string): void {
+  setSetting(DIR_KEY, dir)
+}
+
+/** Windows에서 쓸 수 없는 글자·이름을 피한 파일·폴더 이름 */
+export function safeFileName(name: string, fallback: string): string {
+  // eslint-disable-next-line no-control-regex -- 제어 문자도 파일 이름에 못 쓴다
+  let safe = name.normalize('NFC').replace(/[\u0000-\u001f<>:"/\\|?*]/g, '_')
+  safe = safe
+    .trim()
+    .replace(/[. ]+$/, '')
+    .slice(0, MAX_NAME)
+    .trim()
+  if (!safe) safe = fallback
+  if (/^(con|prn|aux|nul|com\d|lpt\d)(\.|$)/i.test(safe)) safe = `_${safe}`
+  return safe
+}
+
+/** 기본 폴더 안의 이 프리셋 폴더 (기본 폴더를 아직 고르지 않았으면 null) */
+export function defaultTopSetDest(presetId: number): string | null {
+  const base = getTopSetDir()
+  const name = getPresetName(presetId)
+  if (!base || name == null) return null
+  return join(base, safeFileName(name, `preset-${presetId}`))
+}
+
+/**
+ * 줄인 그림 — WebP 품질 85. 같은 그림은 늘 같은 바이트가 나온다.
+ * 이미 작은 WebP라 줄여도 작아지지 않으면 원래 것을 그대로 돌려준다.
+ */
+export async function shrinkImage(image: Buffer): Promise<Buffer> {
+  const small = await sharp(image).webp({ quality: WEBP_QUALITY, effort: 4 }).toBuffer()
+  const isWebp = image.subarray(0, 4).toString('latin1') === 'RIFF'
+  return isWebp && small.length >= image.length ? image : small
+}
+
+interface TopSetFile {
+  name: string
+  /** 줄여서 받을 때, 전에 원본으로 받아 둔 같은 이름의 PNG — 있으면 치운다 */
+  sibling: string | null
+  source: string
+  /** WebP로 바꿔 받는다 */
+  convert: boolean
+  pending: boolean
+}
+
+/** 받을 그림 목록 — 프리셋의 씬 순서대로, 이름이 겹치면 (2)·(3) (Windows는 대소문자를 가리지 않는다) */
+function topSetFiles(
+  presetId: number,
+  format: TopSetFormat
+): { files: TopSetFile[]; noImage: number } {
+  const used = new Set<string>()
+  const files: TopSetFile[] = []
+  let noImage = 0
+  for (const scene of listScenes(presetId)) {
+    if (!scene.thumbnailPath) {
+      noImage++
+      continue
+    }
+    const sourceExt = isMemoryPath(scene.thumbnailPath)
+      ? '.png'
+      : extname(scene.thumbnailPath).toLowerCase() || '.png'
+    // PNG도, 크게 저장된(무손실) WebP도 줄인다
+    const convert = format === 'webp' && (sourceExt === '.png' || sourceExt === '.webp')
+    const ext = convert ? '.webp' : sourceExt
+    const base = safeFileName(scene.name, `scene-${scene.id}`)
+    let name = `${base}${ext}`
+    let stem = base
+    for (let n = 2; used.has(name.toLowerCase()); n++) {
+      stem = `${base} (${n})`
+      name = `${stem}${ext}`
+    }
+    used.add(name.toLowerCase())
+    files.push({
+      name,
+      sibling: convert && sourceExt === '.png' ? `${stem}.png` : null,
+      source: scene.thumbnailPath,
+      convert,
+      pending: scene.pending === true
+    })
+  }
+  return { files, noImage }
+}
+
+function sameBytes(source: string, target: string): boolean {
+  if (statSync(source).size !== statSync(target).size) return false
+  return readFileSync(source).equals(readFileSync(target))
+}
+
+export interface TopSetDeps {
+  /** 바꿀 파일을 휴지통으로 — 기본은 Electron shell.trashItem */
+  trash?: (path: string) => Promise<void>
+  /** 받는 형식 — 없으면 저장된 설정 */
+  format?: TopSetFormat
+}
+
+async function trashItem(path: string): Promise<void> {
+  const { shell } = await import('electron')
+  await shell.trashItem(path)
+}
+
+/** 대표 세트를 dest 폴더에 받는다 (없으면 만든다) */
+export async function exportTopSet(
+  presetId: number,
+  dest: string,
+  { trash = trashItem, format = getTopSetFormat() }: TopSetDeps = {}
+): Promise<TopSetResult> {
+  const presetName = getPresetName(presetId)
+  if (presetName == null) throw new Error(t('ui.customTopSetPresetMissing'))
+  const { files, noImage } = topSetFiles(presetId, format)
+  mkdirSync(dest, { recursive: true })
+  const result: TopSetResult = {
+    presetId,
+    presetName,
+    dir: dest,
+    total: files.length,
+    written: 0,
+    replaced: 0,
+    same: 0,
+    failed: 0,
+    noImage,
+    pending: files.filter((f) => f.pending).length
+  }
+  for (const file of files) {
+    const target = join(dest, file.name)
+    try {
+      let memory = isMemoryPath(file.source) ? getMemoryImage(file.source) : null
+      if (isMemoryPath(file.source) && !memory) throw new Error('expired')
+      // 줄여서 받기 — 같은 그림은 늘 같은 바이트가 나와, 아래의 '똑같으면 건너뛰기'가 그대로 통한다
+      if (file.convert) memory = await shrinkImage(memory ?? readFileSync(file.source))
+      let exists = false
+      try {
+        const st = statSync(target)
+        if (!st.isFile()) throw new Error('not a file') // 같은 이름 폴더는 건드리지 않는다
+        exists = true
+      } catch (e) {
+        if ((e as NodeJS.ErrnoException).code !== 'ENOENT') throw e
+      }
+      if (exists) {
+        const same = memory ? readFileSync(target).equals(memory) : sameBytes(file.source, target)
+        if (same) {
+          result.same++
+          continue
+        }
+        // 여기까지 왔으면 원본을 읽을 수 있다 (없으면 위에서 실패로 끝나 옛 그림은 그대로)
+        await trash(target)
+      }
+      if (memory) writeFileSync(target, memory)
+      else copyFileSync(file.source, target)
+      // 줄여서 받았으면 전에 원본으로 받아 둔 같은 이름의 PNG는 휴지통으로 (두 벌이 남지 않게)
+      if (file.sibling) {
+        const old = join(dest, file.sibling)
+        try {
+          if (statSync(old).isFile()) {
+            await trash(old)
+            exists = true
+          }
+        } catch {
+          // 없으면 그만
+        }
+      }
+      if (exists) result.replaced++
+      else result.written++
+    } catch {
+      result.failed++
+    }
+  }
+  return result
+}
+
+// ── 감시 폴더 요청 파일 ─────────────────────────────────────────
+
+const REQUEST_SUFFIX = '.request.json'
+const RESULT_SUFFIX = '.result.json'
+
+export const isWatchRequestFile = (file: string): boolean =>
+  file.toLowerCase().endsWith(REQUEST_SUFFIX)
+export const isWatchResultFile = (file: string): boolean =>
+  file.toLowerCase().endsWith(RESULT_SUFFIX)
+
+interface TopSetRequest {
+  presets: string[]
+  to: string | null
+  subfolders: boolean | null
+  /** 이 요청만 이 형식으로 (없으면 저장된 설정) */
+  format: TopSetFormat | null
+}
+
+/** 요청 파일을 JSON 객체로 읽는다 — 읽을 수 없으면 알림 문구 */
+function requestBody(raw: string): Record<string, unknown> | string {
+  let data: unknown
+  try {
+    data = JSON.parse(raw.replace(/^\uFEFF/, ''))
+  } catch {
+    return t('ui.customRequestBadJson')
+  }
+  if (typeof data !== 'object' || data === null || Array.isArray(data))
+    return t('ui.customRequestBadJson')
+  return data as Record<string, unknown>
+}
+
+/**
+ * 불러온 씬 자동 생성 켜기·끄기 요청: `{ "action": "autoGenerate", "enabled": true | false }`.
+ * 이 요청이 아니면 null, enabled가 true·false가 아니면 알림 문구.
+ */
+export function parseAutoGenerateRequest(raw: string): boolean | string | null {
+  const body = requestBody(raw)
+  if (typeof body === 'string' || body.action !== 'autoGenerate') return null
+  return typeof body.enabled === 'boolean' ? body.enabled : t('ui.customRequestAutoGenEnabled')
+}
+
+/**
+ * 요청 파일 내용:
+ * `{ "action": "exportTopSet", "preset": "이름" | "presets": ["이름", ...], "to": "폴더", "subfolders": true }`
+ * - to가 없으면 기본 폴더 안 프리셋 이름 폴더로 (한 번 누르기와 같다). 상대 경로는 요청 파일 기준.
+ * - format: "webp" = 줄여서 받기, "original" = 원본 그대로. 없으면 버튼에서 고른 형식.
+ * - to가 있으면 프리셋이 하나일 때 그 폴더에 바로, 여럿이면 그 안에 프리셋 이름 폴더로 (subfolders로 바꿀 수 있다).
+ */
+export function parseTopSetRequest(raw: string): TopSetRequest | string {
+  const body = requestBody(raw)
+  if (typeof body === 'string') return body
+  if (body.action !== 'exportTopSet') return t('ui.customRequestUnknownAction')
+  const names = [
+    ...(typeof body.preset === 'string' ? [body.preset] : []),
+    ...(Array.isArray(body.presets) ? body.presets : [])
+  ]
+    .filter((n): n is string => typeof n === 'string' && n.trim() !== '')
+    .map((n) => n.trim())
+  if (names.length === 0) return t('ui.customRequestNoPreset')
+  return {
+    presets: [...new Set(names)],
+    to: typeof body.to === 'string' && body.to.trim() ? body.to.trim() : null,
+    subfolders: typeof body.subfolders === 'boolean' ? body.subfolders : null,
+    format: body.format === 'webp' || body.format === 'original' ? body.format : null
+  }
+}
+
+const norm = (s: string): string => s.normalize('NFC').trim().toLowerCase()
+
+/**
+ * 감시 폴더의 요청 파일 하나를 처리하고, 옆에 결과 파일(`*.result.json`)을 남긴다.
+ * file은 감시 폴더 기준 상대 경로(`/` 구분)
+ */
+export async function runWatchRequest(
+  dir: string,
+  file: string,
+  deps: TopSetDeps = {}
+): Promise<WatchRequestEvent> {
+  const path = join(dir, file)
+  const event: WatchRequestEvent = { file, ok: false, exports: [], errors: [] }
+  let raw = ''
+  try {
+    raw = readFileSync(path, 'utf-8')
+  } catch {
+    event.errors.push(t('ui.customWatchReadError'))
+  }
+  const autoGenerate = raw ? parseAutoGenerateRequest(raw) : null
+  if (typeof autoGenerate === 'string') event.errors.push(autoGenerate)
+  else if (autoGenerate !== null) {
+    // 설정 > 저장의 스위치·타이틀바 `자동 생성` 버튼과 같은 값 — 화면은 알림을 받고 맞춘다
+    setSetting(WATCH_AUTOGEN_KEY, autoGenerate ? '1' : '0')
+    event.autoGenerate = autoGenerate
+  }
+  // 조각 고치기·읽기 — 조각 내용은 결과 파일에만 담는다 (화면 알림에는 수만)
+  const body = raw && autoGenerate === null ? requestBody(raw) : null
+  const fragments = body && typeof body !== 'string' ? parseFragmentRequest(body) : null
+  let fragmentItems: FragmentRequestItem[] | undefined
+  if (typeof fragments === 'string') event.errors.push(fragments)
+  else if (fragments) {
+    try {
+      const done = runFragmentRequest(fragments)
+      event.fragments = done.outcome
+      fragmentItems = done.items
+    } catch (e) {
+      event.errors.push(e instanceof Error ? e.message : String(e))
+    }
+  }
+  // 씬 번호순 정렬 — { "action": "sortScenes", "preset": "이름" } (또는 "presets": [...])
+  const sorting = body && typeof body !== 'string' && body.action === 'sortScenes'
+  if (sorting && body && typeof body !== 'string') {
+    const names = [
+      ...(typeof body.preset === 'string' ? [body.preset] : []),
+      ...(Array.isArray(body.presets) ? body.presets : [])
+    ]
+      .filter((n): n is string => typeof n === 'string')
+      .map((n) => n.trim())
+      .filter(Boolean)
+    if (names.length === 0) event.errors.push(t('ui.customRequestNoPreset'))
+    const presets = listPresets()
+    event.sorted = []
+    for (const name of new Set(names)) {
+      const preset =
+        presets.find((p) => p.name.trim() === name) ??
+        presets.find((p) => norm(p.name) === norm(name))
+      if (!preset) {
+        event.errors.push(t('ui.customRequestPresetNotFoundValue', name))
+        continue
+      }
+      event.sorted.push({
+        presetId: preset.id,
+        preset: preset.name,
+        ...sortPresetScenesByNumber(preset.id)
+      })
+    }
+  }
+  const request =
+    raw && autoGenerate === null && fragments === null && !sorting ? parseTopSetRequest(raw) : null
+  if (typeof request === 'string') event.errors.push(request)
+  else if (request) {
+    const presets = listPresets()
+    const subfolders = request.subfolders ?? request.presets.length > 1
+    const base = request.to
+      ? isAbsolute(request.to)
+        ? request.to
+        : resolve(dirname(path), request.to)
+      : getTopSetDir()
+    for (const name of request.presets) {
+      const preset =
+        presets.find((p) => p.name.trim() === name) ??
+        presets.find((p) => norm(p.name) === norm(name))
+      if (!preset) {
+        event.errors.push(t('ui.customRequestPresetNotFoundValue', name))
+        continue
+      }
+      if (!base) {
+        event.errors.push(t('ui.customTopSetNoDefaultDir'))
+        break
+      }
+      const dest =
+        !request.to || subfolders
+          ? join(base, safeFileName(preset.name, `preset-${preset.id}`))
+          : base
+      try {
+        event.exports.push(
+          await exportTopSet(
+            preset.id,
+            dest,
+            request.format ? { ...deps, format: request.format } : deps
+          )
+        )
+      } catch (e) {
+        event.errors.push(`${preset.name}: ${e instanceof Error ? e.message : String(e)}`)
+      }
+    }
+  }
+  event.ok = event.errors.length === 0 && event.exports.every((r) => r.failed === 0)
+  try {
+    const out = path.slice(0, path.length - REQUEST_SUFFIX.length) + RESULT_SUFFIX
+    writeFileSync(
+      out,
+      JSON.stringify(
+        {
+          ...event,
+          ...(fragmentItems ? { fragmentItems } : {}),
+          finishedAt: new Date().toISOString()
+        },
+        null,
+        2
+      ) + '\n',
+      'utf-8'
+    )
+  } catch {
+    // 결과 파일을 못 써도 앱 알림은 간다
+  }
+  return event
+}
diff --git a/src/main/custom/watch-folder.ts b/src/main/custom/watch-folder.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cce04a9f6ee385be85157e5c10de59899c60ebcd
--- /dev/null
+++ b/src/main/custom/watch-folder.ts
@@ -0,0 +1,283 @@
+import { readFileSync, readdirSync, statSync } from 'fs'
+import { basename, extname, join } from 'path'
+import type { WatchFolderConfig, WatchFolderEvent, WatchFolderFailure } from '../../shared/types'
+import { getSetting, setSetting } from '../db/settings'
+import { parseSceneImport } from '../scenes/import-formats'
+import { applyImportedScenes, createPreset, listPresets } from '../scenes/repo'
+import { isWatchRequestFile, isWatchResultFile } from './top-set'
+
+/**
+ * [custom] 감시 폴더 — 지정한 폴더(하위 폴더 포함)에 씬 JSON이 새로 생기거나 바뀌면 자동으로 불러온다.
+ *
+ * - 보관 폴더를 그대로 감시한다: 파일을 옮기거나 지우거나 고치지 않는다.
+ * - 감시를 켠(또는 폴더를 고른) 시각 이후에 생기거나 수정된 파일만 불러온다. 원래 있던 파일(옛 버전
+ *   포함)은 건드리지 않는다. 처리한 파일은 크기·수정 시각을 기억해, 다시 바뀔 때까지 또 불러오지 않는다
+ *   (프로그램을 껐다 켜도 유지).
+ * - 불러오기는 파일 고르기와 같은 applyImportedScenes: 같은 이름 씬은 내용만 교체, 새 이름은 추가.
+ *   다만 새 씬은 끝이 아니라 번호 자리에 끼운다 ("25"는 24와 26 사이 — 있던 씬의 순서는 그대로).
+ *   prompt 칸이 없는 줄은 같은 이름 씬의 메모만 바꾼다(없는 씬은 건너뜀).
+ *   씬을 지우거나 이미지를 만들지는 않는다.
+ * - 프리셋 정하기: JSON 최상위 `preset` 이름(없으면 새로 만듦) → 없으면 파일 이름에 든 프리셋 이름.
+ *   파일 이름만으로는 프리셋을 새로 만들지 않는다.
+ * - fs.watch 대신 주기 확인: 동기화 폴더에서도 같게 동작하고, 쓰는 도중인 파일을 크기·수정 시각이
+ *   두 번 연속 같을 때까지 기다리기 쉽다.
+ * - `*.request.json`은 씬이 아니라 요청(대표 세트 받기, 자동 생성 켜기·끄기)으로 넘기고, 그 결과로 남기는
+ *   `*.result.json`은 읽지 않는다.
+ */
+
+const ENABLED_KEY = 'custom_watch_enabled'
+const DIR_KEY = 'custom_watch_dir'
+const SINCE_KEY = 'custom_watch_since'
+const DONE_KEY = 'custom_watch_done'
+const POLL_MS = 3000
+const MAX_BYTES = 20 * 1024 * 1024
+const MAX_DEPTH = 6
+/** 한 번 훑을 때 보는 폴더 수 상한 — 실수로 드라이브 전체를 골라도 멈추지 않게 */
+const MAX_DIRS = 3000
+const SKIP_DIRS = new Set(['node_modules', '$recycle.bin', 'system volume information'])
+
+export function getWatchFolderConfig(): WatchFolderConfig {
+  return { enabled: getSetting(ENABLED_KEY) === '1', dir: getSetting(DIR_KEY) ?? '' }
+}
+
+/** 기준 시각을 지금으로 — 이 시각 이전부터 있던 파일은 불러오지 않는다 */
+function rebase(now: number): void {
+  setSetting(SINCE_KEY, String(now))
+  setSetting(DONE_KEY, '{}')
+  seen.clear()
+  done = null
+}
+
+export function setWatchFolderEnabled(enabled: boolean, now = Date.now()): WatchFolderConfig {
+  const was = getSetting(ENABLED_KEY) === '1'
+  setSetting(ENABLED_KEY, enabled ? '1' : '0')
+  if (enabled && !was) rebase(now)
+  return getWatchFolderConfig()
+}
+
+export function setWatchFolderDir(dir: string, now = Date.now()): WatchFolderConfig {
+  setSetting(DIR_KEY, dir)
+  rebase(now)
+  return getWatchFolderConfig()
+}
+
+const norm = (s: string): string => s.normalize('NFC').trim().toLowerCase()
+const isWordChar = (ch: string | undefined): boolean => !!ch && /[\p{L}\p{N}]/u.test(ch)
+
+/**
+ * 파일 이름에 든 프리셋 이름으로 프리셋을 고른다. 이름 앞뒤가 글자·숫자가 아니어야 맞는 것으로 친다
+ * (`D1`이 `D10`에 걸리지 않게). 여러 개가 맞으면 가장 긴 이름, 그것도 여럿이면 고르지 않는다.
+ */
+export function pickPresetByFileName(
+  fileName: string,
+  presets: readonly { id: number; name: string }[]
+): { id: number; name: string } | 'none' | 'ambiguous' {
+  const base = norm(basename(fileName, extname(fileName)))
+  let best: { id: number; name: string }[] = []
+  let bestLength = 0
+  for (const preset of presets) {
+    const name = norm(preset.name)
+    if (!name || name.length < bestLength) continue
+    let at = base.indexOf(name)
+    let hit = false
+    while (at >= 0 && !hit) {
+      hit = !isWordChar(base[at - 1]) && !isWordChar(base[at + name.length])
+      at = base.indexOf(name, at + 1)
+    }
+    if (!hit) continue
+    if (name.length > bestLength) {
+      best = [preset]
+      bestLength = name.length
+    } else best.push(preset)
+  }
+  if (best.length === 0) return 'none'
+  return best.length === 1 ? best[0] : 'ambiguous'
+}
+
+function declaredPreset(raw: string): string | null {
+  try {
+    const data = JSON.parse(raw.replace(/^\uFEFF/, '')) as unknown
+    if (typeof data === 'object' && data !== null && !Array.isArray(data)) {
+      const value = (data as Record<string, unknown>).preset
+      if (typeof value === 'string' && value.trim()) return value.trim()
+    }
+  } catch {
+    // 형식 오류는 parseSceneImport가 판정한다
+  }
+  return null
+}
+
+/** 감시 폴더의 파일 하나를 불러온다. file은 감시 폴더 기준 상대 경로(`/` 구분) */
+export function importWatchFile(dir: string, file: string): WatchFolderEvent {
+  const fail = (reason: WatchFolderFailure): WatchFolderEvent => ({ file, ok: false, reason })
+  let raw: string
+  try {
+    const path = join(dir, file)
+    if (statSync(path).size > MAX_BYTES) return fail('tooLarge')
+    raw = readFileSync(path, 'utf-8')
+  } catch {
+    return fail('readError')
+  }
+  const scenes = parseSceneImport(raw)
+  if (!scenes) return fail('unrecognized')
+  if (scenes.length === 0) return fail('empty')
+
+  const presets = listPresets()
+  const declared = declaredPreset(raw)
+  let preset: { id: number; name: string }
+  let created = false
+  if (declared) {
+    const found =
+      presets.find((p) => p.name.trim() === declared) ??
+      presets.find((p) => norm(p.name) === norm(declared))
+    if (found) preset = found
+    else {
+      preset = { id: createPreset(declared), name: declared }
+      created = true
+    }
+  } else {
+    const picked = pickPresetByFileName(file, presets)
+    if (picked === 'none') return fail('noPreset')
+    if (picked === 'ambiguous') return fail('ambiguousPreset')
+    preset = picked
+  }
+
+  // 새 씬은 끝이 아니라 번호 자리에 끼운다 (이름이 번호로 시작하는 씬)
+  const outcome = applyImportedScenes(preset.id, scenes, { placeByNumber: true })
+  return {
+    file,
+    ok: true,
+    presetId: preset.id,
+    presetName: preset.name,
+    presetCreated: created,
+    ...outcome
+  }
+}
+
+interface Found {
+  /** 감시 폴더 기준 상대 경로 (`/` 구분) */
+  file: string
+  signature: string
+  /** 수정 시각과 만든 시각 중 늦은 쪽 — 복사해 넣은 파일은 수정 시각이 옛날 그대로라 만든 시각도 본다 */
+  touched: number
+}
+
+function listJson(dir: string): Found[] {
+  const out: Found[] = []
+  let dirs = 0
+  const walk = (rel: string, depth: number): void => {
+    if (++dirs > MAX_DIRS) return
+    let entries
+    try {
+      entries = readdirSync(join(dir, rel), { withFileTypes: true })
+    } catch {
+      return
+    }
+    for (const entry of entries) {
+      const child = rel ? `${rel}/${entry.name}` : entry.name
+      if (entry.isDirectory()) {
+        if (depth >= MAX_DEPTH || entry.name.startsWith('.')) continue
+        if (SKIP_DIRS.has(entry.name.toLowerCase())) continue
+        walk(child, depth + 1)
+      } else if (entry.isFile() && extname(entry.name).toLowerCase() === '.json') {
+        try {
+          const st = statSync(join(dir, child))
+          out.push({
+            file: child,
+            signature: `${st.size}:${Math.round(st.mtimeMs)}`,
+            touched: Math.max(st.mtimeMs, st.birthtimeMs || 0)
+          })
+        } catch {
+          // 방금 지워진 파일
+        }
+      }
+    }
+  }
+  walk('', 0)
+  return out.sort((a, b) => a.file.localeCompare(b.file))
+}
+
+/** 파일별 직전 확인 값 — 크기·수정 시각이 두 번 연속 같아야(다 써진 뒤) 처리한다 */
+const seen = new Map<string, string>()
+/** 처리한 파일의 크기·수정 시각 (설정에 저장) */
+let done: Record<string, string> | null = null
+
+function loadDone(): Record<string, string> {
+  if (done) return done
+  try {
+    const parsed = JSON.parse(getSetting(DONE_KEY) ?? '{}') as unknown
+    done =
+      typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed)
+        ? (parsed as Record<string, string>)
+        : {}
+  } catch {
+    done = {}
+  }
+  return done
+}
+
+/** 폴더를 한 번 훑어, 켠 뒤에 새로 생기거나 바뀐 .json을 불러온다 */
+export function scanWatchFolder(): WatchFolderEvent[] {
+  const { enabled, dir } = getWatchFolderConfig()
+  if (!enabled || !dir) return []
+  try {
+    if (!statSync(dir).isDirectory()) return []
+  } catch {
+    return [] // 폴더가 잠깐 안 보일 때(외장·동기화) 기록을 지우지 않는다
+  }
+  const since = Number(getSetting(SINCE_KEY) ?? 0) || 0
+  const processed = loadDone()
+  const found = listJson(dir)
+  const present = new Set(found.map((f) => f.file))
+  for (const key of seen.keys()) if (!present.has(key)) seen.delete(key)
+  let dirty = false
+  for (const key of Object.keys(processed)) {
+    if (!present.has(key)) {
+      delete processed[key]
+      dirty = true
+    }
+  }
+  const events: WatchFolderEvent[] = []
+  for (const { file, signature, touched } of found) {
+    if (isWatchResultFile(file)) continue
+    if (touched <= since || processed[file] === signature) continue
+    if (seen.get(file) !== signature) {
+      seen.set(file, signature)
+      continue
+    }
+    seen.delete(file)
+    if (isWatchRequestFile(file)) requestHandler?.(dir, file)
+    else events.push(importWatchFile(dir, file))
+    processed[file] = signature
+    dirty = true
+  }
+  if (dirty) setSetting(DONE_KEY, JSON.stringify(processed))
+  return events
+}
+
+let timer: ReturnType<typeof setInterval> | undefined
+/** 요청 파일(`*.request.json`)을 받을 곳 — 다 써진 요청마다 한 번 부른다 */
+let requestHandler: ((dir: string, file: string) => void) | undefined
+
+export function setWatchRequestHandler(handler?: (dir: string, file: string) => void): void {
+  requestHandler = handler
+}
+
+export function startWatchFolder(notify: (event: WatchFolderEvent) => void): void {
+  stopWatchFolder()
+  timer = setInterval(() => {
+    try {
+      for (const event of scanWatchFolder()) notify(event)
+    } catch (e) {
+      console.error('[custom] watch folder scan failed', e)
+    }
+  }, POLL_MS)
+  timer.unref?.()
+}
+
+export function stopWatchFolder(): void {
+  if (timer) clearInterval(timer)
+  timer = undefined
+  seen.clear()
+  done = null
+}

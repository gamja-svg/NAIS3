@@ -0,0 +1,69 @@
+// @vitest-environment happy-dom
+import { act, createElement as h } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { NaisApi } from '../src/preload/index'
+import { ChangedTagsNote } from '../src/renderer/src/components/custom-changed-tags'
+import { PromptEditor } from '../src/renderer/src/components/prompt-editor'
+import { changedTagRanges } from '../src/renderer/src/lib/custom-prompt-diff'
+import { useLanguageStore } from '../src/renderer/src/lib/i18n'
+
+// [custom] 미생성 씬 — 바뀐 태그 노란 칠과 빠진 태그 줄
+
+describe('custom: changed tag marks', () => {
+  let root: Root
+  let container: HTMLDivElement
+
+  beforeEach(() => {
+    vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT', true)
+    window.nais = {
+      invoke: vi.fn(async () => ({ counts: [0] })),
+      on: () => () => {}
+    } as unknown as NaisApi
+    useLanguageStore.setState({ lang: 'ko' })
+    container = document.createElement('div')
+    document.body.append(container)
+    root = createRoot(container)
+  })
+
+  afterEach(async () => {
+    await act(async () => root.unmount())
+    container.remove()
+    vi.unstubAllGlobals()
+  })
+
+  /** 노랗게 칠한 글자들 (가중치·찾기 층은 style에 노란 밑줄이 없다) */
+  const yellow = (): string[] =>
+    [...container.querySelectorAll('span')]
+      .filter((s) => s.getAttribute('style')?.includes('inset 0 -2px 0 rgb(234 179 8)'))
+      .map((s) => s.textContent ?? '')
+
+  it('paints the changed tags in the editor and nothing without marks', async () => {
+    const value = 'girl, grin, outdoors'
+    await act(async () =>
+      root.render(
+        h(PromptEditor, {
+          value,
+          onValueChange: () => {},
+          marks: changedTagRanges(value, 'girl, smile, outdoors')
+        })
+      )
+    )
+    expect(yellow()).toEqual(['grin'])
+    await act(async () => root.render(h(PromptEditor, { value, onValueChange: () => {} })))
+    expect(yellow()).toEqual([])
+  })
+
+  it('explains the yellow and lists removed tags under the editor', async () => {
+    await act(async () =>
+      root.render(h(ChangedTagsNote, { current: 'girl, grin', base: 'girl, smile, blush' }))
+    )
+    expect(container.textContent).toContain('노란색 = 마지막으로 뽑은 뒤 바뀐 태그')
+    expect([...container.querySelectorAll('s')].map((s) => s.textContent)).toEqual([
+      'smile',
+      'blush'
+    ])
+    await act(async () => root.render(h(ChangedTagsNote, { current: 'girl', base: 'girl' })))
+    expect(container.textContent).toBe('')
+  })
+})
diff --git a/tests/custom-prompt-diff.test.ts b/tests/custom-prompt-diff.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7bb5239beb20de7920500536ac5edbe2bc3e09e1
--- /dev/null
+++ b/tests/custom-prompt-diff.test.ts
@@ -0,0 +1,62 @@
+import { describe, expect, it } from 'vitest'
+import {
+  changedTagRanges,
+  markedSegments,
+  removedTags,
+  tagPieces
+} from '../src/renderer/src/lib/custom-prompt-diff'
+
+// [custom] 미생성 씬에서 마지막으로 뽑은 뒤 바뀐 태그 찾기
+
+const marked = (current: string, base: string): string[] =>
+  changedTagRanges(current, base).map((r) => current.slice(r.start, r.end))
+
+describe('custom: changed tags', () => {
+  it('splits on commas and line breaks, ignoring surrounding spaces', () => {
+    expect(tagPieces(' girl,  smile ,\nblue  eyes,, ').map((p) => p.text)).toEqual([
+      'girl',
+      'smile',
+      'blue  eyes'
+    ])
+  })
+
+  it('marks only tags that were not there before', () => {
+    expect(marked('girl, grin, blush, outdoors', 'girl, smile, outdoors')).toEqual([
+      'grin',
+      'blush'
+    ])
+    expect(marked('girl, smile', 'girl, smile')).toEqual([])
+    expect(marked('girl,smile', 'girl ,  smile')).toEqual([]) // 공백만 다르면 같다
+    expect(marked('blue  eyes', 'blue eyes')).toEqual([])
+  })
+
+  it('treats weight and bracket changes as changes', () => {
+    expect(marked('1.3::smile, happy::, {blush}', '1.2::smile, happy::, blush')).toEqual([
+      '1.3::smile',
+      '{blush}'
+    ])
+  })
+
+  it('counts repeated tags', () => {
+    expect(marked('smile, smile', 'smile')).toEqual(['smile'])
+    expect(removedTags('smile', 'smile, smile')).toEqual(['smile'])
+  })
+
+  it('lists removed tags in their old spelling', () => {
+    expect(removedTags('girl, grin', 'girl, smile, 1.2::blush::')).toEqual([
+      'smile',
+      '1.2::blush::'
+    ])
+  })
+
+  it('cuts the text into marked and plain segments that cover it all', () => {
+    const text = 'girl, grin, outdoors'
+    const segments = markedSegments(text, changedTagRanges(text, 'girl, outdoors'))
+    expect(segments.map((s) => [text.slice(s.start, s.end), s.marked])).toEqual([
+      ['girl, ', false],
+      ['grin', true],
+      [', outdoors', false]
+    ])
+    expect(segments.map((s) => text.slice(s.start, s.end)).join('')).toBe(text)
+  })
+})
diff --git a/tests/custom-scene-base.integration.ts b/tests/custom-scene-base.integration.ts
new file mode 100644
index 0000000000000000000000000000000000000000..79b8b0e7e916041dd70185ffae4977053d95357a
--- /dev/null
+++ b/tests/custom-scene-base.integration.ts
@@ -0,0 +1,120 @@
+import { mkdtempSync, rmSync, writeFileSync } from 'fs'
+import { tmpdir } from 'os'
+import { join } from 'path'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { closeDb, getDb, initDb } from '../src/main/db'
+import {
+  clearScenePending,
+  createPreset,
+  createScene,
+  getSceneBase,
+  importScenesJson,
+  updateScene
+} from '../src/main/scenes/repo'
+
+// [custom] 미생성 씬의 기준 내용 — 마지막으로 뽑았거나 확인한 때의 프롬프트 (바뀐 태그 표시용)
+const environment = vi.hoisted(() => ({ directory: '', importFile: '' }))
+vi.mock('electron', () => ({
+  app: { getPath: () => environment.directory, getLocale: () => 'ko' },
+  BrowserWindow: { getFocusedWindow: () => null, getAllWindows: () => [] },
+  dialog: {
+    showOpenDialog: async () => ({ canceled: false, filePaths: [environment.importFile] })
+  }
+}))
+
+beforeEach(() => {
+  environment.directory = mkdtempSync(join(tmpdir(), 'nais3-custom-base-'))
+  environment.importFile = join(environment.directory, 'scenes.json')
+  initDb()
+})
+afterEach(() => {
+  closeDb()
+  rmSync(environment.directory, { recursive: true, force: true })
+})
+
+/** 시간 경과 흉내 — 변경 시각과 이미지를 한 시간 과거로 민다 (SQLite 시각은 초 단위) */
+function passTime(): void {
+  const db = getDb()
+  db.exec("UPDATE custom_scene_marks SET changed_at = datetime(changed_at, '-1 hour')")
+  db.exec("UPDATE images SET created_at = datetime(created_at, '-1 hour')")
+}
+function generate(sceneId: number): void {
+  passTime()
+  getDb()
+    .prepare(
+      `INSERT INTO images (file_path, payload_json, kind, scene_id) VALUES (?, '{}', 'scene', ?)`
+    )
+    .run(join(environment.directory, `img-${sceneId}-${Math.random()}.png`), sceneId)
+}
+
+describe('custom: base content of a pending scene', () => {
+  it('keeps the content the last image was made from while the scene stays pending', () => {
+    const id = createScene(createPreset('p'), 'a')
+    updateScene(id, { prompt: 'girl, smile', negativePrompt: 'bad hands' })
+    generate(id)
+    expect(getSceneBase(id)).toBeNull() // 뽑은 그림과 내용이 같다
+
+    updateScene(id, { prompt: 'girl, grin' })
+    expect(getSceneBase(id)).toEqual({ prompt: 'girl, smile', negativePrompt: 'bad hands' })
+    updateScene(id, { prompt: 'girl, grin, blush', negativePrompt: 'bad hands, blurry' })
+    // 미생성인 동안 더 고쳐도 기준은 처음 그대로 — 바뀐 태그가 쌓여 보인다
+    expect(getSceneBase(id)).toEqual({ prompt: 'girl, smile', negativePrompt: 'bad hands' })
+
+    generate(id)
+    expect(getSceneBase(id)).toBeNull() // 다시 뽑으면 표시도 끝
+    updateScene(id, { prompt: 'girl' })
+    expect(getSceneBase(id)?.prompt).toBe('girl, grin, blush') // 새 기준 = 다시 뽑은 때 내용
+  })
+
+  it('has no base for a scene that was never generated', () => {
+    const id = createScene(createPreset('p'), 'a')
+    updateScene(id, { prompt: 'one' })
+    updateScene(id, { prompt: 'two' })
+    expect(getSceneBase(id)).toBeNull()
+  })
+
+  it('starts from the checked content after the mark was turned off by hand', () => {
+    const id = createScene(createPreset('p'), 'a')
+    updateScene(id, { prompt: 'one' })
+    generate(id)
+    updateScene(id, { prompt: 'two' })
+    clearScenePending(id)
+    expect(getSceneBase(id)).toBeNull()
+    updateScene(id, { prompt: 'three' })
+    expect(getSceneBase(id)?.prompt).toBe('two')
+  })
+
+  it('records the base when a scene JSON import changes a generated scene', async () => {
+    const preset = createPreset('p')
+    const id = createScene(preset, 'a')
+    updateScene(id, { prompt: 'old tags', negativePrompt: 'old neg' })
+    generate(id)
+    writeFileSync(
+      environment.importFile,
+      JSON.stringify({
+        version: 1,
+        scenes: [{ name: 'a', prompt: 'new tags', negativePrompt: 'old neg' }]
+      }),
+      'utf-8'
+    )
+    await importScenesJson(preset)
+    expect(getSceneBase(id)).toEqual({ prompt: 'old tags', negativePrompt: 'old neg' })
+  })
+
+  it('adds the base columns to a marks table made by an older version', () => {
+    closeDb()
+    initDb()
+    const db = getDb()
+    db.exec('DROP TABLE IF EXISTS custom_scene_marks')
+    db.exec(`CREATE TABLE custom_scene_marks (
+      scene_id INTEGER PRIMARY KEY, changed_at TEXT NOT NULL DEFAULT (datetime('now')),
+      acked INTEGER NOT NULL DEFAULT 0)`)
+    closeDb()
+    initDb() // 새 연결 → 처음 쓸 때 칸을 더한다
+    const id = createScene(createPreset('p'), 'a')
+    updateScene(id, { prompt: 'one' })
+    generate(id)
+    updateScene(id, { prompt: 'two' })
+    expect(getSceneBase(id)?.prompt).toBe('one')
+  })
+})

+  fragments: PairFragment[],
+  folders: { id: number; name: string }[]
+): string {
+  const same = fragments.filter(
+    (f) => normalizeFragmentPath(f.name) === normalizeFragmentPath(fragment.name)
+  )
+  const folder = folders.find((f) => f.id === fragment.folderId)?.name

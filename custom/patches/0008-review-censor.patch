+              width={session.width}
+              height={session.height}
+              className="pointer-events-none absolute inset-0 h-full w-full"
+            />
+          </div>
+        )}
+        {/* 붓 크기 고리 — 흰 그림·어두운 그림 어디서나 보이게 두 겹 */}
+        <div

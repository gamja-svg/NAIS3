+  generatingId,
+  pausedUntil: null,
+  pauseReason: null,
+  done: 0,
+  ...extra
+})
+
+function status(items: QueueItem[], lanes?: QueueLane[]): QueueStatus {
+  return {
+    items,
+    running: items.some((i) => i.state === 'pending' || i.state === 'generating'),
+    delayMs: 0,
+    ...(lanes ? { lanes } : {})
+  }

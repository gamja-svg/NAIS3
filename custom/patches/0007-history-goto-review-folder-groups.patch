+              title={t('ui.customAddFolderToGroup')}
+              onClick={() => actions.addFolder(group.id)}
+            >
+              <FolderPlus size={14} />
+            </Button>
+            <Popover>
+              <PopoverTrigger asChild>
+                <Button
+                  size="sm"
+                  variant="ghost"
+                  className="h-7 w-7 p-0"
+                  title={t('ui.folderColor')}
+                  onPointerDown={(e) => e.stopPropagation()}
+                >
+                  <Palette size={13} />
+                </Button>
+              </PopoverTrigger>
+              <PopoverContent className="w-auto p-1.5" onPointerDown={(e) => e.stopPropagation()}>
+                <div className="flex items-center gap-1">
+                  <button
+                    className="grid size-6 place-items-center rounded-md border border-line text-faint hover:text-ink"
+                    title={t('ui.noColor')}
+                    onClick={() => actions.setColor(group.id, null)}
+                  >
+                    <X size={13} />
+                  </button>
+                  {FOLDER_COLORS.map((c) => (
+                    <button
+                      key={c}
+                      className={cn(
+                        'size-6 rounded-md border transition-transform hover:scale-110',
+                        group.color === c ? 'border-ink' : 'border-transparent'
+                      )}
+                      style={{ backgroundColor: c }}
+                      onClick={() => actions.setColor(group.id, c)}
+                    />
+                  ))}
+                </div>
+              </PopoverContent>
+            </Popover>
+            <Button
+              size="sm"
+              variant="ghost"
+              className="h-7 w-7 p-0"
+              title={t('ui.rename.d3f4cb8')}
+              onClick={() => setEditing(true)}
+            >
+              <Pencil size={13} />
+            </Button>
+            <Button
+              size="sm"
+              variant="ghost"
+              className="h-7 w-7 p-0 hover:text-danger-ink"
+              title={t('ui.customDeleteFolderGroup')}
+              onClick={() => actions.remove(group.id)}
+            >
+              <Trash2 size={13} />
+            </Button>
+          </div>
+        </div>
+      </ContextMenuTrigger>
+      <ContextMenuContent>
+        <ContextMenuItem onSelect={() => actions.addFolder(group.id)}>
+          <FolderPlus size={13} /> {t('ui.customAddFolderToGroup')}
+        </ContextMenuItem>
+        <ContextMenuItem
+          onSelect={() => {
+            // 우클릭 메뉴가 닫힌 뒤 인라인 편집 시작
+            setTimeout(() => setEditing(true), 0)
+          }}
+        >
+          <Pencil size={13} /> {t('ui.rename')}
+        </ContextMenuItem>
+        <ContextMenuSeparator />
+        <ContextMenuItem danger onSelect={() => actions.remove(group.id)}>
+          <Trash2 size={13} /> {t('ui.customDeleteFolderGroup')}
+        </ContextMenuItem>
+      </ContextMenuContent>
+    </ContextMenu>
+  )
+}
+/* eslint-enable react-hooks/refs */
+
+/**
+ * [custom] 폴더 우클릭 메뉴의 '상위 폴더로 이동' — 메뉴를 열 때마다 최신 상위 폴더 목록을 읽는다
+ * (폴더 행은 memo라 다시 그려지지 않아도 이 부분은 스토어를 직접 구독한다)
+ */
+export function FolderGroupMenu({ folderId }: { folderId: number }): React.JSX.Element {
+  const t = useT()
+  const groups = useFolderGroupsStore((s) => s.groups)
+  const linked = useFolderGroupsStore((s) => s.links.get(folderId) ?? null)
+  const setFolderGroup = useFolderGroupsStore((s) => s.setFolderGroup)
+  const createGroup = useFolderGroupsStore((s) => s.createGroup)
+  const inGroup = groups.some((g) => g.id === linked) ? linked : null
+  return (
+    <>
+      <ContextMenuSub>
+        <ContextMenuSubTrigger>
+          <FolderInput size={13} /> {t('ui.customMoveToFolderGroup')}
+        </ContextMenuSubTrigger>
+        <ContextMenuSubContent>
+          {groups.map((g) => (
+            <ContextMenuItem
+              key={g.id}
+              disabled={g.id === inGroup}
+              onSelect={() => setFolderGroup(folderId, g.id)}
+            >
+              <Folders size={13} style={g.color ? { color: g.color } : undefined} />
+              <span className="min-w-0 flex-1 truncate">{g.name}</span>
+              {g.id === inGroup && <Check size={13} className="text-accent-ink" />}
+            </ContextMenuItem>
+          ))}
+          {groups.length > 0 && <ContextMenuSeparator />}
+          <ContextMenuItem onSelect={() => void createGroup(folderId)}>
+            <FolderPlus size={13} /> {t('ui.customNewFolderGroupWithFolder')}
+          </ContextMenuItem>
+        </ContextMenuSubContent>
+      </ContextMenuSub>
+      {inGroup != null && (
+        <ContextMenuItem onSelect={() => setFolderGroup(folderId, null)}>
+          <FolderOutput size={13} /> {t('ui.customRemoveFromFolderGroup')}
+        </ContextMenuItem>
+      )}
+    </>
+  )
+}
diff --git a/src/renderer/src/components/custom-scene-review.tsx b/src/renderer/src/components/custom-scene-review.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..65f83d694d9e63bd5effa2ec4690d3bbcf90aabc
--- /dev/null
+++ b/src/renderer/src/components/custom-scene-review.tsx
@@ -0,0 +1,221 @@
+import { ChevronLeft, ChevronRight, Download, Plus, X } from 'lucide-react'
+import { useEffect, useRef } from 'react'
+import { createPortal } from 'react-dom'
+import type { Scene } from '@shared/types'
+import { imageUrl } from '../lib/constants'
+import { useT } from '../lib/i18n'
+import { cn } from '../lib/utils'
+import { useScenesStore } from '../stores/scenes-store'
+import { toast } from '../stores/toast-store'
+import { ImageContextMenu } from './image-context-menu'
+
+/** 이만큼 가로로 끌면 넘긴 것으로 본다 (원격 접속의 터치는 마우스 드래그로 들어온다) */
+const SWIPE_PX = 60
+
+/**
+ * [custom] 검수 모드 — 프리셋의 씬 대표 이미지(카드에 보이는 그림)를 크게 한 장씩 넘겨 본다.
+ * ←/→·휠·스와이프·화면 버튼으로 넘기고, R로 그 씬을 다시 뽑기 예약(+1), Esc로 닫는다.
+ * 이미지가 없는 씬은 건너뛴다. 닫으면 마지막으로 본 씬 카드로 목록을 데려간다.
+ */
+export function SceneReview({ scenes }: { scenes: Scene[] }): React.JSX.Element | null {
+  const t = useT()
+  const reviewSceneId = useScenesStore((s) => s.reviewSceneId)
+  const setReviewScene = useScenesStore((s) => s.setReviewScene)
+  const adjustReserve = useScenesStore((s) => s.adjustReserve)
+  const presetName = useScenesStore(
+    (s) => s.presets.find((p) => p.id === s.activePresetId)?.name ?? ''
+  )
+
+  const list = scenes.filter((s) => s.thumbnailPath)
+  const index = list.findIndex((s) => s.id === reviewSceneId)
+  const scene = index >= 0 ? list[index] : undefined
+
+  const go = (i: number): void => {
+    const next = list[Math.min(list.length - 1, Math.max(0, i))]
+    if (next && next.id !== reviewSceneId) setReviewScene(next.id)
+  }
+  const close = (): void => {
+    useScenesStore.setState({ reviewSceneId: null, focusSceneId: scene?.id ?? null })
+  }
+  const queue = (): void => {
+    if (!scene) return
+    void adjustReserve(scene.id, 1)
+    toast(t('ui.customReviewQueuedValue', scene.name), 'success')
+  }
+  const save = (): void => {
+    if (!scene) return
+    void window.nais.invoke('images:saveAs', {
+      filePath: scene.thumbnailPath,
+      defaultName: scene.name
+    })
+  }
+
+  // 보던 씬이 목록에서 빠지면(씬·이미지 삭제) 닫는다
+  useEffect(() => {
+    if (index < 0) setReviewScene(null)
+  }, [index, setReviewScene])
+
+  // 키보드 — 다른 단축키보다 먼저 받아서, 처리한 키만 막는다
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent): void => {
+      if (e.ctrlKey || e.metaKey || e.altKey) return
+      if (e.key === 'Escape') close()
+      else if (e.key === 'ArrowLeft') go(index - 1)
+      else if (e.key === 'ArrowRight') go(index + 1)
+      else if (e.code === 'KeyR' && !e.repeat) queue()
+      else return
+      e.preventDefault()
+      e.stopPropagation()
+    }
+    window.addEventListener('keydown', onKey, true)
+    return () => window.removeEventListener('keydown', onKey, true)
+  })
+
+  // 휠로 이전/다음 — 트랙패드 관성으로 여러 장 튀지 않게 누적 임계값 + 쿨다운 (라이트박스와 같은 방식)
+  const overlayRef = useRef<HTMLDivElement | null>(null)
+  const wheel = useRef({ accum: 0, lockUntil: 0 })
+  useEffect(() => {
+    const el = overlayRef.current
+    if (!el) return
+    const onWheel = (e: WheelEvent): void => {
+      e.preventDefault()
+      const now = performance.now()
+      const w = wheel.current
+      if (now < w.lockUntil) return
+      w.accum += e.deltaY
+      if (Math.abs(w.accum) < 50) return
+      const dir = w.accum > 0 ? 1 : -1
+      w.accum = 0
+      w.lockUntil = now + 160
+      go(index + dir)
+    }
+    el.addEventListener('wheel', onWheel, { passive: false })
+    return () => el.removeEventListener('wheel', onWheel)
+  })
+
+  // 앞뒤 이미지를 미리 받아 둔다 (넘길 때 바로 보이게)
+  const prevPath = list[index - 1]?.thumbnailPath
+  const nextPath = list[index + 1]?.thumbnailPath
+  useEffect(() => {
+    for (const path of [prevPath, nextPath]) {
+      if (!path) continue
+      const img = new Image()
+      img.src = imageUrl(path)
+    }
+  }, [prevPath, nextPath])
+
+  // 스와이프 (가로로 충분히, 세로보다 확실히 많이 움직였을 때만)
+  const swipe = useRef<{ x: number; y: number; id: number } | null>(null)
+
+  if (!scene) return null
+  const hasPrev = index > 0
+  const hasNext = index < list.length - 1
+  const navButton =
+    'absolute top-1/2 grid size-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white transition hover:bg-white/20 disabled:pointer-events-none disabled:opacity-20'
+
+  return createPortal(
+    <div
+      ref={overlayRef}
+      className="fixed inset-0 z-50 flex select-none flex-col bg-black/90 text-white backdrop-blur-sm"
+      onPointerDown={(e) => {
+        if (e.button === 0) swipe.current = { x: e.clientX, y: e.clientY, id: e.pointerId }
+      }}
+      onPointerUp={(e) => {
+        const start = swipe.current
+        swipe.current = null
+        if (!start || start.id !== e.pointerId) return
+        const dx = e.clientX - start.x
+        const dy = e.clientY - start.y
+        if (Math.abs(dx) >= SWIPE_PX && Math.abs(dx) > Math.abs(dy) * 1.5) {
+          go(index + (dx < 0 ? 1 : -1))
+        }
+      }}
+      onPointerCancel={() => {
+        swipe.current = null
+      }}
+    >
+      <header className="flex shrink-0 items-center gap-2 px-4 py-3">
+        <div className="min-w-0 flex-1">
+          <div className="truncate text-[12px] opacity-70">{presetName}</div>
+          <div className="flex min-w-0 items-baseline gap-2">
+            <span className="truncate text-[19px] font-semibold">{scene.name}</span>
+            {scene.pending && (
+              <span className="shrink-0 rounded-full bg-accent px-1.5 py-0.5 text-[11px] font-bold leading-none text-on-accent">
+                {t('ui.notGenerated')}
+              </span>
+            )}
+            <span className="shrink-0 font-mono text-[12px] opacity-70">
+              {index + 1} / {list.length}
+            </span>
+          </div>
+        </div>
+        <button
+          className="flex h-10 items-center gap-1.5 rounded-full bg-white/10 px-3.5 text-[13px] hover:bg-white/20"
+          onClick={queue}
+        >
+          <Plus size={15} /> {t('ui.customReviewQueue')}
+          {scene.reserveCount > 0 && (
+            <span className="ml-0.5 min-w-5 rounded-full bg-danger px-1.5 text-center text-[12px] font-medium text-on-danger">
+              {scene.reserveCount}
+            </span>
+          )}
+        </button>
+        <button
+          className="grid size-10 place-items-center rounded-full bg-white/10 hover:bg-white/20"
+          title={t('ui.customSaveTopImage')}
+          aria-label={t('ui.customSaveTopImage')}
+          onClick={save}
+        >
+          <Download size={17} />
+        </button>
+        <button
+          className="grid size-10 place-items-center rounded-full bg-white/10 hover:bg-white/20"
+          title={t('ui.close')}
+          aria-label={t('ui.close')}
+          onClick={close}
+        >
+          <X size={19} />
+        </button>
+      </header>
+
+      <main className="relative flex min-h-0 flex-1 items-center justify-center px-20 pb-2">
+        <button
+          className={cn(navButton, 'left-4')}
+          disabled={!hasPrev}
+          aria-label={t('ui.customPrevious')}
+          onClick={() => go(index - 1)}
+        >
+          <ChevronLeft size={26} />
+        </button>
+        {/* 우클릭 메뉴 (복사·메타데이터 등) — 라이트박스와 같다 */}
+        <ImageContextMenu filePath={scene.thumbnailPath}>
+          <img
+            key={scene.id}
+            src={imageUrl(scene.thumbnailPath)}
+            className="max-h-full max-w-full rounded-lg object-contain shadow-2xl"
+            onError={(e) => {
+              // 원본 파일이 옮겨졌으면 저장된 썸네일이라도 보여 준다
+              if (scene.thumbnailUrl && e.currentTarget.src !== scene.thumbnailUrl)
+                e.currentTarget.src = scene.thumbnailUrl
+            }}
+            draggable={false}
+            alt=""
+          />
+        </ImageContextMenu>
+        <button
+          className={cn(navButton, 'right-4')}
+          disabled={!hasNext}
+          aria-label={t('ui.customNext')}
+          onClick={() => go(index + 1)}
+        >
+          <ChevronRight size={26} />
+        </button>
+      </main>
+
+      <footer className="shrink-0 pb-3 text-center text-[11.5px] opacity-60">
+        {t('ui.customReviewHint')}
+      </footer>
+    </div>,
+    document.body
+  )
+}
